+
+// --- host entry points ----------------------------------------------------------------------------
+
+void sycl_gated_delta_net_fused_op(
+    const at::Tensor& mixed_qkvz, const at::Tensor& mixed_ba,
+    const at::Tensor& dt_bias, const at::Tensor& a_log,
+    at::Tensor& mixed_qkv, at::Tensor& z, at::Tensor& beta, at::Tensor& g,
+    int64_t num_k_heads, int64_t num_v_heads, int64_t k_head_dim, int64_t v_head_dim,
+    double beta_scale)
+{
+    const auto B = mixed_qkvz.size(0);
+    const auto S = mixed_qkvz.size(1);
+    const auto Nk = num_k_heads;
+    const auto Hk = k_head_dim;
+    const auto Hv = v_head_dim;
+    const auto Nv = num_v_heads;
+
+    TORCH_CHECK(Nk > 0 && Nv > 0 && Hk > 0 && Hv > 0, "gdn_fused_op: head counts must be positive");
+    TORCH_CHECK(Nv % Nk == 0, "gdn_fused_op: num_v_heads must be divisible by num_k_heads");
+    const auto Ng = Nv / Nk;
+    const auto Fseg = 2 * Hk + 2 * Ng * Hv;
+    TORCH_CHECK(mixed_qkvz.size(2) == Nk * Fseg, "gdn_fused_op: mixed_qkvz last dim mismatch");
+    TORCH_CHECK(mixed_ba.dim() == 3 && mixed_ba.size(0) == B && mixed_ba.size(1) == S &&
+                mixed_ba.size(2) == Nk * 2 * Ng, "gdn_fused_op: mixed_ba shape mismatch");
+    TORCH_CHECK(mixed_qkv.size(0) == B && mixed_qkv.size(1) == 2 * Nk * Hk + Nv * Hv &&
+                mixed_qkv.size(2) == S, "gdn_fused_op: mixed_qkv shape mismatch");
+    TORCH_CHECK(z.numel() == B * S * Nv * Hv, "gdn_fused_op: z size mismatch");
+    TORCH_CHECK(beta.numel() == B * S * Nv && g.numel() == B * S * Nv, "gdn_fused_op: beta/g size mismatch");
+    TORCH_CHECK(dt_bias.numel() == Nv && a_log.numel() == Nv, "gdn_fused_op: dt_bias/a_log size mismatch");
+    TORCH_CHECK(mixed_qkvz.is_contiguous() && mixed_ba.is_contiguous() && mixed_qkv.is_contiguous() &&
+                z.is_contiguous() && beta.is_contiguous() && g.is_contiguous(),
+                "gdn_fused_op: tensors must be contiguous");
+
+    if (B * S == 0) return;
+
+    const int threads = (int) std::max(Hk, Hv);
+    TORCH_CHECK(threads <= 256, "gdn_fused_op: max head dim exceeded");
+
+    sycl::queue& q = exl3_sycl_queue();
+    if (threads <= 128)
+        launch_gdn_fused_op<128>(q,
+            (const float*) mixed_qkvz.data_ptr(), (const float*) mixed_ba.data_ptr(),
+            (const bf16*) dt_bias.data_ptr(), (const bf16*) a_log.data_ptr(),
+            (bf16*) mixed_qkv.data_ptr(), (bf16*) z.data_ptr(), (bf16*) beta.data_ptr(),
+            (float*) g.data_ptr(), B, S, Nk, Ng, Hk, Hv, (float) beta_scale);
+    else
+        launch_gdn_fused_op<256>(q,
+            (const float*) mixed_qkvz.data_ptr(), (const float*) mixed_ba.data_ptr(),
+            (const bf16*) dt_bias.data_ptr(), (const bf16*) a_log.data_ptr(),
+            (bf16*) mixed_qkv.data_ptr(), (bf16*) z.data_ptr(), (bf16*) beta.data_ptr(),
+            (float*) g.data_ptr(), B, S, Nk, Ng, Hk, Hv, (float) beta_scale);
+}
+
+void sycl_gated_delta_net_fused_op_2(
+    const at::Tensor& b, const at::Tensor& a, const at::Tensor& dt_bias, const at::Tensor& a_log,
+    at::Tensor& beta, at::Tensor& g, double beta_scale)
+{
+    TORCH_CHECK(b.scalar_type() == at::kFloat && a.scalar_type() == at::kFloat, "gdn_fused_op_2: b/a must be fp32");
+    TORCH_CHECK(dt_bias.scalar_type() == at::kBFloat16, "gdn_fused_op_2: dt_bias must be bf16");
+    TORCH_CHECK(beta.scalar_type() == at::kBFloat16 && g.scalar_type() == at::kFloat, "gdn_fused_op_2: beta/g dtype");
+    TORCH_CHECK(b.sizes() == a.sizes() && b.sizes() == beta.sizes() && b.sizes() == g.sizes(),
+                "gdn_fused_op_2: shape mismatch");
+    TORCH_CHECK(b.size(2) == dt_bias.numel() && b.size(2) == a_log.numel(), "gdn_fused_op_2: head count mismatch");
+
+    const size_t B = b.size(0), S = b.size(1), H = b.size(2);
+    if (b.numel() == 0) return;
+
+    sycl::queue& q = exl3_sycl_queue();
+    if (a_log.scalar_type() == at::kFloat)
+        launch_gdn_fused_op_2<float>(q, (const float*) b.data_ptr(), (const float*) a.data_ptr(),
+            (const bf16*) dt_bias.data_ptr(), (const float*) a_log.data_ptr(),
+            (bf16*) beta.data_ptr(), (float*) g.data_ptr(), B * S, H, (float) beta_scale);
+    else if (a_log.scalar_type() == at::kBFloat16)
+        launch_gdn_fused_op_2<bf16>(q, (const float*) b.data_ptr(), (const float*) a.data_ptr(),
+            (const bf16*) dt_bias.data_ptr(), (const bf16*) a_log.data_ptr(),
+            (bf16*) beta.data_ptr(), (float*) g.data_ptr(), B * S, H, (float) beta_scale);
+    else
+        TORCH_CHECK(false, "gdn_fused_op_2: unsupported a_log dtype");
+}
+
+
+// -------------------------------------------------------------------------------------------------
+// causal_conv1d_update: the decode-step short conv over the recurrent window (port of
+// conv1d_update_kernel in gdn.cu; the CUDA kernel is unavailable here and the Triton path costs
+// two launches per layer). One work item per (b, channel): read the K-entry window from the
+// conv_state ring, append the incoming token(s), apply silu and write the new window back.
+// seqlen <= 32, K <= 16 (the caller guarantees those).
+// -------------------------------------------------------------------------------------------------
+
+constexpr int CONV1D_MAX_K = 16;
+
+template <bool ACT, bool HISTORY, bool INCREMENTAL>
+class GdnConv1dKernelName;
+
+template <bool ACT, bool HISTORY, bool INCREMENTAL>
+static void launch_conv1d_update(sycl::queue& q, const bf16* x, bf16* state, const int* slots,
+                                 const bf16* weight, const bf16* bias, bf16* out,
+                                 int bsz, int dim, int seqlen, int state_size, int K)
+{
+    constexpr int NT = 128;
+    const size_t n = (size_t) bsz * dim;
+    const size_t gsz = ((n + NT - 1) / NT) * NT;
+    q.submit([&](sycl::handler& h)
+    {
+        h.parallel_for<GdnConv1dKernelName<ACT, HISTORY, INCREMENTAL>>(
+            sycl::nd_range<1>(sycl::range<1>(gsz), sycl::range<1>(NT)),
+            [=](sycl::nd_item<1> it)
+        {
+            const size_t gid = it.get_global_linear_id();
+            if (gid >= n) return;
+            const int b = (int) (gid / dim);
+            const int d = (int) (gid - (size_t) b * dim);
+            const int slot = slots ? slots[b] : b;
+            const bf16* x_d = x + ((size_t) b * dim + d) * seqlen;
+            bf16* state_d = state + ((size_t) slot * dim + d) * state_size;
+
+            float w[CONV1D_MAX_K];
+            for (int k = 0; k < K; ++k) w[k] = (float) weight[(size_t) d * K + k];
+            float bias_d = bias ? (float) bias[d] : 0.0f;
+
+            const int win_off = INCREMENTAL ? state_size - K : 0;
+            float old_state[CONV1D_MAX_K];
+            float win[CONV1D_MAX_K];
+            for (int k = 0; k < K; ++k) old_state[k] = (float) state_d[win_off + k];
+            for (int k = 0; k < K - 1; ++k) win[k] = old_state[k + 1];
+            const int last = K > 0 ? K - 1 : 0;
+
+            for (int s = 0; s < seqlen; ++s)
+            {
+                win[last] = (float) x_d[s];
+                float acc = bias_d;
+                for (int k = 0; k < K; ++k) acc = sycl::fma(w[k], win[k], acc);
+                if constexpr (ACT) acc *= 1.0f / (1.0f + sycl::exp(-acc));
+                out[((size_t) b * seqlen + s) * dim + d] = (bf16) acc;
+                for (int k = 0; k < K - 1; ++k) win[k] = win[k + 1];
+            }
+
+            if constexpr (!HISTORY)
+            {
+                for (int k = 0; k < K; ++k)
+                {
+                    int src_t = seqlen + k;
+                    float v = (src_t < K) ? old_state[src_t] : (float) x_d[src_t - K];
+                    state_d[k] = (bf16) v;
+                }
+            }
+            else if constexpr (INCREMENTAL)
+            {
+                int m = seqlen < state_size ? seqlen : state_size;
+                for (int j = 0; j < state_size - m; ++j) state_d[j] = state_d[j + m];
+                for (int j = 0; j < m; ++j) state_d[state_size - m + j] = (bf16) (float) x_d[seqlen - m + j];
+            }
+            else
+            {
+                int total = K + seqlen;
+                int write_size = state_size < total ? state_size : total;
+                int dst_start = state_size - write_size;
+                int src_start = total - write_size;
+                for (int j = 0; j < write_size; ++j)
+                {
+                    int src_t = src_start + j;
+                    float v = (src_t < K) ? old_state[src_t] : (float) x_d[src_t - K];
+                    state_d[dst_start + j] = (bf16) v;
+                }
+            }
+        });
+    });
+}
+
+void sycl_causal_conv1d_update(
+    const at::Tensor& x, at::Tensor& conv_state,
+    const c10::optional<at::Tensor>& slots,
+    const at::Tensor& weight, const c10::optional<at::Tensor>& bias,
+    at::Tensor& out, bool activation, bool history, bool incremental)
+{
+    TORCH_CHECK(!incremental || history, "causal_conv1d_update: incremental steps are history steps");
+    const int bsz = (int) x.size(0);
+    const int dim = (int) x.size(1);
+    const int seqlen = (int) x.size(2);
+    const int state_size = (int) conv_state.size(2);
+    const int K = (int) weight.size(1);
+
+    TORCH_CHECK(K <= CONV1D_MAX_K, "causal_conv1d_update: conv kernel size exceeds ", CONV1D_MAX_K);
+    TORCH_CHECK(state_size >= K, "causal_conv1d_update: conv_state must have at least K entries");
+    TORCH_CHECK(x.is_contiguous() && conv_state.is_contiguous() && weight.is_contiguous() && out.is_contiguous(),
+                "causal_conv1d_update: x, conv_state, weight and out must be contiguous");
+    TORCH_CHECK(conv_state.dim() == 3 && conv_state.size(1) == dim,
+                "causal_conv1d_update: conv_state must be (num_slots, dim, state_size)");
+    TORCH_CHECK(out.dim() == 3 && out.size(0) == bsz && out.size(1) == seqlen && out.size(2) == dim,
+                "causal_conv1d_update: out must be (bsz, seqlen, dim)");
+    TORCH_CHECK(x.scalar_type() == at::kBFloat16 && conv_state.scalar_type() == at::kBFloat16 &&
+                weight.scalar_type() == at::kBFloat16 && out.scalar_type() == at::kBFloat16,
+                "causal_conv1d_update: x/state/weight/out must be bf16");
+    TORCH_CHECK(!bias.has_value() || (bias->scalar_type() == at::kBFloat16 && bias->numel() == dim),
+                "causal_conv1d_update: bias must be a bf16 (dim) tensor");
+    if (!bsz || !dim || !seqlen) return;
+
+    const int* slots_ptr = slots.has_value() ? (const int*) slots->data_ptr() : nullptr;
+    const bf16* bias_ptr = bias.has_value() ? (const bf16*) bias->data_ptr() : nullptr;
+
+    sycl::queue& q = exl3_sycl_queue();
+    #define CONV_LAUNCH(ACT_, HIST_, INC_)                                                   \
+        launch_conv1d_update<ACT_, HIST_, INC_>(q, (const bf16*) x.data_ptr(),                \
+            (bf16*) conv_state.data_ptr(), slots_ptr, (const bf16*) weight.data_ptr(),       \
+            bias_ptr, (bf16*) out.data_ptr(), bsz, dim, seqlen, state_size, K)
+
+    if (activation)
+    {
+        if (incremental)     CONV_LAUNCH(true, true, true);
+        else if (history)    CONV_LAUNCH(true, true, false);
+        else                 CONV_LAUNCH(true, false, false);
+    }
+    else
+    {
+        if (incremental)     CONV_LAUNCH(false, true, true);
+        else if (history)    CONV_LAUNCH(false, true, false);
+        else                 CONV_LAUNCH(false, false, false);
+    }
+    #undef CONV_LAUNCH
+}
+
+void sycl_recurrent_gated_delta_rule(
+    const at::Tensor& mixed_qkv, const at::Tensor& g, const at::Tensor& beta,
+    at::Tensor& recurrent_state, at::Tensor& core_attn_out,
+    int64_t num_k_heads, int64_t num_v_heads, int64_t k_head_dim, int64_t v_head_dim,
+    const c10::optional<at::Tensor>& slots, bool history,
+    const c10::optional<at::Tensor>& slots_in)
+{
+    const int bsz = (int) mixed_qkv.size(0);
+    const int seqlen = (int) mixed_qkv.size(1);
+
+    TORCH_CHECK(num_k_heads > 0, "gdn scan: num_k_heads must be positive");
+    TORCH_CHECK(num_v_heads % num_k_heads == 0, "gdn scan: num_v_heads must be divisible by num_k_heads");
+    TORCH_CHECK(k_head_dim == 128 && v_head_dim == 128,
+                "gdn scan (SYCL): only 128x128 head dims are supported");
+    TORCH_CHECK(mixed_qkv.scalar_type() == at::kBFloat16, "gdn scan: mixed_qkv must be bf16");
+    TORCH_CHECK(beta.scalar_type() == at::kBFloat16, "gdn scan: beta must be bf16");
+    TORCH_CHECK(recurrent_state.scalar_type() == at::kFloat, "gdn scan: state must be fp32");
+    TORCH_CHECK(core_attn_out.scalar_type() == at::kBFloat16, "gdn scan: core_attn_out must be bf16");
+
+    const bool channelwise = g.dim() == 4;
+    if (channelwise)
+    {
+        TORCH_CHECK(g.size(0) == bsz && g.size(1) == seqlen && g.size(2) == num_v_heads &&
+                    g.size(3) == k_head_dim, "gdn scan: channelwise g must be [b, s, heads, 128]");
+    }
+    else
+    {
+        TORCH_CHECK(g.dim() == 3 && g.size(0) == bsz && g.size(1) == seqlen && g.size(2) == num_v_heads,
+                    "gdn scan: g must be [b, s, heads]");
+    }
+
+    TORCH_CHECK(mixed_qkv.is_contiguous() && g.is_contiguous() && beta.is_contiguous() &&
+                recurrent_state.is_contiguous() && core_attn_out.is_contiguous(),
+                "gdn scan: tensors must be contiguous");
+
+    // EXL3_GDN_VSPLIT overrides the split for A/B testing (1/2/4). The default is 1: with the
+    // full v head in one group every item does state work (V_SPLIT=4 leaves 128 of 512 items
+    // active), measured 1.16x on the decode scan (79.8 vs 92.8 us, 48x128x128 state) and
+    // bit-exact (scan_ab.py)
+    const char* vs_env = getenv("EXL3_GDN_VSPLIT");
+    const int v_split = vs_env ? atoi(vs_env) : 1;
+    TORCH_CHECK(v_split == 1 || v_split == 2 || v_split == 4,
+                "gdn scan: EXL3_GDN_VSPLIT must be 1, 2 or 4");
+    TORCH_CHECK(v_head_dim % v_split == 0, "gdn scan: v_head_dim must be divisible by v_split");
+
+    if (bsz == 0 || seqlen == 0 || num_v_heads == 0) return;
+
+    sycl::queue& q = exl3_sycl_queue();
+    const int history_stride = (int) recurrent_state.size(1);
+
+    const int* slots_ptr = slots.has_value() ? (const int*) slots->data_ptr() : nullptr;
+    const int* slots_in_ptr = history && slots_in.has_value() ? (const int*) slots_in->data_ptr() : nullptr;
+
+    #define GDN_LAUNCH(VS, CW) \
+        launch_gdn_scan<VS, CW>(q, \
+            (const bf16*) mixed_qkv.data_ptr(), (const float*) g.data_ptr(), \
+            (const bf16*) beta.data_ptr(), (float*) recurrent_state.data_ptr(), \
+            (bf16*) core_attn_out.data_ptr(), bsz, seqlen, (int) num_k_heads, (int) num_v_heads, \
+            slots_ptr, history_stride, slots_in_ptr)
+
+    if (channelwise)
+    {
+        if (v_split == 4) GDN_LAUNCH(4, true); else if (v_split == 2) GDN_LAUNCH(2, true); else GDN_LAUNCH(1, true);
+    }
+    else
+    {
+        if (v_split == 4) GDN_LAUNCH(4, false); else if (v_split == 2) GDN_LAUNCH(2, false); else GDN_LAUNCH(1, false);
+    }
+    #undef GDN_LAUNCH
+}
+
+// -------------------------------------------------------------------------------------------------
+// Speculative-decoding rewind, ports of gdn.cu's batched rewind kernels.
+//
+// batched_conv_rewind: conv_state[slot][:, :cdim] <- conv_state[slot][:, p-cdim:p] for every job,
+// one work-item per channel, reading its (up to CONV1D_MAX_K) elements into registers before
+// writing any of them back so overlapping windows (num_tokens < conv_kernel_size) are safe
+// without synchronization. All jobs go through a single launch via a device-side job table.
+//
+// batched_scan_replay: rerun the sequential scan over the first `prefix` staged tokens of one
+// batch row of the last speculative pass, from the base state row into the scratch row — the
+// same kernel the pass ran (launch_gdn_scan) over the same inputs and initial state, so the
+// result is the state that pass had after `prefix` tokens. One launch per job (a rewind is one
+// call carrying every layer's job; the scans are independent — disjoint state rows and inputs).
+// -------------------------------------------------------------------------------------------------
+
+#define GDN_CONV_MAX_K 16
+#define GDN_REWIND_CONV_THREADS 256
+
+class GdnConvRewindKernelName;
+
+void sycl_batched_conv_rewind(std::vector<ConvRewindJob> const& jobs, int64_t device_index)
+{
+    if (jobs.empty()) return;
+    (void) device_index;
+
+    sycl::queue& q = exl3_sycl_queue();
+
+    // Device-side job table, grown on demand (a rewind touches every GDN layer of the model,
+    // so the same buffer is reused on every call; in-order queue orders copy -> kernel)
+    static ConvRewindJob* tbl = nullptr;
+    static size_t cap = 0;
+    if (jobs.size() > cap)
+    {
+        if (tbl) { q.wait(); sycl::free(tbl, q); }
+        cap = jobs.size();
+        tbl = sycl::malloc_device<ConvRewindJob>(cap, q);
+    }
+    q.memcpy(tbl, jobs.data(), jobs.size() * sizeof(ConvRewindJob)).wait();
+
+    size_t max_dim = 0;
+    for (auto& j : jobs)
+    {
+        TORCH_CHECK(j.cdim <= GDN_CONV_MAX_K, "batched_conv_rewind: cdim exceeds GDN_CONV_MAX_K");
+        max_dim = std::max(max_dim, (size_t) j.dim);
+    }
+    const size_t nblk = (max_dim + GDN_REWIND_CONV_THREADS - 1) / GDN_REWIND_CONV_THREADS;
+    ConvRewindJob* tbl_dev = tbl;   // static data can't be captured into a SYCL kernel
+
+    q.submit([&](sycl::handler& h)
+    {
+        h.parallel_for<GdnConvRewindKernelName>(
+            sycl::nd_range<2>(sycl::range<2>(nblk * GDN_REWIND_CONV_THREADS, jobs.size()),
+                              sycl::range<2>(GDN_REWIND_CONV_THREADS, 1)),
+            [=](sycl::nd_item<2> it)
+        {
+            const int d = (int) it.get_local_id(0) + (int) it.get_group(0) * GDN_REWIND_CONV_THREADS;
+            const int ji = (int) it.get_group(1);
+            if (d >= tbl_dev[ji].dim) return;
+
+            const bf16* s = (const bf16*) tbl_dev[ji].src + (size_t) d * tbl_dev[ji].stride;
+            bf16* t = (bf16*) tbl_dev[ji].dst + (size_t) d * tbl_dev[ji].stride;
+
+            bf16 reg[GDN_CONV_MAX_K];
+            #pragma unroll
+            for (int k = 0; k < GDN_CONV_MAX_K; ++k)
+                if (k < tbl_dev[ji].cdim) reg[k] = s[k];
+            #pragma unroll
+            for (int k = 0; k < GDN_CONV_MAX_K; ++k)
+                if (k < tbl_dev[ji].cdim) t[k] = reg[k];
+        });
+    });
+}
+
+void sycl_batched_scan_replay(std::vector<ScanReplayJob> const& jobs, int64_t device_index,
+                              int64_t kind, int64_t num_k_heads, int64_t num_v_heads,
+                              int64_t k_head_dim, int64_t v_head_dim)
+{
+    if (jobs.empty()) return;
+    (void) device_index;
+
+    TORCH_CHECK(kind != 1, "batched_scan_replay (SYCL): Mamba2 scan not ported");
+    TORCH_CHECK(num_k_heads > 0 && num_v_heads % num_k_heads == 0, "batched_scan_replay: bad head counts");
+    TORCH_CHECK(k_head_dim == 128 && v_head_dim == 128, "batched_scan_replay (SYCL): only 128x128 head dims");
+
+    sycl::queue& q = exl3_sycl_queue();
+    const bool channelwise = (kind == 2);
+    const int v_split = (num_v_heads <= 64) ? 4 : 1;
+
+    for (auto const& j : jobs)
+    {
+        TORCH_CHECK(j.prefix >= 1, "batched_scan_replay: prefix must be at least 1");
+        TORCH_CHECK(j.tstride >= 1, "batched_scan_replay: tstride must be at least 1");
+        TORCH_CHECK((const void*) j.base != (const void*) j.scratch,
+                    "batched_scan_replay: base and scratch rows must differ");
+
+        // bsz = 1 (one job = one batch row), seqlen = prefix, explicit base/scratch state rows,
+        // no attention output. The recurrent_state / history_stride args are unused in replay
+        // mode (the state rows are the job's absolute pointers)
+        #define GDN_REPLAY_LAUNCH(VS, CW) \
+            launch_gdn_scan<VS, CW>(q, \
+                (const bf16*) j.qkv, (const float*) j.g, (const bf16*) j.beta, \
+                (float*) j.base, nullptr, 1, j.prefix, (int) num_k_heads, (int) num_v_heads, \
+                nullptr, 0, nullptr, j.tstride, (const float*) j.base, (float*) j.scratch)
+
+        if (channelwise)
+        {
+            if (v_split == 4) GDN_REPLAY_LAUNCH(4, true); else GDN_REPLAY_LAUNCH(1, true);
+        }
+        else
+        {
+            if (v_split == 4) GDN_REPLAY_LAUNCH(4, false); else GDN_REPLAY_LAUNCH(1, false);
+        }
+        #undef GDN_REPLAY_LAUNCH
+    }
+}
diff --git a/exllamav3/exllamav3_ext/sycl/gemv.cpp b/exllamav3/exllamav3_ext/sycl/gemv.cpp
new file mode 100644
index 0000000..04ac698
--- /dev/null
+++ b/exllamav3/exllamav3_ext/sycl/gemv.cpp
@@ -0,0 +1,1171 @@
+// Decode GEMV, port of quant/exl3_gemv.cu + exl3_gemv_kernel.cuh into SYCL (no tensor cores).
+//
+// SYCL has no grid-wide sync, so the CUDA kernel's fused flow becomes three launches:
+//   1. input Hadamard (pre = suh, 1/sqrt(128))  ->  A_had
+//   2. GEMV: one work item per (m, n) output, scalar dot over k with decode-on-the-fly
+//   3. output Hadamard (post = svh, 1/sqrt(128)) on C in place
+//
+// The GEMV decodes each weight from its packed subtile with the inverse position mapping
+// (weight_rc_to_t), which is correct for every m; the decode redundancy grows with m, which is
+// acceptable in the m <= 144 decode regime this path serves.
+
+#include <sycl/sycl.hpp>
+#include <sycl/ext/intel/esimd.hpp>
+#include <ATen/Tensor.h>
+#include <cstdlib>
+
+#include "exl3_compat.h"
+#include "exl3_decode.h"
+#include "sycl_kernels.h"
+
+namespace {
+
+template <int K, int cb, bool HALF>
+class GemvKernelName;
+
+using GemvFn = void (*)(sycl::queue&, const sycl::half*, const uint16_t*, void*, int, int, int, int, bool);
+
+static const GemvFn* gemv_table();   // forward decl, defined below
+
+template <int K, int cb, bool HALF>
+void launch_gemv(sycl::queue& q, const sycl::half* A, const uint16_t* packed, void* C,
+                 int size_m, int size_k, int size_n, int stride, bool c_fp32)
+{
+    constexpr int packed_size = 16 * K + (HALF ? 8 : 0);
+    constexpr int words = tile_words(K, HALF);
+    // ntiles is the n-tile STRIDE between k-tiles in the trellis [k/16, n_full/16, words] layout:
+    // for a sliced source (stride > 0, the source's full output width) it must be the source's
+    // full tile count, not the slice width, or every k-tile after the first reads the wrong columns
+    const int ntiles = (stride > 0 ? stride : size_n) / 16;
+    const int row_stride = stride > 0 ? stride : size_n;
+    // No extra scale here: the separate input/output Hadamard launches each fold 1/sqrt(128),
+    // which together with the raw trellis decode yields C = x @ W (the CUDA kernel fuses the two
+    // Hadamards with the same normalization instead)
+
+    q.parallel_for<GemvKernelName<K, cb, HALF>>(sycl::range<1>((size_t) size_m * size_n),
+        [=](sycl::item<1> item)
+    {
+        const size_t idx = item.get_linear_id();
+        const int mi = (int) (idx / size_n);
+        const int ni = (int) (idx % size_n);
+
+        const int kb_n = ni >> 4;                   // subtile index along n
+        const int n_in_tile = ni & 15;              // column within the subtile
+
+        float acc = 0.0f;
+        const sycl::half* xrow = A + (size_t) mi * size_k;
+
+        for (int k = 0; k < size_k; ++k)
+        {
+            const uint16_t* tile = packed + (size_t) ((k >> 4) * ntiles + kb_n) * packed_size;
+            PackedPtrU16 ptr{ tile, words };
+            const int t = weight_rc_to_t(k & 15, n_in_tile);
+            sycl::half w;
+            if constexpr (HALF)
+                w = dq_half<K, cb>(ptr, t);
+            else
+                w = dq<K, cb>(ptr, t);
+            acc = fmaf((float) xrow[k], (float) w, acc);
+        }
+
+        const size_t out_idx = (size_t) mi * row_stride + ni;
+        if (c_fp32) ((float*) C)[out_idx] = acc;
+        else        ((sycl::half*) C)[out_idx] = sycl::half(acc);
+    });
+}
+
+// Tile-once decode GEMV for the m == 1 decode path. The previous split-K kernel ran one work-group
+// PER OUTPUT COLUMN with lanes striding k-tiles: every subtile's tile stream was then re-read by
+// the 16 column work-groups, 16x L2-amplified traffic which microbenchmarking showed to be THE
+// bound (dropping the decode chain changed nothing; restructuring the work-group layout gave 3.7x
+// cold on the lm_head shape). Here ONE work-group of LANES lanes per n-subtile (16 columns): all
+// lanes iterate the k-tiles together, each lane decodes 256/LANES consecutive trellis weights per
+// tile (every weight decoded exactly once per tile, each tile read by one work-group), and keeps
+// its 256/LANES slot accumulators in REGISTERS (no per-weight local-memory RMW; measured ~14%
+// over a local-tile RMW) which are written to the local 16x16 tile once at the end; the columns
+// are then reduced over the tile rows. LANES is picked by the host from the subtile count: more
+// lanes help when there are few subtiles (the hidden layers), fewer when there are many
+// (the lm_head). Numerics: partial sums reduce in fp32 (order differs from the serial kernel's,
+// fine for fp16-weight dots).
+template <int K, int cb, bool HALF, int LANES>
+class GemvSplitKKernelName;
+
+template <int K, int cb, bool HALF, int LANES>
+void launch_gemv_splitk(sycl::queue& q, const sycl::half* A, const uint16_t* packed, void* C,
+                        int size_m, int size_k, int size_n, int stride, bool c_fp32)
+{
+    constexpr int packed_size = 16 * K + (HALF ? 8 : 0);
+    constexpr int words = tile_words(K, HALF);
+    // ntiles is the n-tile STRIDE between k-tiles in the trellis [k/16, n_full/16, words] layout:
+    // for a sliced source (stride > 0) it must be the source's full tile count. The WORK extent,
+    // though, is the slice's own subtile count (size_n/16) — the launch extent and the trellis
+    // k-stride are different quantities (launching stride/16 groups would compute past the slice
+    // and overwrite the sibling sources' output columns in the fused row)
+    const int ntiles = (stride > 0 ? stride : size_n) / 16;
+    const int ngroups = size_n / 16;
+    const int ktiles = size_k / 16;
+    constexpr int T_PER_LANE = 256 / LANES;
+
+    // m == 1 (the caller gates on it): one group of LANES per n-subtile
+    q.submit([&](sycl::handler& h)
+    {
+        sycl::local_accessor<float, 2> lout(sycl::range<2>(16, 16), h);   // [col][row] accumulators
+        h.parallel_for<GemvSplitKKernelName<K, cb, HALF, LANES>>(
+            sycl::nd_range<1>(sycl::range<1>((size_t) ngroups * LANES), sycl::range<1>(LANES)),
+            [=](sycl::nd_item<1> it)
+        {
+            const int kb_n = (int) it.get_group_linear_id();
+            const int lane = (int) it.get_local_id(0);
+
+            // hoisted per-lane constants (t0 is loop-invariant across k-tiles)
+            int tmap[T_PER_LANE], Rrow[T_PER_LANE], Ccol[T_PER_LANE];
+            #pragma unroll
+            for (int u = 0; u < T_PER_LANE; ++u)
+            {
+                const int t = lane * T_PER_LANE + u;
+                tmap[u] = t;
+                // inverse of weight_rc_to_t: l = t>>3, j = t&7 (j < 8, so the split is exact)
+                const int l = t >> 3, j = t & 7;
+                const int p = l & 3, c1 = (l >> 2) & 1, c8 = l >> 3;
+                const int d = j & 1, cc = (j >> 1) & 1, h8 = j >> 2;
+                Rrow[u] = cc * 8 + p * 2 + d;          // k-row within the ktile
+                Ccol[u] = h8 * 8 + c8 * 2 + c1;        // column within the subtile
+            }
+
+            // register accumulators: no per-weight local-memory RMW (measured ~14% on the
+            // hidden-layer shape); every (col, row) slot is written exactly once at the end
+            float acc[T_PER_LANE];
+            #pragma unroll
+            for (int u = 0; u < T_PER_LANE; ++u) acc[u] = 0.0f;
+
+            for (int kt = 0; kt < ktiles; ++kt)
+            {
+                const uint16_t* tile = packed + (size_t) (kt * ntiles + kb_n) * packed_size;
+                PackedPtrU16 ptr{ tile, words };
+                const int k0 = kt * 16;
+                #pragma unroll
+                for (int u = 0; u < T_PER_LANE; ++u)
+                {
+                    sycl::half w;
+                    if constexpr (HALF)
+                        w = dq_half<K, cb>(ptr, tmap[u]);
+                    else
+                        w = dq<K, cb>(ptr, tmap[u]);
+                    acc[u] = fmaf((float) A[k0 + Rrow[u]], (float) w, acc[u]);
+                }
+            }
+            #pragma unroll
+            for (int u = 0; u < T_PER_LANE; ++u) lout[Ccol[u]][Rrow[u]] = acc[u];
+            sycl::group_barrier(it.get_group());
+            // each output column is the sum over the tile's 16 rows (the k dim)
+            for (int col = lane; col < 16; col += LANES)
+            {
+                float s = 0.0f;
+                for (int row = 0; row < 16; ++row) s += lout[col][row];
+                const size_t out_idx = (size_t) kb_n * 16 + col;   // m == 1: row 0
+                if (c_fp32) ((float*) C)[out_idx] = s;
+                else        ((sycl::half*) C)[out_idx] = sycl::half(s);
+            }
+        });
+    });
+}
+
+// fp32 partial sums for the KS-split tile-once kernel (KS slices of size_n each). The split only
+// engages for parallelism-starved shapes (ngroups < 2560, i.e. size_n < 40960), so a fixed scratch
+// covers every split shape
+static float* splitk_scratch(sycl::queue& q)
+{
+    constexpr size_t CAP = 32 * 262144;  // KS_MAX(32) x max size_n (the 27B lm_head, 248320) floats
+    static float* buf = nullptr;
+    if (!buf) buf = sycl::malloc_device<float>(CAP, q);
+    return buf;
+}
+
+// KS-split tile-once GEMV for parallelism-starved shapes: the one-group-per-subtile layout leaves
+// the GPU under-occupied when a layer has few n-subtiles (e.g. the 27B's down_proj/out_proj:
+// 320 subtiles x 64 lanes = 20K threads, measured ~22 GB/s cold). Splitting the k-tiles across KS
+// work-groups per subtile multiplies the threads in flight (KS=8, LANES=64, measured on the cold
+// production shapes, bench27b.cpp: down k=17408 n=5120 2.2x, out_proj k=6144 n=5120 2x,
+// mlp gate/up k=5120 n=17408 1.4x, GDN bundle k=5120 n=20480 1.25x over the unsplit kernel).
+// Each (subtile, k-chunk) group decodes its chunk's weights exactly once into fp32 partials in a
+// scratch buffer (disjoint writes — no atomics, no memset); a tiny reduce kernel then sums the KS
+// slices into C. The in-order queue orders partial -> reduce and consecutive calls, so the shared
+// scratch is safe. m == 1 only (the dispatch gates on it)
+template <int K, int cb, bool HALF, int LANES, int KS>
+class GemvSplitKsKernelName;
+template <int K, int cb, bool HALF, int LANES, int KS>
+class GemvSplitKsReduceName;
+
+template <int K, int cb, bool HALF, int LANES, int KS>
+void launch_gemv_splitk_ks(sycl::queue& q, const sycl::half* A, const uint16_t* packed, void* C,
+                           int size_m, int size_k, int size_n, int stride, bool c_fp32)
+{
+    constexpr int packed_size = 16 * K + (HALF ? 8 : 0);
+    constexpr int words = tile_words(K, HALF);
+    // ntiles: the n-tile STRIDE between k-tiles in the trellis (the source's full tile count for a
+    // sliced source); ngroups: the slice's own subtile count (the work extent)
+    const int ntiles = (stride > 0 ? stride : size_n) / 16;
+    const int ngroups = size_n / 16;
+    const int ktiles = size_k / 16;
+    constexpr int T_PER_LANE = 256 / LANES;
+    const int chunk = (ktiles + KS - 1) / KS;
+    float* scratch = splitk_scratch(q);
+
+    q.submit([&](sycl::handler& h)
+    {
+        sycl::local_accessor<float, 2> lout(sycl::range<2>(16, 16), h);
+        h.parallel_for<GemvSplitKsKernelName<K, cb, HALF, LANES, KS>>(
+            sycl::nd_range<1>(sycl::range<1>((size_t) ngroups * KS * LANES), sycl::range<1>(LANES)),
+            [=](sycl::nd_item<1> it)
+        {
+            const int gid = (int) it.get_group_linear_id();
+            const int kb_n = gid / KS;              // subtile along n
+            const int kc = gid % KS;                // k-chunk within the subtile
+            const int lane = (int) it.get_local_id(0);
+
+            int tmap[T_PER_LANE], Rrow[T_PER_LANE], Ccol[T_PER_LANE];
+            #pragma unroll
+            for (int u = 0; u < T_PER_LANE; ++u)
+            {
+                const int t = lane * T_PER_LANE + u;
+                tmap[u] = t;
+                // inverse of weight_rc_to_t: l = t>>3, j = t&7 (j < 8, so the split is exact)
+                const int l = t >> 3, j = t & 7;
+                const int p = l & 3, c1 = (l >> 2) & 1, c8 = l >> 3;
+                const int d = j & 1, cc = (j >> 1) & 1, h8 = j >> 2;
+                Rrow[u] = cc * 8 + p * 2 + d;          // k-row within the ktile
+                Ccol[u] = h8 * 8 + c8 * 2 + c1;        // column within the subtile
+            }
+
+            float acc[T_PER_LANE];
+            #pragma unroll
+            for (int u = 0; u < T_PER_LANE; ++u) acc[u] = 0.0f;
+
+            const int kt0 = kc * chunk;
+            const int kt1 = sycl::min(kt0 + chunk, ktiles);
+            for (int kt = kt0; kt < kt1; ++kt)
+            {
+                const uint16_t* tile = packed + (size_t) (kt * ntiles + kb_n) * packed_size;
+                PackedPtrU16 ptr{ tile, words };
+                const int k0 = kt * 16;
+                #pragma unroll
+                for (int u = 0; u < T_PER_LANE; ++u)
+                {
+                    sycl::half w;
+                    if constexpr (HALF)
+                        w = dq_half<K, cb>(ptr, tmap[u]);
+                    else
+                        w = dq<K, cb>(ptr, tmap[u]);
+                    acc[u] = fmaf((float) A[k0 + Rrow[u]], (float) w, acc[u]);
+                }
+            }
+            #pragma unroll
+            for (int u = 0; u < T_PER_LANE; ++u) lout[Ccol[u]][Rrow[u]] = acc[u];
+            sycl::group_barrier(it.get_group());
+            // each output column is the sum over the tile's 16 rows (the k dim);
+            // disjoint fp32 partial slices — slice kc, element (kb_n*16 + col) = output index i
+            for (int col = lane; col < 16; col += LANES)
+            {
+                float s = 0.0f;
+                for (int row = 0; row < 16; ++row) s += lout[col][row];
+                scratch[(size_t) kc * size_n + kb_n * 16 + col] = s;
+            }
+        });
+    });
+
+    // reduce: sum the KS fp32 partial slices into C (m == 1: row 0)
+    q.submit([&](sycl::handler& h)
+    {
+        h.parallel_for<GemvSplitKsReduceName<K, cb, HALF, LANES, KS>>(
+            sycl::range<1>((size_t) size_n), [=](sycl::item<1> item)
+        {
+            const int i = (int) item.get_linear_id();
+            float s = 0.0f;
+            #pragma unroll
+            for (int c = 0; c < KS; ++c) s += scratch[(size_t) c * size_n + i];
+            if (c_fp32) ((float*) C)[i] = s;
+            else        ((sycl::half*) C)[i] = sycl::half(s);
+        });
+    });
+}
+
+// -------------------------------------------------------------------------------------------------
+// MT2: two adjacent n-tiles per work-group. The pair's tiles are packed_size apart in the trellis,
+// so each lane's two dq4 word-pairs fall in one 128-byte region — 2x the DRAM burst of the
+// one-subtile split kernel. With the dq4 decode (4 consecutive weights from 2 word loads instead
+// of 4 x 2) the benched throughput on the 27B's cold production shapes is 64-66 GB/s vs 49-56 for
+// the KS=8 split (bench27b.cpp: down 1.31x, gate/up 1.16x, out_proj 1.26x, GDN bundle 1.18x).
+// Integer K <= 5 only (dq4's 4-window group spans 3*bits+16 bits and must fit one word pair); the
+// group = (n-tile PAIR, k-chunk), partials in the shared splitk scratch, then the same KS-reduce
+// kernel as launch_gemv_splitk_ks. m == 1 only (the dispatch gates on it)
+// -------------------------------------------------------------------------------------------------
+
+template <int K, int cb, int LANES, int KS>
+class GemvMt2KernelName;
+
+template <int K, int cb, int LANES, int KS>
+void launch_gemv_mt2(sycl::queue& q, const sycl::half* A, const uint16_t* packed, void* C,
+                     int size_m, int size_k, int size_n, int stride, bool c_fp32)
+{
+    constexpr int packed_size = 16 * K;
+    constexpr int words = tile_words(K, false);
+    const int ntiles = (stride > 0 ? stride : size_n) / 16;
+    const int ngroups = size_n / 32;         // tile PAIRS along n
+    const int ktiles = size_k / 16;
+    constexpr int T_PER_LANE = 256 / LANES;
+    const int chunk = (ktiles + KS - 1) / KS;
+    float* scratch = splitk_scratch(q);
+
+    q.submit([&](sycl::handler& h)
+    {
+        sycl::local_accessor<float, 2> lout(sycl::range<2>(32, 16), h);
+        h.parallel_for<GemvMt2KernelName<K, cb, LANES, KS>>(
+            sycl::nd_range<1>(sycl::range<1>((size_t) ngroups * KS * LANES), sycl::range<1>(LANES)),
+            [=](sycl::nd_item<1> it)
+        {
+            const int gid = (int) it.get_group_linear_id();
+            const int kb_n = gid / KS;              // tile pair along n
+            const int kc = gid % KS;                // k-chunk
+            const int lane = (int) it.get_local_id(0);
+
+            // Vectorized-A mapping (T_PER_LANE == 4): the lane's 4 t-slots (t = lane*4 + u) map to
+            // k-rows {p*2, p*2+1, 8+p*2, 8+p*2+1} with per-lane constants (l = lane>>1) — two
+            // ADJACENT pairs, so the 8 scalar 2B A loads per k-tile (one per weight, shared by both
+            // adjacent tiles) become 2 vector 4B loads. The columns are ch*8 + cbase with
+            // ch = (lane&1) | (u>>2): odd lanes map all 4 weights to ONE column, even lanes to two
+            int Rrow[T_PER_LANE], Ccol[T_PER_LANE];
+            int r0 = 0, cbase = 0;
+            if constexpr (T_PER_LANE == 4)
+            {
+                const int l = lane >> 1;
+                const int p = l & 3, c1 = (l >> 2) & 1, c8 = l >> 3;
+                r0 = p * 2;                        // first adjacent k-row pair
+                cbase = c8 * 2 + c1;
+            }
+            else
+            {
+                #pragma unroll
+                for (int u = 0; u < T_PER_LANE; ++u)
+                {
+                    const int t = lane * T_PER_LANE + u;
+                    const int l = t >> 3, j = t & 7;
+                    const int p = l & 3, c1 = (l >> 2) & 1, c8 = l >> 3;
+                    const int d = j & 1, cc = (j >> 1) & 1, h8 = j >> 2;
+                    Rrow[u] = cc * 8 + p * 2 + d;      // k-row within the ktile
+                    Ccol[u] = h8 * 8 + c8 * 2 + c1;    // column within the subtile
+                }
+            }
+
+            float acc[2][T_PER_LANE];
+            #pragma unroll
+            for (int s = 0; s < 2; ++s)
+                #pragma unroll
+                for (int u = 0; u < T_PER_LANE; ++u) acc[s][u] = 0.0f;
+
+            const int kt0 = kc * chunk;
+            const int kt1 = sycl::min(kt0 + chunk, ktiles);
+            for (int kt = kt0; kt < kt1; ++kt)
+            {
+                const uint16_t* tile = packed + (size_t) (kt * ntiles + kb_n * 2) * packed_size;
+                PackedPtrU16 ptr0{ tile, words };
+                PackedPtrU16 ptr1{ tile + packed_size, words };
+                const int k0 = kt * 16;
+                sycl::half w0[4], w1[4];
+                if constexpr (T_PER_LANE == 4)
+                {
+                    dq4<K, cb>(ptr0, lane * 4, w0);
+                    dq4<K, cb>(ptr1, lane * 4, w1);
+                }
+                else
+                {
+                    #pragma unroll
+                    for (int u = 0; u < T_PER_LANE; ++u)
+                    {
+                        w0[u] = dq<K, cb>(ptr0, lane * T_PER_LANE + u);
+                        w1[u] = dq<K, cb>(ptr1, lane * T_PER_LANE + u);
+                    }
+                }
+                if constexpr (T_PER_LANE == 4)
+                {
+                    // 2 vector loads serve both tiles (the pair shares the same k-rows)
+                    const uint32_t v0 = *(const uint32_t*) (A + k0 + r0);
+                    const uint32_t v1 = *(const uint32_t*) (A + k0 + 8 + r0);
+                    const float a[4] = { ushort_as_half(v0 & 0xffff), ushort_as_half(v0 >> 16),
+                                         ushort_as_half(v1 & 0xffff), ushort_as_half(v1 >> 16) };
+                    #pragma unroll
+                    for (int u = 0; u < 4; ++u)
+                    {
+                        acc[0][u] = fmaf(a[u], (float) w0[u], acc[0][u]);
+                        acc[1][u] = fmaf(a[u], (float) w1[u], acc[1][u]);
+                    }
+                }
+                else
+                {
+                    #pragma unroll
+                    for (int u = 0; u < T_PER_LANE; ++u)
+                    {
+                        acc[0][u] = fmaf((float) A[k0 + Rrow[u]], (float) w0[u], acc[0][u]);
+                        acc[1][u] = fmaf((float) A[k0 + Rrow[u]], (float) w1[u], acc[1][u]);
+                    }
+                }
+            }
+            #pragma unroll
+            for (int u = 0; u < T_PER_LANE; ++u)
+            {
+                if constexpr (T_PER_LANE == 4)
+                {
+                    const int ch = (lane & 1) | (u >> 2);
+                    const int R = (u >> 1) * 8 + r0 + (u & 1);
+                    lout[ch * 8 + cbase][R] = acc[0][u];
+                    lout[16 + ch * 8 + cbase][R] = acc[1][u];
+                }
+                else
+                {
+                    lout[Ccol[u]][Rrow[u]] = acc[0][u];
+                    lout[16 + Ccol[u]][Rrow[u]] = acc[1][u];
+                }
+            }
+            sycl::group_barrier(it.get_group());
+            // each output column sums the tile's 16 k-rows; the pair covers outputs
+            // [kb_n*32, kb_n*32+32) — disjoint fp32 partial slices, slice kc
+            for (int col = lane; col < 32; col += LANES)
+            {
+                float s = 0.0f;
+                for (int row = 0; row < 16; ++row) s += lout[col][row];
+                scratch[(size_t) kc * size_n + kb_n * 32 + col] = s;
+            }
+        });
+    });
+
+    // reduce: sum the KS fp32 partial slices into C (m == 1: row 0) — same kernel as the
+    // one-subtile split (the partial layout is identical)
+    q.submit([&](sycl::handler& h)
+    {
+        h.parallel_for<GemvSplitKsReduceName<K, cb, false, LANES, KS>>(
+            sycl::range<1>((size_t) size_n), [=](sycl::item<1> item)
+        {
+            const int i = (int) item.get_linear_id();
+            float s = 0.0f;
+            #pragma unroll
+            for (int c = 0; c < KS; ++c) s += scratch[(size_t) c * size_n + i];
+            if (c_fp32) ((float*) C)[i] = s;
+            else        ((sycl::half*) C)[i] = sycl::half(s);
+        });
+    });
+}
+
+// Fused split-K reduce + output Hadamard (replaces the separate reduce kernel and the caller's
+// post-Hadamard: one launch instead of two, and C is never round-tripped through memory twice).
+// One work-group per 128-column block: sum the KS fp32 partial slices, H128 butterfly in SLM,
+// scale by svh, write C. The butterfly is the same natural-order Sylvester transform (and sign
+// convention) as hadamard.cpp's had_r_128, with r_scale = 1/sqrt(128).
+static bool g_esimd_defer_reduce = false;
+
+template <int KS, typename OUT>
+class GemvReduceHadName;
+
+template <int KS, typename OUT>
+static void launch_gemv_reduce_had(sycl::queue& q, const float* scratch, OUT* C,
+                                   const sycl::half* svh, int size_n)
+{
+    const int chunks = size_n / 128;
+    q.submit([&](sycl::handler& h)
+    {
+        sycl::local_accessor<float, 1> buf(sycl::range<1>(128), h);
+        h.parallel_for<GemvReduceHadName<KS, OUT>>(
+            sycl::nd_range<1>(sycl::range<1>((size_t) chunks * 128), sycl::range<1>(128)),
+            [=](sycl::nd_item<1> it)
+        {
+            const int chunk = (int) it.get_group_linear_id();
+            const int p = (int) it.get_local_id(0);
+            const int col = chunk * 128 + p;
+            float v = 0.0f;
+            #pragma unroll
+            for (int c = 0; c < KS; ++c) v += scratch[(size_t) c * size_n + col];
+            // Match the unfused reduce's dtype: the separate reduce writes (OUT) before the
+            // Hadamard, so for a half output the butterfly input is the fp16-rounded sum
+            if constexpr (std::is_same_v<OUT, sycl::half>)
+                v = (float) (sycl::half) v;
+            buf[p] = v;
+            sycl::group_barrier(it.get_group());
+            for (int st = 0; st < 7; ++st)
+            {
+                float pv = buf[p ^ (1 << st)];
+                sycl::group_barrier(it.get_group());
+                buf[p] = (((p >> st) & 1) ? (pv - buf[p]) : (buf[p] + pv));
+                sycl::group_barrier(it.get_group());
+            }
+            C[col] = (OUT) (buf[p] * 0.08838834764831845f * (float) svh[col]);
+        });
+    });
+}
+
+// Proper ESIMD tile-once GEMV (SYCL_ESIMD_KERNEL), mul1 (cb=2) only: each work item = 8
+// consecutive virtual lanes (simd<8>), the mul1 decode via the native dp4a (1 instruction vs the
+// ~11-op dp4a_ones byte-sum), the window extraction via ONE 32-bit funnel decomposition
+// ((a << (31-s2)) << 1 | (b >> s2) == low 32 of (a:b) >> s2, safe for s2 in [0,31]) + constant
+// shifts for the 4 windows (bits <= 5 keeps them in the low 32), the cross-lane reduction in
+// registers via scalar element access (the SLM is broken in nd_range ESIMD kernels and strided
+// selects miscompile — probed empirically, test_esimd22-26), disjoint scratch writes + the split-K
+// reduce kernel (the production epilogue pattern). Benched on the 27B's cold production shapes
+// (bench27b.cpp variant 41-43): KS=16, 1.07-1.20x over the vec kernel, exact correctness on all
+// four shapes. Half-integer rates and cb 0/1 keep the vec kernel (the lop3 decode needs a uint16
+// -> half bit-reinterpret on simd, which miscompiles here).
+template <int K, int KS>
+class GemvEsimdKernelName;
+template <int K, int KS>
+class GemvEsimdReduceName;
+
+template <int K, int KS>
+void launch_gemv_esimd(sycl::queue& q, const sycl::half* A, const uint16_t* packed, void* C,
+                       int size_m, int size_k, int size_n, int stride, bool c_fp32)
+{
+    using namespace sycl::ext::intel::esimd;
+    constexpr int packed_size = 16 * K;
+    constexpr int words = tile_words(K, false);
+    const int ntiles = (stride > 0 ? stride : size_n) / 16;
+    const int ngroups = size_n / 32;         // tile PAIRS along n
+    const int ktiles = size_k / 16;
+    const int chunk = (ktiles + KS - 1) / KS;
+    float* scratch = splitk_scratch(q);
+    const float k_inv = float(ushort_as_half(0x1eee));
+    const float k_bias = float(ushort_as_half(0xc931));
+
+    q.submit([&](sycl::handler& h)
+    {
+        h.parallel_for<GemvEsimdKernelName<K, KS>>(sycl::nd_range<1>(
+            sycl::range<1>((size_t) ngroups * KS * 8), sycl::range<1>(8)),
+            [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL
+        {
+            const int gid = (int) it.get_group_linear_id();
+            const int kb_n = gid / KS;              // tile pair along n
+            const int kc = gid % KS;                // k-chunk
+            const int j = (int) it.get_local_id(0); // work item covers lanes 8j..8j+7
+
+            // simd<8> over the 8 virtual lanes e = 0..7, lane = 8*j + e; the lane's 4 t-slots
+            // (t = lane*4 + u) map to k-rows {r0, r0+1, 8+r0, 8+r0+1} and column ch*8 + cbase
+            // with ch = lane&1, cbase = j (constant across the work item)
+            simd<uint32_t, 8> ev(0u);
+            for (int i = 0; i < 8; ++i) ev[i] = (uint32_t) i;
+            const simd<uint32_t, 8> lane = ev + 8u * (uint32_t) j;
+            const simd<uint32_t, 8> l = lane >> 1;
+            const simd<uint32_t, 8> p = l & 3u;
+            const simd<uint32_t, 8> r0 = p << 1;               // first adjacent k-row pair
+            constexpr uint32_t bits = K;
+            const simd<uint32_t, 8> t_off = lane << 2;         // lane * 4
+            const simd<uint32_t, 8> b0 = (t_off + 257u) * bits - 16u;
+            const simd<uint32_t, 8> b2 = b0 + 3u * bits + 16u;
+            const simd<uint32_t, 8> i0 = b0 >> 5;
+            const simd<uint32_t, 8> i2 = (b2 - 1u) >> 5;
+            const simd<uint32_t, 8> s2 = (i2 + 1u) * 32u - b2;
+            const simd<uint32_t, 8> sh_a = 31u - s2;           // (a << (31-s2)) << 1 == a << (32-s2)
+            const simd<uint32_t, 8> i0w = i0 % words;          // wrap (b0 > 0 always)
+            const simd<uint32_t, 8> i2w = i2 % words;
+
+            const simd<uint32_t, 8> c0101(0x01010101u);
+            const simd<uint32_t, 8> c6400(0x6400u);
+
+            simd<float, 8> acc[2][4];
+            for (int s = 0; s < 2; ++s)
+                for (int u = 0; u < 4; ++u) acc[s][u] = simd<float, 8>(0.0f);
+
+            const int kt0 = kc * chunk;
+            const int kt1 = kt0 + chunk < ktiles ? kt0 + chunk : ktiles;
+            for (int kt = kt0; kt < kt1; ++kt)
+            {
+                const uint16_t* tile0 = packed + (size_t) (kt * ntiles + kb_n * 2) * packed_size;
+                const uint32_t* w0p = (const uint32_t*) tile0;
+                const uint32_t* w1p = (const uint32_t*) (tile0 + packed_size);
+                const int k0 = kt * 16;
+                // word gathers: the PackedPtr word i = p[2i] | p[2i+1]<<16, uint32 at byte 4i
+                const simd<uint32_t, 8> a0 = gather<uint32_t, 8>(w0p, i0w * 4u);
+                const simd<uint32_t, 8> b0v = gather<uint32_t, 8>(w0p, i2w * 4u);
+                const simd<uint32_t, 8> a1 = gather<uint32_t, 8>(w1p, i0w * 4u);
+                const simd<uint32_t, 8> b1v = gather<uint32_t, 8>(w1p, i2w * 4u);
+                // funnel decomposition + the 4 windows per tile (bits <= 5: all in the low 32)
+                const simd<uint32_t, 8> win0 = ((a0 << sh_a) << 1u) | (b0v >> s2);
+                const simd<uint32_t, 8> win1 = ((a1 << sh_a) << 1u) | (b1v >> s2);
+                // A: the lane's 4 t-slots map to k-rows {r0, r0+1, 8+r0, 8+r0+1} (both tiles)
+                simd<float, 8> af[4];
+                for (int u = 0; u < 4; ++u)
+                {
+                    const uint32_t krow = (uint32_t) k0 + (u & 1) + 8u * (u >> 1);
+                    af[u] = convert<float, sycl::half, 8>(
+                        gather<sycl::half, 8>(A, 2u * (krow + r0)));
+                }
+                for (int u = 0; u < 4; ++u)
+                {
+                    // tile 0: the u-th window sits at shift bits*(3-u) within win
+                    simd<uint32_t, 8> x = ((win0 >> (bits * (3u - (uint32_t) u))) & 0xffffu)
+                                          * 0x83DCD12Du;
+                    simd<uint32_t, 8> sum = dp4a<uint32_t>(c6400, x, c0101);
+                    simd<float, 8> hv = convert<float, uint32_t, 8>(sum) - 24576.0f;
+                    simd<float, 8> wf = convert<float, sycl::half, 8>(
+                        convert<sycl::half, float, 8>(hv * k_inv + k_bias));
+                    acc[0][u] += af[u] * wf;
+                    // tile 1
+                    simd<uint32_t, 8> x1 = ((win1 >> (bits * (3u - (uint32_t) u))) & 0xffffu)
+                                           * 0x83DCD12Du;
+                    simd<uint32_t, 8> sum1 = dp4a<uint32_t>(c6400, x1, c0101);
+                    simd<float, 8> hv1 = convert<float, uint32_t, 8>(sum1) - 24576.0f;
+                    simd<float, 8> wf1 = convert<float, sycl::half, 8>(
+                        convert<sycl::half, float, 8>(hv1 * k_inv + k_bias));
+                    acc[1][u] += af[u] * wf1;
+                }
+            }
+            // cross-lane reduction in registers: the work item's 8 lanes cover column j (even
+            // lanes) and 8+j (odd) for tile 0, +16 for tile 1; the column partial sums the 16 rows
+            float colp[4];
+            for (int s = 0; s < 2; ++s)
+                for (int par = 0; par < 2; ++par)
+                {
+                    float t = 0.0f;
+                    for (int u = 0; u < 4; ++u)
+                        for (int e = par; e < 8; e += 2) t += (float) acc[s][u][e];
+                    colp[2 * s + par] = t;
+                }
+            // disjoint scratch writes: the pair's columns {j, 8+j, 16+j, 24+j}
+            for (int c = 0; c < 4; ++c)
+                scatter(scratch, simd<uint32_t, 1>(
+                    4u * (uint32_t) (kc * size_n + kb_n * 32 + j + 8 * c)),
+                    simd<float, 1>(colp[c]));
+        });
+    });
+
+    // reduce: sum the KS fp32 partial slices into C (the same kernel as the other splits);
+    // skipped when the caller fuses it with the output Hadamard (sycl_gemv_mul1_had below)
+    if (g_esimd_defer_reduce) return;
+    q.submit([&](sycl::handler& h)
+    {
+        h.parallel_for<GemvEsimdReduceName<K, KS>>(sycl::range<1>((size_t) size_n),
+            [=](sycl::item<1> item)
+        {
+            const int i = (int) item.get_linear_id();
+            float s = 0.0f;
+            #pragma unroll
+            for (int c = 0; c < KS; ++c) s += scratch[(size_t) c * size_n + i];
+            if (c_fp32) ((float*) C)[i] = s;
+            else        ((sycl::half*) C)[i] = sycl::half(s);
+        });
+    });
+}
+
+// mul1 (cb=2) GEMV with the output Hadamard fused into the split-K reduce: runs the ESIMD tile
+// kernel (deferred reduce) then the fused reduce+H128 kernel. Falls back to the normal path
+// (returns false) whenever the shape is outside the ESIMD dispatch. Only K in [1,5] is wired.
+bool sycl_gemv_mul1_had(sycl::queue& q, const sycl::half* A, const uint16_t* packed, void* C,
+                        bool c_fp32, const sycl::half* svh, int size_k, int size_n, int K)
+{
+    if (K < 1 || K > 5 || size_k < 4096 || size_n < 4096 || size_n >= 40960 || size_n % 128 != 0 || size_k % 16 != 0)
+        return false;
+    const char* e = std::getenv("EXL3_FUSED_HAD");
+    if (e && atoi(e) == 0) return false;
+
+    g_esimd_defer_reduce = true;
+    switch (K)
+    {
+        case 1: launch_gemv_esimd<1, 16>(q, A, packed, C, 1, size_k, size_n, 0, c_fp32); break;
+        case 2: launch_gemv_esimd<2, 16>(q, A, packed, C, 1, size_k, size_n, 0, c_fp32); break;
+        case 3: launch_gemv_esimd<3, 16>(q, A, packed, C, 1, size_k, size_n, 0, c_fp32); break;
+        case 4: launch_gemv_esimd<4, 16>(q, A, packed, C, 1, size_k, size_n, 0, c_fp32); break;
+        case 5: launch_gemv_esimd<5, 16>(q, A, packed, C, 1, size_k, size_n, 0, c_fp32); break;
+    }
+    g_esimd_defer_reduce = false;
+    if (c_fp32)
+        launch_gemv_reduce_had<16, float>(q, splitk_scratch(q), (float*) C, svh, size_n);
+    else
+        launch_gemv_reduce_had<16, sycl::half>(q, splitk_scratch(q), (sycl::half*) C, svh, size_n);
+    return true;
+}
+
+// Kernel-instance table (cbi = K - 1; +8 for mcg, +16 for mul1, 24 + K - 1 for the half-integer
+// rates), used by the host GEMV entry points
+template <int K>
+inline void expand_cb_gemv(GemvFn (&table)[27])
+{
+    table[K - 1]      = &launch_gemv<K, 0, false>;
+    table[K - 1 + 8]  = &launch_gemv<K, 1, false>;
+    table[K - 1 + 16] = &launch_gemv<K, 2, false>;
+}
+
+template <int K, int LANES>
+inline void expand_cb_gemv_splitk(GemvFn (&table)[27])
+{
+    table[K - 1]      = &launch_gemv_splitk<K, 0, false, LANES>;
+    table[K - 1 + 8]  = &launch_gemv_splitk<K, 1, false, LANES>;
+    table[K - 1 + 16] = &launch_gemv_splitk<K, 2, false, LANES>;
+}
+
+static const GemvFn* gemv_table()
+{
+    static GemvFn table[27] = {};
+    static bool init = false;
+    if (!init)
+    {
+        expand_cb_gemv<1>(table); expand_cb_gemv<2>(table); expand_cb_gemv<3>(table);
+        expand_cb_gemv<4>(table); expand_cb_gemv<5>(table); expand_cb_gemv<6>(table);
+        expand_cb_gemv<7>(table); expand_cb_gemv<8>(table);
+        table[24] = &launch_gemv<1, 2, true>;
+        table[25] = &launch_gemv<2, 2, true>;
+        table[26] = &launch_gemv<3, 2, true>;
+        init = true;
+    }
+    return table;
+}
+
+template <int LANES>
+static const GemvFn* gemv_splitk_table()
+{
+    static GemvFn table[27] = {};
+    static bool init = false;
+    if (!init)
+    {
+        expand_cb_gemv_splitk<1, LANES>(table); expand_cb_gemv_splitk<2, LANES>(table);
+        expand_cb_gemv_splitk<3, LANES>(table); expand_cb_gemv_splitk<4, LANES>(table);
+        expand_cb_gemv_splitk<5, LANES>(table); expand_cb_gemv_splitk<6, LANES>(table);
+        expand_cb_gemv_splitk<7, LANES>(table); expand_cb_gemv_splitk<8, LANES>(table);
+        table[24] = &launch_gemv_splitk<1, 2, true, LANES>;
+        table[25] = &launch_gemv_splitk<2, 2, true, LANES>;
+        table[26] = &launch_gemv_splitk<3, 2, true, LANES>;
+        init = true;
+    }
+    return table;
+}
+
+template <int K, int LANES, int KS>
+inline void expand_cb_gemv_splitks(GemvFn (&table)[27])
+{
+    table[K - 1]      = &launch_gemv_splitk_ks<K, 0, false, LANES, KS>;
+    table[K - 1 + 8]  = &launch_gemv_splitk_ks<K, 1, false, LANES, KS>;
+    table[K - 1 + 16] = &launch_gemv_splitk_ks<K, 2, false, LANES, KS>;
+}
+
+template <int LANES, int KS>
+static const GemvFn* gemv_splitks_table()
+{
+    static GemvFn table[27] = {};
+    static bool init = false;
+    if (!init)
+    {
+        expand_cb_gemv_splitks<1, LANES, KS>(table); expand_cb_gemv_splitks<2, LANES, KS>(table);
+        expand_cb_gemv_splitks<3, LANES, KS>(table); expand_cb_gemv_splitks<4, LANES, KS>(table);
+        expand_cb_gemv_splitks<5, LANES, KS>(table); expand_cb_gemv_splitks<6, LANES, KS>(table);
+        expand_cb_gemv_splitks<7, LANES, KS>(table); expand_cb_gemv_splitks<8, LANES, KS>(table);
+        table[24] = &launch_gemv_splitk_ks<1, 2, true, LANES, KS>;
+        table[25] = &launch_gemv_splitk_ks<2, 2, true, LANES, KS>;
+        table[26] = &launch_gemv_splitk_ks<3, 2, true, LANES, KS>;
+        init = true;
+    }
+    return table;
+}
+
+template <int K, int LANES, int KS>
+inline void expand_cb_gemv_mt2(GemvFn (&table)[27])
+{
+    table[K - 1]      = &launch_gemv_mt2<K, 0, LANES, KS>;
+    table[K - 1 + 8]  = &launch_gemv_mt2<K, 1, LANES, KS>;
+    table[K - 1 + 16] = &launch_gemv_mt2<K, 2, LANES, KS>;
+}
+
+template <int LANES, int KS>
+static const GemvFn* gemv_mt2_table()
+{
+    static GemvFn table[27] = {};
+    static bool init = false;
+    if (!init)
+    {
+        expand_cb_gemv_mt2<1, LANES, KS>(table); expand_cb_gemv_mt2<2, LANES, KS>(table);
+        expand_cb_gemv_mt2<3, LANES, KS>(table); expand_cb_gemv_mt2<4, LANES, KS>(table);
+        expand_cb_gemv_mt2<5, LANES, KS>(table);
+        init = true;
+    }
+    return table;
+}
+
+// ESIMD tile-once table: starts from the MT2 table (fallback rows), overrides the mul1 rows
+// (K 1..5) with the ESIMD kernel at KS=16
+template <int K, int KS>
+inline void expand_esimd_gemv(GemvFn (&table)[27])
+{
+    table[K - 1 + 16] = &launch_gemv_esimd<K, KS>;
+}
+
+template <int KS>
+static const GemvFn* gemv_esimd_table()
+{
+    static GemvFn table[27] = {};
+    static bool init = false;
+    if (!init)
+    {
+        __builtin_memcpy(table, gemv_mt2_table<64, 32>(), sizeof(table));
+        expand_esimd_gemv<1, KS>(table); expand_esimd_gemv<2, KS>(table);
+        expand_esimd_gemv<3, KS>(table); expand_esimd_gemv<4, KS>(table);
+        expand_esimd_gemv<5, KS>(table);
+        init = true;
+    }
+    return table;
+}
+
+// m == 3 (the MTP verify's row count, draft_num_tokens 2 + 1): the mt2 layout with M
+// accumulator rows. The trellis decodes ONCE per (ktile, lane) and per row does 2 vector 4B
+// A-loads (the 4 t-slots map to k-rows {r0, r0+1, 8+r0, 8+r0+1}, both tiles sharing them), so
+// the decode — 84% of the m=1 GEMV — amortizes over M rows. The generic kernel re-decodes the
+// tile per output row (M x traffic amplification, unoptimized decode), which made the verify
+// pass ~10x slower per GEMV and MTP drafting ~1.8 tok/s despite a 46-70% acceptance rate.
+// KS k-chunks write disjoint fp32 partial slices; a reduce kernel sums them into C. Integer
+// K <= 5 (dq4), cb <= 2 (the table covers cb 0..2), LANES 64 (T_PER_LANE == 4: the
+// vectorized-A mapping), size_n % 32 == 0 (the tile-pair extent).
+template <int M, int K, int cb, int LANES, int KS>
+class GemvMtpKernelName;
+template <int M, int K, int cb, int LANES, int KS>
+class GemvMtpReduceName;
+
+template <int M, int K, int cb, int LANES, int KS>
+void launch_gemv_mtp(sycl::queue& q, const sycl::half* A, const uint16_t* packed, void* C,
+                     int size_m, int size_k, int size_n, int stride, bool c_fp32)
+{
+    constexpr int packed_size = 16 * K;
+    constexpr int words = tile_words(K, false);
+    const int ntiles = (stride > 0 ? stride : size_n) / 16;
+    const int ngroups = size_n / 32;         // tile PAIRS along n
+    const int ktiles = size_k / 16;
+    const int chunk = (ktiles + KS - 1) / KS;
+    float* scratch = splitk_scratch(q);
+
+    q.submit([&](sycl::handler& h)
+    {
+        // tiny per-lane staging (768 B/group): the 6 KB lout SLM cost an occupancy cliff
+        // (M=1 2KB 0.34ms, M=2 4KB 0.37ms, M=3 6KB 0.61ms at n=17408 k=5120 — the m=2->m=3
+        // step is a cliff, not linear work)
+        sycl::local_accessor<float, 1> lsum(sycl::range<1>((size_t) M * 2 * LANES), h);
+        h.parallel_for<GemvMtpKernelName<M, K, cb, LANES, KS>>(
+            sycl::nd_range<1>(sycl::range<1>((size_t) ngroups * KS * LANES), sycl::range<1>(LANES)),
+            [=](sycl::nd_item<1> it)
+        {
+            const int gid = (int) it.get_group_linear_id();
+            const int kb_n = gid / KS;              // tile pair along n
+            const int kc = gid % KS;                // k-chunk
+            const int lane = (int) it.get_local_id(0);
+
+            const int l = lane >> 1;
+            const int p = l & 3, c1 = (l >> 2) & 1, c8 = l >> 3;
+            const int r0 = p * 2;                   // first adjacent k-row pair
+            const int cbase = c8 * 2 + c1;
+
+            float acc[M][2][4];
+            #pragma unroll
+            for (int r = 0; r < M; ++r)
+                #pragma unroll
+                for (int s = 0; s < 2; ++s)
+                    #pragma unroll
+                    for (int u = 0; u < 4; ++u) acc[r][s][u] = 0.0f;
+
+            const int kt0 = kc * chunk;
+            const int kt1 = sycl::min(kt0 + chunk, ktiles);
+            constexpr bool wp2 = (words & (words - 1)) == 0;
+            for (int kt = kt0; kt < kt1; ++kt)
+            {
+                const uint16_t* tile = packed + (size_t) (kt * ntiles + kb_n * 2) * packed_size;
+                using PP = std::conditional_t<wp2, PackedPtrU16Pow2<true>, PackedPtrU16>;
+                PP ptr0{ tile, words };
+                PP ptr1{ tile + packed_size, words };
+                const int k0 = kt * 16;
+                sycl::half w0[4], w1[4];
+                dq4<K, cb>(ptr0, lane * 4, w0);
+                dq4<K, cb>(ptr1, lane * 4, w1);
+                #pragma unroll
+                for (int r = 0; r < M; ++r)
+                {
+                    // 2 vector loads serve both tiles (the pair shares the same k-rows)
+                    const sycl::half* xr = A + (size_t) r * size_k;
+                    const uint32_t v00 = *(const uint32_t*) (xr + k0 + r0);
+                    const uint32_t v01 = *(const uint32_t*) (xr + k0 + 8 + r0);
+                    const float a[4] = { ushort_as_half(v00 & 0xffff), ushort_as_half(v00 >> 16),
+                                         ushort_as_half(v01 & 0xffff), ushort_as_half(v01 >> 16) };
+                    #pragma unroll
+                    for (int u = 0; u < 4; ++u)
+                    {
+                        acc[r][0][u] = fmaf(a[u], (float) w0[u], acc[r][0][u]);
+                        acc[r][1][u] = fmaf(a[u], (float) w1[u], acc[r][1][u]);
+                    }
+                }
+            }
+            // per-lane 4-row sums staged tiny: each lane's acc covers 4 rows of ITS column
+            // (rows r0..r0+1, 8+r0..8+r0+1), and the 4 owner lanes (base+2p, p=0..3, same
+            // ch/cbase) cover all 16 rows — so the column partial needs only 4 lane sums
+            for (int r = 0; r < M; ++r)
+                for (int s = 0; s < 2; ++s)
+                    lsum[(size_t) lane * (M * 2) + r * 2 + s] =
+                        acc[r][s][0] + acc[r][s][1] + acc[r][s][2] + acc[r][s][3];
+            sycl::group_barrier(it.get_group());
+            // each lane reduces its own column from the 4 owner lanes
+            const int base = 2 * (c8 * 8 + c1 * 4) + (lane & 1);
+            for (int r = 0; r < M; ++r)
+                for (int s = 0; s < 2; ++s)
+                {
+                    float t = 0.0f;
+                    #pragma unroll
+                    for (int pp = 0; pp < 4; ++pp)
+                        t += lsum[(size_t) (base + 2 * pp) * (M * 2) + r * 2 + s];
+                    scratch[(size_t) (r * KS + kc) * size_n + kb_n * 32 + s * 16 + (lane & 1) * 8 + cbase] = t;
+                }
+        });
+    });
+
+    // reduce: sum the KS fp32 partial slices per (row, col) into C
+    q.submit([&](sycl::handler& h)
+    {
+        h.parallel_for<GemvMtpReduceName<M, K, cb, LANES, KS>>(
+            sycl::range<1>((size_t) M * size_n), [=](sycl::item<1> item)
+        {
+            const int idx = (int) item.get_linear_id();
+            const int r = idx / size_n;
+            const int i = idx - r * size_n;
+            float s = 0.0f;
+            #pragma unroll
+            for (int c = 0; c < KS; ++c) s += scratch[(size_t) (r * KS + c) * size_n + i];
+            if (c_fp32) ((float*) C)[idx] = s;
+            else        ((sycl::half*) C)[idx] = sycl::half(s);
+        });
+    });
+}
+
+// MTP verify GEMV table: the mt2-style rows (K 1..5, cb 0..2) pointing at launch_gemv_mtp
+template <int K, int M, int LANES, int KS>
+inline void expand_cb_gemv_mtp(GemvFn (&table)[27])
+{
+    table[K - 1]      = &launch_gemv_mtp<M, K, 0, LANES, KS>;
+    table[K - 1 + 8]  = &launch_gemv_mtp<M, K, 1, LANES, KS>;
+    table[K - 1 + 16] = &launch_gemv_mtp<M, K, 2, LANES, KS>;
+}
+
+template <int M, int KS>
+static const GemvFn* gemv_mtp_table()
+{
+    static GemvFn table[27] = {};
+    static bool init = false;
+    if (!init)
+    {
+        expand_cb_gemv_mtp<1, M, 64, KS>(table); expand_cb_gemv_mtp<2, M, 64, KS>(table);
+        expand_cb_gemv_mtp<3, M, 64, KS>(table); expand_cb_gemv_mtp<4, M, 64, KS>(table);
+        expand_cb_gemv_mtp<5, M, 64, KS>(table);
+        init = true;
+    }
+    return table;
+}
+
+// Decode GEMV dispatch: the tile-once kernel for the m == 1 decode path where either
+// (a) there are enough n-subtiles to keep the one-group-per-subtile layout occupied
+// (size_n/16 >= 256, i.e. size_n >= 4096 — at k=2560 measured 1.85x at n=4096, 2.8x at n=9216,
+// and 14.8x on the 4B's K=8 lm_head n=248320, whose serial launch was reading the packed stream
+// 16x-amplified at only ~20 GB/s), or (b) size_k >= 4096, where the serial kernel's per-column
+// layout re-reads every subtile's tile stream 16x (the 27B's shapes; 2.1x end-to-end there).
+// Below both (short-k small-n shapes, e.g. k=2560 n=1024 = 64 subtiles) the per-output kernel
+// wins: the tile-once layout doesn't fill the machine and its group reduction only adds overhead.
+// Measured on the exact 4B shapes (bench4b.cpp): k=2560 n=1024 serial 2x FASTER, n=2560 k=4096
+// serial slightly faster, n=2560 k=9216 tile-once 1.21x, n=4096 tile-once 1.85x, n=9216 2.8x.
+// Layer shapes with few subtiles but a long k chain (under ~5120 hardware threads at 64
+// lanes/group) go to the KS-split tile-once instead: measured 1.25-2.2x over the unsplit
+// tile-once on the 27B's cold production shapes (bench27b.cpp); the lm_head (15k+ subtiles)
+// stays unsplit
+static inline GemvFn gemv_dispatch(int size_m, int size_k, int size_n, int cbi)
+{
+    if (size_m != 1)
+    {
+        // MTP verify (draft_num_tokens 2 + 1 = 3 rows): the mt2-style kernel decodes the trellis
+        // once per (ktile, lane) and per row does 2 vector A loads — the generic kernel
+        // re-decodes the tile per output row (M x traffic amplification). Needs integer K <= 5
+        // (dq4's 4-window group), cb <= 2 (no half-integer rates: cbi >= 24 has no dq4), and
+        // size_n % 32 (the tile-pair extent). KS=32 k-chunks for the hidden layers (parallelism-
+        // starved shapes, scratch layout [row][chunk] x size_n fits the 32x262144-float cap at
+        // size_n <= 40960); the lm_head (n = 248320, 15k+ subtiles) has ample parallelism and
+        // takes KS=1 (scratch 3 x 248320 floats)
+        if (size_m == 3 && cbi < 24 && (cbi % 8) + 1 <= 5 && size_n % 32 == 0)
+        {
+            if (size_n <= 40960) return gemv_mtp_table<3, 32>()[cbi];
+            return gemv_mtp_table<3, 1>()[cbi];
+        }
+        return gemv_table()[cbi];
+    }
+    if (size_k < 4096 && size_n / 16 < 256) return gemv_table()[cbi];
+    const int ngroups = size_n / 16;
+    if (ngroups * 64 < 163840)
+    {
+        // MT2: two adjacent n-tiles per group (128B DRAM bursts) + the dq4 decode, KS=32 k-chunks —
+        // benched 1.16-1.31x over the KS=8 split on the 27B's cold production shapes (bench27b.cpp).
+        // Needs the tile PAIRS to be exact (size_n % 32 == 0), integer K <= 5 (dq4's 4-window group
+        // spans 3*bits+16 bits and must fit one word pair), and cb < 2 (the table covers cb 0..2;
+        // cbi >= 24 is the half-integer rates, which have no dq4)
+        if (size_n % 32 == 0 && cbi < 24 && (cbi % 8) + 1 <= 5)
+        {
+            // mul1 (cb == 2, cbi 16..23): the ESIMD tile-once GEMV at KS=16 — benched 1.07-1.20x
+            // over the vec kernel on the 27B's cold production shapes (k >= 4096, n >= 4096),
+            // exact correctness. Outside that range the fixed epilogue/reduce cost dominates
+            // (the 2B's k=2048 gate/up measured ~3% slower on the endpoint), and cb 0/1 need the
+            // vec kernel anyway (the lop3 decode needs a uint16->half bit reinterpret on simd,
+            // which miscompiles here)
+            if (cbi >= 16 && size_k >= 4096 && size_n >= 4096)
+                return gemv_esimd_table<16>()[cbi];
+            return gemv_mt2_table<64, 32>()[cbi];
+        }
+        return gemv_splitks_table<64, 8>()[cbi];
+    }
+    // mul1 (cbi 16..23) with K <= 5: the ESIMD tile-once kernel also wins on the many-subtile
+    // shapes it was previously excluded from by the scratch cap (the 27B lm_head, n=248320
+    // k=2048: 1.16x over the tile-once scalar kernel, bench27b.cpp; the ESIMD reduce writes
+    // KS x size_n partials, covered by the enlarged scratch). Needs size_n % 32 (the tile-pair
+    // extent). cbi < 24 keeps the half-integer rates on the scalar kernel (no ESIMD row)
+    if (cbi >= 16 && cbi < 24 && (cbi % 8) + 1 <= 5 && size_n % 32 == 0)
+        return gemv_esimd_table<16>()[cbi];
+    // 64 lanes when there are many subtiles (the lm_head: per-lane efficiency wins), 128 when
+    // few (the hidden layers: more lanes in flight wins)
+    return ((ngroups) >= 4096 ? gemv_splitk_table<64>() : gemv_splitk_table<128>())[cbi];
+}
+
+} // namespace
+
+void sycl_exl3_gemm_impl(sycl::queue& q,
+                         const at::Tensor& A, const at::Tensor& B, at::Tensor& C,
+                         const c10::optional<at::Tensor>& suh,
+                         const c10::optional<at::Tensor>& A_had,
+                         const c10::optional<at::Tensor>& svh,
+                         int64_t force_shape_idx, bool mcg, bool mul1, int64_t force_num_sms)
+{
+    (void) force_shape_idx;   // unused on SYCL (no per-shape kernel table)
+    (void) force_num_sms;     // unused on SYCL (no SM-count heuristic)
+
+    TORCH_CHECK(B.dim() == 3, "exl3_gemm: trellis must be 3D");
+    TORCH_CHECK(A.size(-1) == B.size(0) * 16, "exl3_gemm: A's last dim must be trellis K dim * 16");
+    TORCH_CHECK(C.size(-1) == B.size(1) * 16, "exl3_gemm: C's last dim must be trellis N dim * 16");
+    TORCH_CHECK(A.scalar_type() == at::kHalf, "exl3_gemm: A must be float16");
+    TORCH_CHECK(B.scalar_type() == at::kShort, "exl3_gemm: trellis must be uint16");
+    const bool c_fp32 = C.scalar_type() == at::kFloat;
+    if (!c_fp32) TORCH_CHECK(C.scalar_type() == at::kHalf, "exl3_gemm: C must be float16 or float32");
+    TORCH_CHECK(!(mcg && mul1), "exl3_gemm: specified both mcg and mul1");
+    TORCH_CHECK(suh.has_value() && A_had.has_value() && svh.has_value(), "exl3_gemm requires suh, A_had and svh");
+
+    int size_m = 1;
+    for (int d = 0; d < A.dim() - 1; ++d) size_m *= (int) A.size(d);
+    const int size_k = (int) A.size(-1);
+    const int size_n = (int) B.size(1) * 16;
+    TORCH_CHECK(C.numel() >= (int64_t) size_m * size_n, "exl3_gemm: C must hold one output row per row of A");
+
+    const int tile_u16 = (int) B.size(2);
+    const bool half_k = (tile_u16 % 16) != 0;
+    const int K = tile_u16 / 16;
+    TORCH_CHECK(!half_k || (tile_u16 % 16 == 8 && mul1),
+                "exl3_gemm: half-integer bitrates require the mul1 codebook");
+
+    int cb = 0;
+    if (mcg) cb = 1;
+    if (mul1) cb = 2;
+
+    // No rows or no output columns: nothing to compute. Empty reduction (k = 0): the product is zero
+    if (!size_m || !size_n) return;
+    if (!size_k)
+    {
+        C.zero_();
+        return;
+    }
+
+    TORCH_CHECK(size_k % 128 == 0, "exl3_gemm: K dimension must be divisible by 128");
+    TORCH_CHECK(size_n % 128 == 0, "exl3_gemm: N dimension must be divisible by 128");
+
+    // 1. Input Hadamard: A_had = (A . suh) . H / sqrt(128). The bsz-1 BC scratch follows the
+    // linear's out_dtype (fp32 for the GDN projections); like the CUDA kernel, treat the
+    // buffer as raw half storage (the fp32 allocation holds at least twice the needed bytes)
+    const sycl::half* A_ptr = (const sycl::half*) A.data_ptr();
+    if (A_had->scalar_type() == at::kFloat)
+        sycl_had_h_raw(q, A_ptr, (sycl::half*) A_had->data_ptr(),
+                       (const sycl::half*) suh->data_ptr(), nullptr, 1.0f, size_m, size_k / 128);
+    else
+        sycl_had_r_128(A, A_had.value(), suh, c10::nullopt, 1.0f);
+
+    // 2. GEMV: C = A_had @ W(hadamard basis)
+    int cbi = K - 1;
+    if (half_k) cbi += 24;
+    else if (cb == 1) cbi += 8;
+    else if (cb == 2) cbi += 16;
+    TORCH_CHECK(cbi >= 0 && cbi < 27, "exl3_gemm: kernel index out of range: ", cbi);
+
+    // mul1 decode + the fused reduce/output-Hadamard path (one launch instead of the separate
+    // reduce and post-Hadamard): same shape gate as the ESIMD dispatch -- K in [1,5] and the
+    // split-starved region (size_n < 40960); the lm_head (size_n >= 40960) keeps its splitk kernel
+    if (!half_k && cb == 2 && size_m == 1 && K <= 5 && size_n < 40960 && size_n % 32 == 0)
+    {
+        if (sycl_gemv_mul1_had(q, (const sycl::half*) A_had->data_ptr(),
+                               (const uint16_t*) B.data_ptr(), C.data_ptr(), c_fp32,
+                               (const sycl::half*) svh->data_ptr(), size_k, size_n, K))
+            return;
+    }
+
+    gemv_dispatch(size_m, size_k, size_n, cbi)(q,
+               (const sycl::half*) A_had->data_ptr(),
+               (const uint16_t*) B.data_ptr(),
+               C.data_ptr(),
+               size_m, size_k, size_n, 0, c_fp32);
+
+    // 3. Output Hadamard in place: C = C . H / sqrt(128) . svh
+    if (c_fp32)
+        sycl_had_r_128_f(C, C, c10::nullopt, svh, 1.0f);
+    else
+        sycl_had_r_128_h(C, C, c10::nullopt, svh, 1.0f);
+}
+
+// Entry point matching the CUDA binding surface: had(pre=suh) -> GEMV -> had(post=svh)
+void sycl_exl3_gemm(const at::Tensor& A, const at::Tensor& B, at::Tensor& C,
+                    const c10::optional<at::Tensor>& suh,
+                    const c10::optional<at::Tensor>& A_had,
+                    const c10::optional<at::Tensor>& svh,
+                    int64_t force_shape_idx, bool mcg, bool mul1, int64_t force_num_sms)
+{
+    sycl_exl3_gemm_impl(exl3_sycl_queue(), A, B, C, suh, A_had, svh,
+                        force_shape_idx, mcg, mul1, force_num_sms);
+}
+
+// Same flow without the (unused on SYCL) heuristic arguments
+void sycl_exl3_gemv(const at::Tensor& A, const at::Tensor& B, at::Tensor& C,
+                    const c10::optional<at::Tensor>& suh,
+                    const c10::optional<at::Tensor>& A_had,
+                    const c10::optional<at::Tensor>& svh, bool mcg, bool mul1)
+{
+    sycl_exl3_gemm_impl(exl3_sycl_queue(), A, B, C, suh, A_had, svh, -1, mcg, mul1, 0);
+}
+
+// GEMV + output Hadamard with an optional row stride (sliced mgemm mode); the input Hadamard
+// is the caller's responsibility
+void sycl_exl3_gemm_raw2(sycl::queue& q, const sycl::half* A_had,
+                         const uint16_t* trellis, void* C, const sycl::half* svh,
+                         int size_m, int size_k, int size_n, int stride, bool c_fp32,
+                         int K, int cb, bool half_k)
+{
+    if (!size_m || !size_n || !size_k) return;
+    TORCH_CHECK(size_k % 128 == 0 && size_n % 128 == 0, "exl3_gemm: dims must be divisible by 128");
+
+    int cbi = K - 1;
+    if (half_k) cbi += 24;
+    else if (cb == 1) cbi += 8;
+    else if (cb == 2) cbi += 16;
+    TORCH_CHECK(cbi >= 0 && cbi < 27, "exl3_gemm: kernel index out of range: ", cbi);
+    gemv_dispatch(size_m, size_k, size_n, cbi)(q, A_had, trellis, C, size_m, size_k, size_n, stride, c_fp32);
+
+    if (c_fp32)
+        sycl_had_f_raw(q, (const float*) C, (float*) C, nullptr, svh, 1.0f, size_m, size_n / 128, stride);
+    else
+        sycl_had_h_raw(q, (const sycl::half*) C, (sycl::half*) C, nullptr, svh, 1.0f, size_m, size_n / 128, stride);
+}
+
+void sycl_exl3_gemm_raw(sycl::queue& q, const sycl::half* A, sycl::half* A_had,
+                        const uint16_t* trellis, void* C, const sycl::half* suh,
+                        const sycl::half* svh, int size_m, int size_k, int size_n, bool c_fp32,
+                        int K, int cb, bool half_k)
+{
+    if (!size_m || !size_n || !size_k) return;
+    TORCH_CHECK(size_k % 128 == 0 && size_n % 128 == 0, "exl3_gemm: dims must be divisible by 128");
+
+    // 1. Input Hadamard
+    sycl_had_h_raw(q, A, A_had, suh, nullptr, 1.0f, size_m, size_k / 128);
+
+    // 2-3. GEMV + output Hadamard
+    sycl_exl3_gemm_raw2(q, A_had, trellis, C, svh, size_m, size_k, size_n, 0, c_fp32, K, cb, half_k);
+}
diff --git a/exllamav3/exllamav3_ext/sycl/gumbel.cpp b/exllamav3/exllamav3_ext/sycl/gumbel.cpp
new file mode 100644
index 0000000..7243d7f
--- /dev/null
+++ b/exllamav3/exllamav3_ext/sycl/gumbel.cpp
@@ -0,0 +1,203 @@
+// Gumbel-noise sampling kernels, port of generator/gumbel.cu + the packed-logit-bitmask kernel of
+// generator/sampling_fused.cu into SYCL.
+//
+// The RNG is a Philox4x32-10 counter-based generator, bit-identical to cuRAND's
+// curand_init(random, idx, 0) + curand_uniform: the kernels read exactly the first output word of
+// the counter (0, 0, idx_lo, idx_hi) with key (seed_lo, seed_hi), so sampling parity holds.
+
+#include <sycl/sycl.hpp>
+#include <ATen/Tensor.h>
+#include <cmath>
+
+#include "exl3_compat.h"
+
+namespace {
+
+// cuRAND Philox4x32-10 constants
+constexpr uint32_t PHILOX_M0 = 0xD2511F53u;
+constexpr uint32_t PHILOX_M1 = 0xCD9E8D57u;
+constexpr uint32_t PHILOX_W0 = 0x9E3779B9u;
+constexpr uint32_t PHILOX_W1 = 0xBB67AE85u;
+
+struct PhiloxCtr { uint32_t x, y, z, w; };
+struct PhiloxKey { uint32_t x, y; };
+
+inline void philox_mulhilo(uint32_t a, uint32_t b, uint32_t* hi, uint32_t* lo)
+{
+    const uint64_t p = (uint64_t) a * (uint64_t) b;
+    *hi = (uint32_t) (p >> 32);
+    *lo = (uint32_t) p;
+}
+
+inline PhiloxCtr philox_round(PhiloxCtr c, PhiloxKey k)
+{
+    uint32_t hi0, lo0, hi1, lo1;
+    philox_mulhilo(PHILOX_M0, c.x, &hi0, &lo0);
+    philox_mulhilo(PHILOX_M1, c.z, &hi1, &lo1);
+    return { hi1 ^ c.y ^ k.x, lo1, hi0 ^ c.w ^ k.y, lo0 };
+}
+
+inline PhiloxCtr philox4x32_10(PhiloxCtr c, PhiloxKey k)
+{
+    for (int i = 0; i < 10; ++i)
+    {
+        c = philox_round(c, k);
+        if (i < 9)
+        {
+            k.x += PHILOX_W0;
+            k.y += PHILOX_W1;
+        }
+    }
+    return c;
+}
+
+// curand_init(random, idx, 0) + first curand_uniform: first output word of the counter
+// (0, 0, idx_lo, idx_hi) with key (seed_lo, seed_hi)
+inline float curand_uniform_first(uint32_t seed, uint32_t subseq)
+{
+    const PhiloxCtr c = { 0u, 0u, subseq, 0u };
+    const PhiloxKey k = { seed, 0u };
+    const PhiloxCtr out = philox4x32_10(c, k);
+    constexpr float CURAND_2POW32_INV = 2.3283064e-10f;
+    return out.x * CURAND_2POW32_INV + (CURAND_2POW32_INV / 2.0f);
+}
+
+inline float gumbel(float x)
+{
+    x = sycl::fmin(x, 0.99999994f);   // Largest float32 < 1.0
+    return -sycl::log(sycl::fmax(-sycl::log(sycl::fmax(x, 1e-20f)), 1e-20f));
+}
+
+// -------------------------------------------------------------------------------------------------
+// gumbel noise kernels: one work item per element
+// -------------------------------------------------------------------------------------------------
+
+template <typename T, bool LOG>
+class GumbelKernelName;
+
+template <typename T, bool LOG>
+void launch_gumbel(sycl::queue& q, const T* in, float* logits, size_t size, uint32_t random)
+{
+    q.parallel_for<GumbelKernelName<T, LOG>>(sycl::range<1>(size), [=](sycl::item<1> item)
+    {
+        const size_t idx = item.get_linear_id();
+        float x = (float) in[idx];
+        if constexpr (LOG) x = sycl::log(x);
+        const float u = curand_uniform_first(random, (uint32_t) (idx & 0xffffffffu));
+        logits[idx] = x + gumbel(u);
+    });
+}
+
+// fp16 output variant (SS_Sample's SS.INIT state adds gumbel noise in place on the half logits)
+template <bool LOG>
+class GumbelHKernelName;
+
+template <bool LOG>
+void launch_gumbel_h(sycl::queue& q, const sycl::half* in, sycl::half* logits, size_t size,
+                     uint32_t random)
+{
+    q.parallel_for<GumbelHKernelName<LOG>>(sycl::range<1>(size), [=](sycl::item<1> item)
+    {
+        const size_t idx = item.get_linear_id();
+        float x = (float) in[idx];
+        if constexpr (LOG) x = sycl::log(x);
+        const float u = curand_uniform_first(random, (uint32_t) (idx & 0xffffffffu));
+        logits[idx] = sycl::half(x + gumbel(u));
+    });
+}
+
+// -------------------------------------------------------------------------------------------------
+// packed bitmask: out[i] = in[i] if bit i of the row word is set else -inf (bit clear = masked out)
+// -------------------------------------------------------------------------------------------------
+
+template <typename T>
+class BitmaskKernelName;
+
+template <typename T>
+void launch_bitmask(sycl::queue& q, const T* in, T* out, const uint32_t* bits, int dim,
+                    bool bits_per_row, int bits_words, int bsz)
+{
+    const int nbits = bits_words * 32;
+    q.parallel_for<BitmaskKernelName<T>>(sycl::range<2>((size_t) bsz, (size_t) dim),
+        [=](sycl::item<2> item)
+    {
+        const int row = (int) item.get_id(0);
+        const int i = (int) item.get_id(1);
+        const uint32_t* row_bits = bits + (bits_per_row ? (size_t) row * bits_words : 0);
+        const bool keep = i < nbits && ((row_bits[i >> 5] >> (i & 31)) & 1u);
+        out[(size_t) row * dim + i] = keep ? in[(size_t) row * dim + i]
+                                           : (T) -std::numeric_limits<float>::infinity();
+    });
+}
+
+} // namespace
+
+// --- host entry points ----------------------------------------------------------------------------
+
+void sycl_gumbel_noise_f16(const at::Tensor& logits_in, at::Tensor& logits, uint32_t random)
+{
+    TORCH_CHECK(logits_in.scalar_type() == at::kHalf && logits.scalar_type() == at::kHalf,
+                "gumbel_noise_f16: half logits expected");
+    TORCH_CHECK(logits_in.sizes() == logits.sizes(), "gumbel_noise_f16: shape mismatch");
+    const size_t size = logits.numel();
+    if (!size) return;
+    sycl::queue& q = exl3_sycl_queue();
+    launch_gumbel_h<false>(q, (const sycl::half*) logits_in.data_ptr(),
+                           (sycl::half*) logits.data_ptr(), size, random);
+}
+
+void sycl_gumbel_noise_f32(const at::Tensor& logits_in, at::Tensor& logits, uint32_t random)
+{
+    TORCH_CHECK(logits_in.scalar_type() == at::kFloat && logits.scalar_type() == at::kFloat,
+                "gumbel_noise_f32: float logits expected");
+    TORCH_CHECK(logits_in.sizes() == logits.sizes(), "gumbel_noise_f32: shape mismatch");
+    const size_t size = logits.numel();
+    if (!size) return;
+    sycl::queue& q = exl3_sycl_queue();
+    launch_gumbel<float, false>(q, (const float*) logits_in.data_ptr(),
+                                (float*) logits.data_ptr(), size, random);
+}
+
+void sycl_gumbel_noise_log(const at::Tensor& probs, at::Tensor& logits, uint32_t random)
+{
+    TORCH_CHECK(probs.scalar_type() == at::kFloat && logits.scalar_type() == at::kFloat,
+                "gumbel_noise_log: float probs/logits expected");
+    TORCH_CHECK(probs.sizes() == logits.sizes(), "gumbel_noise_log: shape mismatch");
+    const size_t size = probs.numel();
+    if (!size) return;
+    sycl::queue& q = exl3_sycl_queue();
+    launch_gumbel<float, true>(q, (const float*) probs.data_ptr(),
+                               (float*) logits.data_ptr(), size, random);
+}
+
+void sycl_apply_logit_bitmask(const at::Tensor& logits_in, at::Tensor& logits_out,
+                              const at::Tensor& bitmask)
+{
+    TORCH_CHECK(logits_in.dim() == 2, "apply_logit_bitmask: logits must be 2D");
+    TORCH_CHECK(logits_in.is_contiguous() && logits_out.is_contiguous() && bitmask.is_contiguous(),
+                "apply_logit_bitmask: tensors must be contiguous");
+    TORCH_CHECK(logits_out.sizes() == logits_in.sizes() && logits_out.scalar_type() == logits_in.scalar_type(),
+                "apply_logit_bitmask: output shape/dtype mismatch");
+    TORCH_CHECK(bitmask.scalar_type() == at::kInt && bitmask.dim() == 2,
+                "apply_logit_bitmask: bitmask must be 2D int32");
+    TORCH_CHECK(bitmask.size(0) == 1 || bitmask.size(0) == logits_in.size(0),
+                "apply_logit_bitmask: bad bitmask batch dim");
+
+    const int bsz = (int) logits_in.size(0);
+    const int dim = (int) logits_in.size(1);
+    if (!bsz || !dim) return;
+
+    sycl::queue& q = exl3_sycl_queue();
+    const uint32_t* bits = (const uint32_t*) bitmask.data_ptr();
+    const int bits_words = (int) bitmask.size(1);
+    const bool bits_per_row = bitmask.size(0) == (size_t) bsz;
+
+    if (logits_in.scalar_type() == at::kHalf)
+        launch_bitmask<sycl::half>(q, (const sycl::half*) logits_in.data_ptr(),
+            (sycl::half*) logits_out.data_ptr(), bits, dim, bits_per_row, bits_words, bsz);
+    else if (logits_in.scalar_type() == at::kFloat)
+        launch_bitmask<float>(q, (const float*) logits_in.data_ptr(),
+            (float*) logits_out.data_ptr(), bits, dim, bits_per_row, bits_words, bsz);
+    else
+        TORCH_CHECK(false, "apply_logit_bitmask: logits must be half or float");
+}
diff --git a/exllamav3/exllamav3_ext/sycl/hadamard.cpp b/exllamav3/exllamav3_ext/sycl/hadamard.cpp
new file mode 100644
index 0000000..9f593c7
--- /dev/null
+++ b/exllamav3/exllamav3_ext/sycl/hadamard.cpp
@@ -0,0 +1,211 @@
+// had_r_128, port of quant/hadamard.cu + hadamard_inner.cuh into SYCL.
+//
+// For each 128-chunk of the last dim: y = ((x . pre_scale) . H / sqrt(128)) . post_scale, the
+// pre-scale applied before H and the post-scale after. One work-group of 128 items per chunk, the
+// butterfly running in fp32 through a small local buffer. The CUDA kernel converts to fp32 after
+// the (fp16) pre-scale and rounds once at the end; this port applies the pre/post scales in fp32,
+// which differs only in that rounding (noted in README.md).
+
+#include <sycl/sycl.hpp>
+#include <ATen/Tensor.h>
+
+#include "exl3_compat.h"
+
+namespace {
+
+constexpr float HAD_R_SCALE = 0.08838834764831845f;   // 1/sqrt(128)
+
+template <bool PRE, bool POST>
+class HadKernelName;
+
+template <bool PRE, bool POST>
+void launch_had(sycl::queue& q, const sycl::half* input, sycl::half* output,
+                const sycl::half* scale, float r_scale, int rows, int chunks, int stride = 0)
+{
+    const int row_stride = stride > 0 ? stride : chunks * 128;
+    // One work-group of 128 items per (row, 128-chunk); the butterfly is a local-memory buffer
+    q.submit([&](sycl::handler& cgh)
+    {
+        sycl::local_accessor<float, 1> buf(sycl::range<1>(128), cgh);
+        cgh.parallel_for<HadKernelName<PRE, POST>>(
+            sycl::nd_range<1>(sycl::range<1>((size_t) rows * chunks * 128), sycl::range<1>(128)),
+            [=](sycl::nd_item<1> it)
+        {
+            const int chunk = (int) (it.get_group_linear_id() % chunks);
+            const int row = (int) (it.get_group_linear_id() / chunks);
+            const int p = (int) it.get_local_id(0);
+            const size_t base = (size_t) row * row_stride + (size_t) chunk * 128;
+
+            float v = (float) input[base + p];
+            if constexpr (PRE)
+                v = v * (float) scale[chunk * 128 + p];
+            buf[p] = v;
+            sycl::group_barrier(it.get_group());
+
+            // 7-stage natural-order Sylvester butterfly over the 128 positions. Sign convention
+            // follows the CUDA shuffle_had: out[set-bit lane] = partner - self
+            for (int s = 0; s < 7; ++s)
+            {
+                float pv = buf[p ^ (1 << s)];
+                sycl::group_barrier(it.get_group());
+                buf[p] = (((p >> s) & 1) ? (pv - buf[p]) : (buf[p] + pv));
+                sycl::group_barrier(it.get_group());
+            }
+
+            float out = buf[p] * r_scale;
+            if constexpr (POST)
+                out = out * (float) scale[chunk * 128 + p];
+            output[base + p] = sycl::half(out);
+        });
+    });
+}
+
+} // namespace
+
+void sycl_had_r_128_h(const at::Tensor& input, const at::Tensor& output,
+                      const c10::optional<at::Tensor>& pre_scale,
+                      const c10::optional<at::Tensor>& post_scale, float scale)
+{
+    TORCH_CHECK(input.dim() == 2, "had_r_128: input must be 2D");
+    TORCH_CHECK(input.sizes() == output.sizes(), "had_r_128: input/output shape mismatch");
+    TORCH_CHECK(input.size(1) % 128 == 0, "had_r_128: last dim must be divisible by 128");
+    TORCH_CHECK(input.scalar_type() == at::kHalf && output.scalar_type() == at::kHalf,
+                "had_r_128: half in/out supported");
+
+    const int rows = (int) input.size(0);
+    const int chunks = (int) input.size(1) / 128;
+    const float r_scale = scale * HAD_R_SCALE;
+
+    if (!rows || !chunks) return;
+
+    sycl::queue& q = exl3_sycl_queue();
+    const sycl::half* in_p = (const sycl::half*) input.data_ptr();
+    sycl::half* out_p = (sycl::half*) output.data_ptr();
+    const sycl::half* scale_p = nullptr;
+    if (pre_scale.has_value()) scale_p = (const sycl::half*) pre_scale->data_ptr();
+    if (post_scale.has_value()) scale_p = (const sycl::half*) post_scale->data_ptr();
+
+    if (pre_scale.has_value())
+        launch_had<true, false>(q, in_p, out_p, scale_p, r_scale, rows, chunks);
+    else if (post_scale.has_value())
+        launch_had<false, true>(q, in_p, out_p, scale_p, r_scale, rows, chunks);
+    else
+        launch_had<false, false>(q, in_p, out_p, scale_p, r_scale, rows, chunks);
+}
+
+// fp32 in/out variant (used for the fp32-output GEMV decode path's output Hadamard)
+template <bool PRE, bool POST>
+class HadFFKernelName;
+
+template <bool PRE, bool POST>
+static void launch_had_ff(sycl::queue& q, const float* input, float* output,
+                          const sycl::half* scale, float r_scale, int rows, int chunks, int stride = 0)
+{
+    const int row_stride = stride > 0 ? stride : chunks * 128;
+    q.submit([&](sycl::handler& cgh)
+    {
+        sycl::local_accessor<float, 1> buf(sycl::range<1>(128), cgh);
+        cgh.parallel_for<HadFFKernelName<PRE, POST>>(
+            sycl::nd_range<1>(sycl::range<1>((size_t) rows * chunks * 128), sycl::range<1>(128)),
+            [=](sycl::nd_item<1> it)
+        {
+            const int chunk = (int) (it.get_group_linear_id() % chunks);
+            const int row = (int) (it.get_group_linear_id() / chunks);
+            const int p = (int) it.get_local_id(0);
+            const size_t base = (size_t) row * row_stride + (size_t) chunk * 128;
+
+            float v = input[base + p];
+            if constexpr (PRE)
+                v = v * (float) scale[chunk * 128 + p];
+            buf[p] = v;
+            sycl::group_barrier(it.get_group());
+
+            for (int s = 0; s < 7; ++s)
+            {
+                float pv = buf[p ^ (1 << s)];
+                sycl::group_barrier(it.get_group());
+                buf[p] = (((p >> s) & 1) ? (pv - buf[p]) : (buf[p] + pv));
+                sycl::group_barrier(it.get_group());
+            }
+
+            float out = buf[p] * r_scale;
+            if constexpr (POST)
+                out = out * (float) scale[chunk * 128 + p];
+            output[base + p] = out;
+        });
+    });
+}
+
+void sycl_had_r_128_f(const at::Tensor& input, const at::Tensor& output,
+                      const c10::optional<at::Tensor>& pre_scale,
+                      const c10::optional<at::Tensor>& post_scale, float scale)
+{
+    TORCH_CHECK(input.dim() == 2, "had_r_128: input must be 2D");
+    TORCH_CHECK(input.sizes() == output.sizes(), "had_r_128: input/output shape mismatch");
+    TORCH_CHECK(input.size(1) % 128 == 0, "had_r_128: last dim must be divisible by 128");
+    TORCH_CHECK(input.scalar_type() == at::kFloat && output.scalar_type() == at::kFloat,
+                "had_r_128: float in/out supported");
+
+    const int rows = (int) input.size(0);
+    const int chunks = (int) input.size(1) / 128;
+    const float r_scale = scale * HAD_R_SCALE;
+
+    if (!rows || !chunks) return;
+
+    sycl::queue& q = exl3_sycl_queue();
+    const float* in_p = (const float*) input.data_ptr();
+    float* out_p = (float*) output.data_ptr();
+    const sycl::half* scale_p = nullptr;
+    if (pre_scale.has_value()) scale_p = (const sycl::half*) pre_scale->data_ptr();
+    if (post_scale.has_value()) scale_p = (const sycl::half*) post_scale->data_ptr();
+
+    if (pre_scale.has_value())
+        launch_had_ff<true, false>(q, in_p, out_p, scale_p, r_scale, rows, chunks);
+    else if (post_scale.has_value())
+        launch_had_ff<false, true>(q, in_p, out_p, scale_p, r_scale, rows, chunks);
+    else
+        launch_had_ff<false, false>(q, in_p, out_p, scale_p, r_scale, rows, chunks);
+}
+
+// Raw-pointer entries for mgemm.cpp's pointer-table loop (pre and post are never both set in
+// the GEMV flow: one call pre-scales the input, the other post-scales the output)
+void sycl_had_h_raw(sycl::queue& q, const sycl::half* input, sycl::half* output,
+                    const sycl::half* pre_scale, const sycl::half* post_scale, float scale,
+                    int rows, int chunks, int stride = 0)
+{
+    const float r_scale = scale * HAD_R_SCALE;
+    if (!rows || !chunks) return;
+    if (pre_scale)
+        launch_had<true, false>(q, input, output, pre_scale, r_scale, rows, chunks, stride);
+    else if (post_scale)
+        launch_had<false, true>(q, input, output, post_scale, r_scale, rows, chunks, stride);
+    else
+        launch_had<false, false>(q, input, output, nullptr, r_scale, rows, chunks, stride);
+}
+
+void sycl_had_f_raw(sycl::queue& q, const float* input, float* output,
+                    const sycl::half* pre_scale, const sycl::half* post_scale, float scale,
+                    int rows, int chunks, int stride = 0)
+{
+    const float r_scale = scale * HAD_R_SCALE;
+    if (!rows || !chunks) return;
+    if (pre_scale)
+        launch_had_ff<true, false>(q, input, output, pre_scale, r_scale, rows, chunks, stride);
+    else if (post_scale)
+        launch_had_ff<false, true>(q, input, output, post_scale, r_scale, rows, chunks, stride);
+    else
+        launch_had_ff<false, false>(q, input, output, nullptr, r_scale, rows, chunks, stride);
+}
+
+// Dispatch on dtype, mirroring the CUDA had_r_128 surface
+void sycl_had_r_128(const at::Tensor& input, const at::Tensor& output,
+                    const c10::optional<at::Tensor>& pre_scale,
+                    const c10::optional<at::Tensor>& post_scale, float scale)
+{
+    if (input.scalar_type() == at::kHalf)
+        sycl_had_r_128_h(input, output, pre_scale, post_scale, scale);
+    else if (input.scalar_type() == at::kFloat)
+        sycl_had_r_128_f(input, output, pre_scale, post_scale, scale);
+    else
+        TORCH_CHECK(false, "had_r_128: unsupported datatype");
+}
diff --git a/exllamav3/exllamav3_ext/sycl/hgemm.cpp b/exllamav3/exllamav3_ext/sycl/hgemm.cpp
new file mode 100644
index 0000000..50ecfbe
--- /dev/null
+++ b/exllamav3/exllamav3_ext/sycl/hgemm.cpp
@@ -0,0 +1,197 @@
+// Plain fp16 GEMM via oneMKL, port of hgemm.cu's cuBLAS path.
+//
+// Row-major C = A @ B computed with the column-major trick: gemm(transpose::N, transpose::N,
+// m = n_cols, n = m_rows, k = k) over the column-major reinterpretations. oneMKL requires a/b/c
+// to share a dtype, so the fp32-output case runs the gemm into a half scratch and upcasts.
+
+#include <sycl/sycl.hpp>
+#include <oneapi/mkl/blas.hpp>
+#include <ATen/ATen.h>
+#include <ATen/Tensor.h>
+#include <algorithm>
+
+#include "exl3_compat.h"
+#include "sycl_kernels.h"
+
+namespace {
+
+// Upcast a contiguous half buffer into y, respecting y's row stride
+class UpcastKernelName;
+
+void upcast_rows(sycl::queue& q, const sycl::half* src, int src_stride, float* dst, int dst_stride,
+                 int width, int rows)
+{
+    q.parallel_for<UpcastKernelName>(sycl::range<2>((size_t) rows, (size_t) width),
+        [=](sycl::item<2> item)
+    {
+        const int r = (int) item.get_id(0);
+        const int c = (int) item.get_id(1);
+        dst[(size_t) r * dst_stride + c] = (float) src[(size_t) r * src_stride + c];
+    });
+}
+
+// ---------------------------------------------------------------- custom split-K dense GEMV (m == 1)
+// oneMKL's GEMV is latency-bound on this backend (~240 GB/s at best on the 4B's dense shapes,
+// measured on cold production-pattern buffers). This kernel: one work-group per (128-column tile,
+// k-chunk), lane = column, a coalesced 256-byte W read per k, disjoint fp32 partial slices in a
+// scratch buffer (no atomics, no memset), and a tiny reduce kernel summing the slices into C —
+// safe because the production queue is in-order (partial -> reduce and consecutive calls). The
+// chunk target is ~320 k-iterations (bench_dgemv.cpp, exact 4B shapes, cold round-robin:
+// k=9216 n=2560 1.39x over oneMKL at 249 vs 179 GB/s, k=2560 n=9216 ~1.05x at 254 vs 241).
+// m == 1 only (the callers gate on it); C's row-0 start is written, so C's row stride is irrelevant
+template <int KS> class DgemvSkK;
+template <int KS> class DgemvSkR;
+
+static float* dgemv_scratch(sycl::queue& q, size_t n)
+{
+    static float* buf = nullptr;
+    static size_t cap = 0;
+    if (n > cap)
+    {
+        // in-flight kernels may still read the old buffer: drain before freeing
+        if (buf) { q.wait(); sycl::free(buf, q); }
+        cap = n;
+        buf = sycl::malloc_device<float>(cap * 32, q);   // KS_MAX = 32 slices
+    }
+    return buf;
+}
+
+template <int KS>
+static void dense_gemv_ks(sycl::queue& q, const sycl::half* x, const sycl::half* W, int w_ld,
+                          void* C, int size_k, int size_n, bool out_fp32, float* scratch)
+{
+    const int ntiles = size_n / 128;
+    const int chunk = (size_k + KS - 1) / KS;
+
+    q.submit([&](sycl::handler& h)
+    {
+        h.parallel_for<DgemvSkK<KS>>(sycl::nd_range<1>(sycl::range<1>((size_t) ntiles * KS * 128),
+                                                       sycl::range<1>(128)),
+            [=](sycl::nd_item<1> it)
+        {
+            const int gid = (int) it.get_group_linear_id();
+            const int tile = gid / KS;
+            const int kc = gid % KS;
+            const int lane = (int) it.get_local_id(0);
+            const int col = tile * 128 + lane;
+            const int k0 = kc * chunk;
+            const int k1 = sycl::min(k0 + chunk, size_k);
+            float acc = 0.0f;
+            for (int k = k0; k < k1; ++k)
+                acc = fmaf((float) x[k], (float) W[(size_t) k * w_ld + col], acc);
+            scratch[(size_t) kc * size_n + col] = acc;
+        });
+    });
+    q.submit([&](sycl::handler& h)
+    {
+        h.parallel_for<DgemvSkR<KS>>(sycl::range<1>((size_t) size_n), [=](sycl::item<1> item)
+        {
+            const int i = (int) item.get_linear_id();
+            float s = 0.0f;
+            #pragma unroll
+            for (int c = 0; c < KS; ++c) s += scratch[(size_t) c * size_n + i];
+            if (out_fp32) ((float*) C)[i] = s;
+            else          ((sycl::half*) C)[i] = sycl::half(s);
+        });
+    });
+}
+
+void hgemm_impl(at::Tensor a, at::Tensor b, at::Tensor c)
+{
+    TORCH_CHECK(a.scalar_type() == at::kHalf && b.scalar_type() == at::kHalf,
+                "hgemm: a and b must be float16");
+    TORCH_CHECK(b.dim() == 2, "hgemm: b must be 2D");
+    TORCH_CHECK(c.dim() >= 2, "hgemm: c must have at least 2 dimensions");
+    TORCH_CHECK(a.size(-1) == b.size(0), "hgemm: a's last dim must match b's first dim");
+    TORCH_CHECK(b.size(1) == c.size(-1), "hgemm: b's last dim must match c's last dim");
+    TORCH_CHECK(c.stride(-1) == 1, "hgemm: c must have contiguous columns");
+
+    const bool output_fp32 = c.scalar_type() == at::kFloat;
+    TORCH_CHECK(output_fp32 || c.scalar_type() == at::kHalf, "hgemm: c must be float32 or float16");
+
+    const int size_k = (int) a.size(-1);
+    int64_t size_m_ = 1;
+    for (int d = 0; d < a.dim() - 1; ++d) size_m_ *= a.size(d);
+    const int size_m = (int) size_m_;
+    const int size_n = (int) b.size(1);
+    const int64_t c_stride_m = c.stride(-2);
+    TORCH_CHECK(c_stride_m >= size_n, "hgemm: c row stride is too small");
+
+    // No rows or no output columns: nothing to compute. Empty reduction (k = 0): the product is zero
+    if (!size_m || !size_n) return;
+    if (!size_k)
+    {
+        c.zero_();
+        return;
+    }
+
+    sycl::queue& q = exl3_sycl_queue();
+
+    const sycl::half* a_ptr = (const sycl::half*) a.data_ptr();
+    const sycl::half* b_ptr = (const sycl::half*) b.data_ptr();
+
+    // m == 1 decode: the custom split-K dense GEMV, but ONLY for long-k shapes — measured on
+    // cold production-pattern buffers (bench_dgemv.cpp), it beats oneMKL 1.39x on the down_proj
+    // shape (k=9216 n=2560) but its 128-column-tile layout runs out of parallelism on small-n
+    // shapes (n=1024 -> 8 tiles x KS groups), where it measured much slower than oneMKL and
+    // regressed the 4B end to end. oneMKL is at ~240 GB/s on those — keep it there
+    if (size_m == 1 && size_n % 128 == 0 && size_k >= 6144)
+    {
+        void* c0 = (void*) ((char*) c.data_ptr());
+        sycl_dense_gemv_raw(q, a_ptr, b_ptr, size_n, c0, size_k, size_n, output_fp32);
+        return;
+    }
+
+    // C^T = B^T . A^T via the column-major reinterpretation, matching the cuBLAS call:
+    // C_cm (n x m) = B_cm (n x k) @ A_cm (k x m), all leading dims as in the row-major layouts
+    const oneapi::mkl::transpose N = oneapi::mkl::transpose::N;
+    const float alpha = 1.0f;
+    const float beta = 0.0f;
+
+    if (output_fp32)
+    {
+        at::Tensor scratch = at::empty({size_m, size_n}, a.options().dtype(at::kHalf));
+        SYCL_CHECK(oneapi::mkl::blas::column_major::gemm(
+            q, N, N,
+            size_n, size_m, size_k,
+            alpha, b_ptr, size_n,
+                   a_ptr, size_k,
+            beta,  (sycl::half*) scratch.data_ptr(), size_n));
+        upcast_rows(q, (const sycl::half*) scratch.data_ptr(), size_n,
+                    (float*) c.data_ptr(), (int) c_stride_m, size_n, size_m);
+    }
+    else
+    {
+        SYCL_CHECK(oneapi::mkl::blas::column_major::gemm(
+            q, N, N,
+            size_n, size_m, size_k,
+            alpha, b_ptr, size_n,
+                   a_ptr, size_k,
+            beta,  (sycl::half*) c.data_ptr(), (int) c_stride_m));
+    }
+}
+
+} // namespace
+
+void sycl_dense_gemv_raw(sycl::queue& q, const sycl::half* x, const sycl::half* W, int w_ld,
+                         void* C, int size_k, int size_n, bool out_fp32)
+{
+    int ks = (size_k + 160) / 320;
+    ks = std::max(1, std::min(32, ks));
+    float* scratch = dgemv_scratch(q, (size_t) size_n);
+    if      (ks <= 4)  dense_gemv_ks<4>(q, x, W, w_ld, C, size_k, size_n, out_fp32, scratch);
+    else if (ks <= 8)  dense_gemv_ks<8>(q, x, W, w_ld, C, size_k, size_n, out_fp32, scratch);
+    else if (ks <= 16) dense_gemv_ks<16>(q, x, W, w_ld, C, size_k, size_n, out_fp32, scratch);
+    else               dense_gemv_ks<32>(q, x, W, w_ld, C, size_k, size_n, out_fp32, scratch);
+}
+
+void sycl_hgemm(at::Tensor a, at::Tensor b, at::Tensor c)
+{
+    hgemm_impl(a, b, c);
+}
+
+// Reconstruct-path GEMM (same call on SYCL)
+void sycl_hgemm_recon(at::Tensor a, at::Tensor b, at::Tensor c)
+{
+    hgemm_impl(a, b, c);
+}
diff --git a/exllamav3/exllamav3_ext/sycl/mgemm.cpp b/exllamav3/exllamav3_ext/sycl/mgemm.cpp
new file mode 100644
index 0000000..cb303ad
--- /dev/null
+++ b/exllamav3/exllamav3_ext/sycl/mgemm.cpp
@@ -0,0 +1,334 @@
+// Multi-linear GEMM (exl3_mgemm), SYCL port of the fused mgemm path.
+//
+// The CUDA kernel reads per-tensor trellis/scale addresses from a device pointer table and
+// computes every tensor's output in one fused kernel. On SYCL this becomes a loop over the
+// table: for each tensor, the raw-pointer GEMV flow (input Hadamard -> GEMV -> output
+// Hadamard) writes its slice of C / A_had. The indices/weights (MoE) variant is not supported
+// and refuses on the host; the sliced mode (equal-width column slices of fewer source
+// matrices, used by the qkv projection path) runs one input Hadamard per source and a
+// strided GEMV + output Hadamard per slice into the caller's output pointers.
+
+#include <sycl/sycl.hpp>
+#include <oneapi/mkl/blas.hpp>
+#include <ATen/Tensor.h>
+
+#include <mutex>
+#include <unordered_map>
+
+#include "exl3_compat.h"
+#include "exl3_decode.h"
+#include "sycl_kernels.h"
+
+// Host copies of the device pointer tables (trellis/suh/svh and the sliced-mode int lists). The
+// tables are written once at model load and never change, so the D2H copy (a blocking
+// wait_and_throw that drains the whole in-order queue) happens once per table, not once per call.
+// Keyed by the table tensor's data_ptr and length: the address identifies the load-time
+// allocation, and a different length cannot share an allocation.
+namespace {
+
+struct PtrTableCache
+{
+    std::mutex mu;
+    std::unordered_map<uintptr_t, std::vector<uint64_t>> u64;
+    std::unordered_map<uintptr_t, std::vector<int>> i32;
+};
+
+PtrTableCache& ptr_table_cache()
+{
+    static PtrTableCache c;
+    return c;
+}
+
+} // namespace
+
+void exl3_sycl_ptr_cache_clear()
+{
+    // Drop every cached host copy of a device pointer table. The entries are keyed by the
+    // table tensor's allocation address, which the caching allocator recycles across model
+    // loads: a table of the new model can land on an address a table of the unloaded model
+    // used with the same length, and the stale copy would silently feed the old model's
+    // pointers (freed or reused memory) into the kernel. Called when a model is unloaded or
+    // before a new one loads
+    PtrTableCache& c = ptr_table_cache();
+    std::lock_guard<std::mutex> g(c.mu);
+    c.u64.clear();
+    c.i32.clear();
+}
+
+void sycl_exl3_mgemm(const at::Tensor& A, const at::Tensor& B, at::Tensor& C,
+                     const at::Tensor& suh, const at::Tensor& A_had, const at::Tensor& svh,
+                     const c10::optional<at::Tensor>& indices,
+                     const c10::optional<at::Tensor>& weights,
+                     float K, int64_t force_shape_idx, bool mcg, bool mul1,
+                     int64_t min_index, int64_t max_index, int64_t force_num_sms,
+                     int64_t num_tokens,
+                     const c10::optional<at::Tensor>& size_n_list,
+                     const c10::optional<at::Tensor>& c_ptrs,
+                     const c10::optional<at::Tensor>& n_stride_list,
+                     const c10::optional<at::Tensor>& had_src_list,
+                     int64_t num_had_src, bool dense)
+{
+    sycl_exl3_mgemm_impl(A, B, C, suh, A_had, svh, indices, weights, K, force_shape_idx, mcg, mul1,
+                         min_index, max_index, force_num_sms, num_tokens, size_n_list, c_ptrs,
+                         n_stride_list, had_src_list, num_had_src, dense);
+}
+
+void sycl_exl3_mgemm_impl(const at::Tensor& A, const at::Tensor& B, at::Tensor& C,
+                      const at::Tensor& suh, const at::Tensor& A_had, const at::Tensor& svh,
+                      const c10::optional<at::Tensor>& indices,
+                      const c10::optional<at::Tensor>& weights,
+                      float K, int64_t force_shape_idx, bool mcg, bool mul1,
+                      int64_t min_index, int64_t max_index, int64_t force_num_sms,
+                      int64_t num_tokens,
+                      const c10::optional<at::Tensor>& size_n_list,
+                      const c10::optional<at::Tensor>& c_ptrs,
+                      const c10::optional<at::Tensor>& n_stride_list,
+                      const c10::optional<at::Tensor>& had_src_list,
+                      int64_t num_had_src, bool dense)
+{
+    (void) force_shape_idx;
+    (void) force_num_sms;
+    (void) num_tokens;
+    TORCH_CHECK(!indices.has_value() && !weights.has_value(),
+                "exl3_mgemm (SYCL): the indices/weights (MoE) variant is not supported");
+    TORCH_CHECK(min_index < 0 && max_index < 0,
+                "exl3_mgemm (SYCL): min_index/max_index require the MoE variant");
+
+    const bool sliced = had_src_list.has_value();
+    TORCH_CHECK(sliced == size_n_list.has_value() && sliced == c_ptrs.has_value() &&
+                sliced == n_stride_list.has_value(),
+                "exl3_mgemm: size_n_list/c_ptrs/n_stride_list require had_src_list and vice versa");
+
+    // B/suh/svh are device pointer tables (int64 tensor of raw data_ptr()s, two's-complement
+    // for XPU pointers above 2^63; the bit pattern is preserved by the uint64 reads below)
+    TORCH_CHECK(B.dim() == 1 && B.scalar_type() == at::kLong, "exl3_mgemm: B must be a 1D pointer table");
+    TORCH_CHECK(suh.dim() == 1 && suh.scalar_type() == at::kLong, "exl3_mgemm: suh must be a 1D pointer table");
+    TORCH_CHECK(svh.dim() == 1 && svh.scalar_type() == at::kLong, "exl3_mgemm: svh must be a 1D pointer table");
+    TORCH_CHECK(B.size(0) == svh.size(0), "exl3_mgemm: table length mismatch");
+    TORCH_CHECK(sliced ? suh.size(0) >= num_had_src : suh.size(0) == B.size(0),
+                "exl3_mgemm: suh table length mismatch");
+
+    const int64_t num_tensors = B.size(0);
+    TORCH_CHECK(C.dim() == 3 && C.size(0) == num_tensors, "exl3_mgemm: C must be [num_tensors, m, n]");
+    TORCH_CHECK(A.scalar_type() == at::kHalf, "exl3_mgemm: A must be float16");
+
+    const int size_k = (int) A.size(-1);
+    const int size_n = (int) C.size(-1);
+    int size_m = 1;
+    for (int d = 1; d < A.dim() - 1; ++d) size_m *= (int) A.size(d);
+    TORCH_CHECK(size_m == (int) C.size(1), "exl3_mgemm: m mismatch between A and C");
+    TORCH_CHECK(size_k == (int) A_had.size(-1), "exl3_mgemm: k mismatch between A and A_had");
+    TORCH_CHECK(size_k % 128 == 0, "exl3_mgemm: k must be divisible by 128");
+    if (sliced)
+    {
+        TORCH_CHECK(A.dim() == 3 && A.size(0) == 1, "exl3_mgemm: sliced mode is single-input");
+        TORCH_CHECK(num_had_src > 0 && A_had.size(0) >= num_had_src,
+                    "exl3_mgemm: sliced mode needs one A_had slab per source");
+        TORCH_CHECK(size_n % 128 == 0, "exl3_mgemm: slice width must be divisible by 128");
+    }
+    else
+    {
+        TORCH_CHECK(A_had.dim() == 3 && A_had.size(0) == num_tensors,
+                    "exl3_mgemm: A_had must be [num_tensors, m, k]");
+        TORCH_CHECK(size_n % 128 == 0, "exl3_mgemm: dims must be divisible by 128");
+    }
+
+    const BitsK bk = bits_from_K(K);
+    TORCH_CHECK(!bk.half || mul1, "exl3_mgemm: half-integer bitrates require the mul1 codebook");
+
+    int cb = 0;
+    if (mcg) cb = 1;
+    if (mul1) cb = 2;
+
+    if (!num_tensors || !size_m || !size_n || !size_k) return;
+
+    // Read the pointer tables to the host. They are written once at model load and never change,
+    // so each table is copied (a blocking D2H wait that drains the queue) only on first use and
+    // served from the static cache afterwards
+    sycl::queue& q = exl3_sycl_queue();
+    auto copy_ptrs = [&](const at::Tensor& t) -> const std::vector<uint64_t>&
+    {
+        const uintptr_t key = (uintptr_t) t.data_ptr();
+        PtrTableCache& c = ptr_table_cache();
+        std::lock_guard<std::mutex> g(c.mu);
+        auto it = c.u64.find(key);
+        if (it == c.u64.end() || it->second.size() != (size_t) t.size(0))
+        {
+            std::vector<uint64_t> host((size_t) t.size(0));
+            q.memcpy(host.data(), t.data_ptr(), t.size(0) * sizeof(uint64_t)).wait_and_throw();
+            return c.u64[key] = std::move(host);
+        }
+        return it->second;
+    };
+    auto copy_ints = [&](const at::Tensor& t) -> const std::vector<int>&
+    {
+        const uintptr_t key = (uintptr_t) t.data_ptr();
+        PtrTableCache& c = ptr_table_cache();
+        std::lock_guard<std::mutex> g(c.mu);
+        auto it = c.i32.find(key);
+        if (it == c.i32.end() || it->second.size() != (size_t) t.numel())
+        {
+            std::vector<int> host((size_t) t.numel());
+            q.memcpy(host.data(), t.data_ptr(), t.numel() * sizeof(int)).wait_and_throw();
+            return c.i32[key] = std::move(host);
+        }
+        return it->second;
+    };
+    const std::vector<uint64_t>& trellis_ptrs = copy_ptrs(B);
+    const std::vector<uint64_t>& suh_ptrs = copy_ptrs(suh);
+    const std::vector<uint64_t>& svh_ptrs = copy_ptrs(svh);
+
+    const sycl::half* A_ptr = (const sycl::half*) A.data_ptr();
+    const int m_stride = size_m * size_n;
+    const int k_stride = size_m * size_k;
+    const bool c_fp32 = C.scalar_type() == at::kFloat;
+    if (!c_fp32) TORCH_CHECK(C.scalar_type() == at::kHalf, "exl3_mgemm: C must be float16 or float32");
+
+    // Dense mode: the pointer tables hold dense fp16 weights ([k, n] row-major per source,
+    // pre-dequantized from the trellis at load) instead of packed trellis. The decode GEMV
+    // kernel is compute/latency-bound on this backend (~1.1 ms per 2048x2048), while oneMKL
+    // runs the same GEMM in ~0.05 ms, so the flow matches the packed GEMV's: input Hadamard
+    // per source (pre = suh) -> oneMKL gemm per tensor/slice -> output Hadamard in place
+    // (post = svh). The dense weights are the rotated-basis (raw) V, so both-side Hadamards
+    // yield the same result the packed path computes.
+    if (dense)
+    {
+        const oneapi::mkl::transpose N = oneapi::mkl::transpose::N;
+        const float alpha = 1.0f;
+        const float beta = 0.0f;
+        // fp32 out is only served by the non-sliced branch (hadamard in fp32, as the packed
+        // path does); the sliced fp32-out bundle stays on the packed path (gated at the call site)
+        TORCH_CHECK(!dense || !c_fp32 || !sliced, "exl3_mgemm: dense sliced mode requires fp16 output");
+
+        if (sliced)
+        {
+            const std::vector<uint64_t>& out_ptrs = copy_ptrs(*c_ptrs);
+            const std::vector<int>& n_list = copy_ints(*size_n_list);
+            const std::vector<int>& stride_list = copy_ints(*n_stride_list);
+            const std::vector<int>& src_list = copy_ints(*had_src_list);
+            TORCH_CHECK(n_list.size() >= (size_t) num_tensors && stride_list.size() >= (size_t) num_tensors &&
+                        src_list.size() >= (size_t) num_tensors && out_ptrs.size() >= (size_t) num_tensors,
+                        "exl3_mgemm: sliced mode needs one entry per slice");
+
+            for (int64_t s = 0; s < num_had_src; ++s)
+            {
+                TORCH_CHECK(src_list.size() > 0, "exl3_mgemm: empty sliced dispatch");
+                sycl_had_h_raw(q, A_ptr, (sycl::half*) A_had.data_ptr() + (size_t) s * k_stride,
+                               (const sycl::half*) (uintptr_t) suh_ptrs[s], nullptr, 1.0f,
+                               size_m, size_k / 128);
+            }
+            for (int64_t j = 0; j < num_tensors; ++j)
+            {
+                const int src = src_list[j];
+                const int n_j = n_list[j];
+                const int stride_j = stride_list[j];
+                TORCH_CHECK(src >= 0 && src < num_had_src, "exl3_mgemm: had_src_list out of range");
+                TORCH_CHECK(n_j > 0 && n_j % 128 == 0 && stride_j >= n_j,
+                            "exl3_mgemm: invalid slice width/stride");
+                // C = A_had_src @ W_j. The dense W slice is a strided submatrix of the source's
+                // [in, out] tensor, so its row stride is the source's full width. The custom
+                // dense GEMV only for long-k shapes (see hgemm.cpp: it runs out of parallelism
+                // on small-n shapes and regressed end-to-end there)
+                if (size_m == 1 && size_k >= 6144)
+                    sycl_dense_gemv_raw(q, (const sycl::half*) A_had.data_ptr() + (size_t) src * k_stride,
+                                        (const sycl::half*) (uintptr_t) trellis_ptrs[j], stride_j,
+                                        (sycl::half*) (uintptr_t) out_ptrs[j], size_k, n_j, false);
+                else
+                    SYCL_CHECK(oneapi::mkl::blas::column_major::gemm(
+                        q, N, N,
+                        n_j, size_m, size_k,
+                        alpha, (const sycl::half*) (uintptr_t) trellis_ptrs[j], stride_j,
+                               (const sycl::half*) A_had.data_ptr() + (size_t) src * k_stride, size_k,
+                        beta,  (sycl::half*) (uintptr_t) out_ptrs[j], stride_j));
+                // Output Hadamard in place on the slice (post = svh at the slice's column offset)
+                sycl_had_h_raw(q, (sycl::half*) (uintptr_t) out_ptrs[j],
+                               (sycl::half*) (uintptr_t) out_ptrs[j], nullptr,
+                               (const sycl::half*) (uintptr_t) svh_ptrs[j], 1.0f,
+                               size_m, n_j / 128, stride_j);
+            }
+            return;
+        }
+
+        for (int64_t i = 0; i < num_tensors; ++i)
+        {
+            // Input Hadamard into this tensor's A_had slab (pre = suh_i)
+            sycl_had_h_raw(q, A_ptr, (sycl::half*) A_had.data_ptr() + (size_t) i * k_stride,
+                           (const sycl::half*) (uintptr_t) suh_ptrs[i], nullptr, 1.0f,
+                           size_m, size_k / 128);
+            void* c_i = (void*) ((char*) C.data_ptr() + (size_t) i * m_stride * (c_fp32 ? 4 : 2));
+            if (size_m == 1 && size_k >= 6144)
+                sycl_dense_gemv_raw(q, (const sycl::half*) A_had.data_ptr() + (size_t) i * k_stride,
+                                    (const sycl::half*) (uintptr_t) trellis_ptrs[i], size_n,
+                                    c_i, size_k, size_n, c_fp32);
+            else
+                SYCL_CHECK(oneapi::mkl::blas::column_major::gemm(
+                    q, N, N,
+                    size_n, size_m, size_k,
+                    alpha, (const sycl::half*) (uintptr_t) trellis_ptrs[i], size_n,
+                           (const sycl::half*) A_had.data_ptr() + (size_t) i * k_stride, size_k,
+                    beta,  (sycl::half*) c_i, size_n));
+            // Output Hadamard in place on C_i (post = svh_i)
+            if (c_fp32)
+                sycl_had_f_raw(q, (float*) c_i, (float*) c_i, nullptr,
+                               (const sycl::half*) (uintptr_t) svh_ptrs[i], 1.0f,
+                               size_m, size_n / 128);
+            else
+                sycl_had_h_raw(q, (sycl::half*) c_i, (sycl::half*) c_i, nullptr,
+                               (const sycl::half*) (uintptr_t) svh_ptrs[i], 1.0f,
+                               size_m, size_n / 128);
+        }
+        return;
+    }
+
+    if (sliced)
+    {
+        const std::vector<uint64_t>& out_ptrs = copy_ptrs(*c_ptrs);
+        const std::vector<int>& n_list = copy_ints(*size_n_list);
+        const std::vector<int>& stride_list = copy_ints(*n_stride_list);
+        const std::vector<int>& src_list = copy_ints(*had_src_list);
+        TORCH_CHECK(n_list.size() >= (size_t) num_tensors && stride_list.size() >= (size_t) num_tensors &&
+                    src_list.size() >= (size_t) num_tensors && out_ptrs.size() >= (size_t) num_tensors,
+                    "exl3_mgemm: sliced mode needs one entry per slice");
+
+        // Input Hadamard, once per source, into its A_had slab (suh is per source here)
+        for (int64_t s = 0; s < num_had_src; ++s)
+        {
+            TORCH_CHECK(src_list.size() > 0, "exl3_mgemm: empty sliced dispatch");
+            sycl_had_h_raw(q, A_ptr, (sycl::half*) A_had.data_ptr() + (size_t) s * k_stride,
+                           (const sycl::half*) (uintptr_t) suh_ptrs[s], nullptr, 1.0f,
+                           size_m, size_k / 128);
+        }
+
+        // Per slice: strided GEMV into the caller's output pointer, then the output Hadamard
+        for (int64_t j = 0; j < num_tensors; ++j)
+        {
+            const int src = src_list[j];
+            const int n_j = n_list[j];
+            const int stride_j = stride_list[j];
+            TORCH_CHECK(src >= 0 && src < num_had_src, "exl3_mgemm: had_src_list out of range");
+            TORCH_CHECK(n_j > 0 && n_j % 128 == 0 && stride_j >= n_j,
+                        "exl3_mgemm: invalid slice width/stride");
+            sycl_exl3_gemm_raw2(q,
+                (const sycl::half*) A_had.data_ptr() + (size_t) src * k_stride,
+                (const uint16_t*) (uintptr_t) trellis_ptrs[j],
+                (void*) (uintptr_t) out_ptrs[j],
+                (const sycl::half*) (uintptr_t) svh_ptrs[j],
+                size_m, size_k, n_j, stride_j, c_fp32,
+                bk.bits, cb, bk.half);
+        }
+        return;
+    }
+
+    for (int64_t i = 0; i < num_tensors; ++i)
+    {
+        sycl_exl3_gemm_raw(q,
+            A_ptr,
+            (sycl::half*) A_had.data_ptr() + (size_t) i * k_stride,
+            (const uint16_t*) (uintptr_t) trellis_ptrs[i],
+            (char*) C.data_ptr() + (size_t) i * m_stride * (c_fp32 ? 4 : 2),
+            (const sycl::half*) (uintptr_t) suh_ptrs[i],
+            (const sycl::half*) (uintptr_t) svh_ptrs[i],
+            size_m, size_k, size_n, c_fp32,
+            bk.bits, cb, bk.half);
+    }
+}
diff --git a/exllamav3/exllamav3_ext/sycl/reconstruct.cpp b/exllamav3/exllamav3_ext/sycl/reconstruct.cpp
new file mode 100644
index 0000000..4418c78
--- /dev/null
+++ b/exllamav3/exllamav3_ext/sycl/reconstruct.cpp
@@ -0,0 +1,363 @@
+// EXL3 reconstruct kernels, port of quant/reconstruct.cu into SYCL.
+//
+// reconstruct / reconstruct_slice: one work-group per (16-row k-block x 128-col n group), 256
+// work items. Each item decodes the 8 weights of one subtile (warp_id -> subtile, lane*8 -> t)
+// and scatters them directly into the row-major unpacked output with the verified position
+// mapping (no shuffles or fragment layout needed).
+//
+// reconstruct_had_slice: one work-group per 128x128 tile, 256 items. The tile is decoded into a
+// local half[128][128] (32 KB), then two 7-stage natural-order Sylvester butterflies (columns
+// then rows, each folding a /sqrt(128)) produce W = diag(suh) . H V H /128 . diag(svh), the
+// original-basis weights. The butterfly arithmetic runs in fp32 with fp16 storage between
+// stages, which rounds slightly differently from the CUDA shuffle version (noted in README.md).
+
+#include <sycl/sycl.hpp>
+#include <ATen/Tensor.h>
+
+#include "exl3_compat.h"
+#include "exl3_decode.h"
+
+namespace {
+
+constexpr float RH_R_SCALE = 0.08838834764831845f;   // 1/sqrt(128)
+
+// --- plain reconstruct: 256 items per (16-row k block x 128-col n group) --------------------------
+
+template <int K, int cb, bool HALF>
+class ReconstructKernelName;
+
+template <int K, int cb, bool HALF>
+void launch_reconstruct(sycl::queue& q, sycl::half* unpacked, const uint16_t* packed,
+                        int packed_blocks_n, int packed_n_offset, int N,
+                        int n_groups, int k_blocks)
+{
+    constexpr int packed_size = 16 * K + (HALF ? 8 : 0);
+    constexpr int words = tile_words(K, HALF);
+    sycl::range<2> global((size_t) n_groups * 256, (size_t) k_blocks);
+    sycl::range<2> local(256, 1);
+    q.parallel_for<ReconstructKernelName<K, cb, HALF>>(sycl::nd_range<2>(global, local),
+        [=](sycl::nd_item<2> it)
+    {
+        const int nb = (int) it.get_group(0);      // 128-wide n group
+        const int kb = (int) it.get_group(1);      // 16-row k block
+        const int tid = (int) it.get_local_id(0);
+        const int w = tid / 32;                    // subtile index 0..7 within the group
+        const int lane = tid % 32;
+        const int n_sub = nb * 8 + w;              // absolute subtile index along n
+
+        const uint16_t* tile = packed + (size_t) (kb * packed_blocks_n + packed_n_offset + n_sub) * packed_size;
+        PackedPtrU16 ptr{ tile, words };
+
+        sycl::half vals[8];
+        if constexpr (HALF)
+            dq8_half<K, cb>(ptr, lane * 8, vals);
+        else
+            dq8<K, cb>(ptr, lane * 8, vals);
+
+        const int n_base = nb * 128 + w * 16;
+        for (int j = 0; j < 8; ++j)
+        {
+            int R, C;
+            weight_t_to_rc(lane * 8 + j, &R, &C);
+            unpacked[(size_t) (kb * 16 + R) * N + n_base + C] = vals[j];
+        }
+    });
+}
+
+// --- fused reconstruct + both-side Hadamard: 256 items per 128x128 tile ---------------------------
+
+template <int K, int cb, bool HALF>
+class ReconstructHadKernelName;
+
+// One in-place 7-stage natural-order Sylvester butterfly stage along `axis` of the 128x128 local
+// tile (axis 0 = row index / k, 1 = column index / n); `scale` is folded into the last stage
+template <typename TILE>
+inline void had_stage(TILE& tile, int axis, int s, float scale,
+                      sycl::nd_item<2> it, int tid)
+{
+    const bool last = (s == 6);
+    const int b = 1 << s;
+    // Pairs (a, a + b) with bit s of `a` clear: 128 lines x 64 pairs per stage
+    for (int idx = tid; idx < 128 * 64; idx += 256)
+    {
+        int line = idx >> 6;           // the non-transformed coordinate
+        int pp = idx & 63;             // pair index within the line
+        int a = ((pp >> s) << (s + 1)) | (pp & (b - 1));
+        int c2 = a | b;
+        float va, vb;
+        if (axis == 0)
+        {
+            va = (float) tile[a][line];
+            vb = (float) tile[c2][line];
+        }
+        else
+        {
+            va = (float) tile[line][a];
+            vb = (float) tile[line][c2];
+        }
+        if (last)
+        {
+            if (axis == 0)
+            {
+                tile[a][line]  = sycl::half((va + vb) * scale);
+                tile[c2][line] = sycl::half((va - vb) * scale);
+            }
+            else
+            {
+                tile[line][a]  = sycl::half((va + vb) * scale);
+                tile[line][c2] = sycl::half((va - vb) * scale);
+            }
+        }
+        else
+        {
+            if (axis == 0)
+            {
+                tile[a][line]  = sycl::half(va + vb);
+                tile[c2][line] = sycl::half(va - vb);
+            }
+            else
+            {
+                tile[line][a]  = sycl::half(va + vb);
+                tile[line][c2] = sycl::half(va - vb);
+            }
+        }
+    }
+}
+
+template <int K, int cb, bool HALF>
+void launch_reconstruct_had(sycl::queue& q, sycl::half* unpacked, const uint16_t* packed,
+                            const sycl::half* suh, const sycl::half* svh,
+                            int packed_blocks_n, int packed_n_offset, int N,
+                            int n_groups, int k_groups)
+{
+    constexpr int packed_size = 16 * K + (HALF ? 8 : 0);
+    constexpr int words = tile_words(K, HALF);
+    sycl::range<2> global((size_t) n_groups * 256, (size_t) k_groups);
+    sycl::range<2> local(256, 1);
+    q.submit([&](sycl::handler& cgh)
+    {
+        sycl::local_accessor<uint32_t, 1> s_packed(sycl::range<1>(64 * words), cgh);
+        sycl::local_accessor<sycl::half, 2> tile(sycl::range<2>(128, 128), cgh);
+        cgh.parallel_for<ReconstructHadKernelName<K, cb, HALF>>(
+            sycl::nd_range<2>(global, local),
+            [=](sycl::nd_item<2> it)
+        {
+            const int nb = (int) it.get_group(0);
+            const int kb = (int) it.get_group(1);
+            const int tid = (int) it.get_local_id(0);
+            const int w = tid / 32;
+            const int lane = tid % 32;
+
+            // Stage the packed words: subtile (u, w) of the tile is packed block (kb*8 + u,
+            // packed_n_offset + nb*8 + w)
+            for (int idx = tid; idx < 64 * words; idx += 256)
+            {
+                int sub = idx / words;
+                int wi = idx % words;
+                int u = sub / 8, wv = sub % 8;
+                const uint16_t* t16 = packed +
+                    (size_t) ((kb * 8 + u) * packed_blocks_n + packed_n_offset + nb * 8 + wv) * packed_size;
+                s_packed[idx] = (uint32_t) t16[2 * wi] | ((uint32_t) t16[2 * wi + 1] << 16);
+            }
+            sycl::group_barrier(it.get_group());
+
+            // Decode: each item decodes the 8 weights of subtile (u, w) at t = lane*8 + 0..7, for
+            // u = 0..7, scattering with the verified mapping into the local tile
+            for (int u = 0; u < 8; ++u)
+            {
+                PackedPtrLocal<sycl::local_accessor<uint32_t, 1>> ptr{ s_packed, (u * 8 + w) * words, words };
+                sycl::half vals[8];
+                if constexpr (HALF)
+                    dq8_half<K, cb>(ptr, lane * 8, vals);
+                else
+                    dq8<K, cb>(ptr, lane * 8, vals);
+                for (int j = 0; j < 8; ++j)
+                {
+                    int R, C;
+                    weight_t_to_rc(lane * 8 + j, &R, &C);
+                    tile[u * 16 + R][w * 16 + C] = vals[j];
+                }
+            }
+            sycl::group_barrier(it.get_group());
+
+            // Column transform (along n), then row transform (along k), each with a folded /sqrt(128).
+            // H is symmetric, so the order is immaterial in exact arithmetic
+            for (int s = 0; s < 7; ++s)
+            {
+                had_stage(tile, 1, s, RH_R_SCALE, it, tid);
+                sycl::group_barrier(it.get_group());
+            }
+            for (int s = 0; s < 7; ++s)
+            {
+                had_stage(tile, 0, s, RH_R_SCALE, it, tid);
+                sycl::group_barrier(it.get_group());
+            }
+
+            // Scale by the sign/scale vectors and store rows coalesced
+            for (int idx = tid; idx < 128 * 128; idx += 256)
+            {
+                int r = idx / 128;
+                int c = idx % 128;
+                sycl::half v = hmul(tile[r][c], suh[kb * 128 + r]);
+                v = hmul(v, svh[nb * 128 + c]);
+                unpacked[(size_t) (kb * 128 + r) * N + nb * 128 + c] = v;
+            }
+        });
+    });
+}
+
+// --- kernel-instance tables (cbi = cb*8 + K - 1; 24 + K - 1 for the half-integer rates) -----------
+
+using ReconFn = void (*)(sycl::queue&, sycl::half*, const uint16_t*, int, int, int, int, int);
+using ReconHadFn = void (*)(sycl::queue&, sycl::half*, const uint16_t*, const sycl::half*,
+                            const sycl::half*, int, int, int, int, int);
+
+template <int K, int cb> struct ReconInst { static constexpr ReconFn fn = launch_reconstruct<K, cb, false>; };
+template <int K, int cb> struct ReconHadInst { static constexpr ReconHadFn fn = launch_reconstruct_had<K, cb, false>; };
+
+template <int K> struct ReconHalfInst { static constexpr ReconFn fn = launch_reconstruct<K, 2, true>; };
+template <int K> struct ReconHalfHadInst { static constexpr ReconHadFn fn = launch_reconstruct_had<K, 2, true>; };
+
+template <int... Ks, int... Cs, typename F>
+constexpr auto make_table(F f, std::integer_sequence<int, Ks...>, std::integer_sequence<int, Cs...>)
+{
+    return f(ReconInst<Ks, Cs>::fn...);
+}
+
+template <int K>
+constexpr void expand_cb_recon(ReconFn (&table)[27])
+{
+    table[K - 1]        = launch_reconstruct<K, 0, false>;
+    table[K - 1 + 8]    = launch_reconstruct<K, 1, false>;
+    table[K - 1 + 16]   = launch_reconstruct<K, 2, false>;
+}
+
+template <int K>
+constexpr void expand_cb_had(ReconHadFn (&table)[27])
+{
+    table[K - 1]        = launch_reconstruct_had<K, 0, false>;
+    table[K - 1 + 8]    = launch_reconstruct_had<K, 1, false>;
+    table[K - 1 + 16]   = launch_reconstruct_had<K, 2, false>;
+}
+
+} // namespace
+
+void sycl_reconstruct_impl(sycl::queue& q, at::Tensor unpacked, at::Tensor packed,
+                           float K_, bool mcg, bool mul1, int64_t n_offset);
+void sycl_reconstruct_had_impl(sycl::queue& q, at::Tensor unpacked, at::Tensor packed,
+                               at::Tensor suh, at::Tensor svh, float K_, bool mcg, bool mul1,
+                               int64_t n_offset);
+void sycl_reconstruct_slice(
+    at::Tensor unpacked, at::Tensor packed, float K_, bool mcg, bool mul1, int64_t n_offset);
+void sycl_reconstruct(at::Tensor unpacked, at::Tensor packed, float K_, bool mcg, bool mul1);
+void sycl_reconstruct_had_slice(
+    at::Tensor unpacked, at::Tensor packed, at::Tensor suh, at::Tensor svh,
+    float K_, bool mcg, bool mul1, int64_t n_offset);
+
+void sycl_reconstruct(at::Tensor unpacked, at::Tensor packed, float K_, bool mcg, bool mul1)
+{
+    sycl_reconstruct_impl(exl3_sycl_queue(), unpacked, packed, K_, mcg, mul1, 0);
+}
+
+void sycl_reconstruct_had_slice(at::Tensor unpacked, at::Tensor packed, at::Tensor suh,
+                                at::Tensor svh, float K_, bool mcg, bool mul1, int64_t n_offset)
+{
+    sycl_reconstruct_had_impl(exl3_sycl_queue(), unpacked, packed, suh, svh, K_, mcg, mul1, n_offset);
+}
+
+void sycl_reconstruct_impl(sycl::queue& q, at::Tensor unpacked, at::Tensor packed,
+                           float K_, bool mcg, bool mul1, int64_t n_offset)
+{
+    const BitsK bk = bits_from_K(K_);
+    const int K = bk.bits;
+    TORCH_CHECK(!bk.half || mul1, "reconstruct: half-integer bitrates require the mul1 codebook");
+    TORCH_CHECK(unpacked.size(0) == packed.size(0) * 16, "reconstruct: unpacked K dim must be packed K dim * 16");
+    TORCH_CHECK(packed.size(2) == 16 * K + (bk.half ? 8 : 0), "reconstruct: packed tile size mismatch");
+    TORCH_CHECK(unpacked.scalar_type() == at::kHalf, "reconstruct: unpacked must be float16");
+
+    const int rows = (int) packed.size(0);
+    const int packed_cols = (int) packed.size(1);
+
+    TORCH_CHECK(unpacked.size(1) % 128 == 0, "reconstruct: unpacked N dimension must be divisible by 128");
+    TORCH_CHECK(n_offset % 128 == 0, "reconstruct: n_offset must be divisible by 128");
+    TORCH_CHECK(n_offset >= 0, "reconstruct: n_offset must be non-negative");
+    TORCH_CHECK(n_offset + unpacked.size(1) <= packed.size(1) * 16, "reconstruct: slice exceeds packed tensor bounds");
+
+    if (unpacked.numel() == 0)
+        return;
+
+    const int n_groups = (int) unpacked.size(1) / 128;
+    const int k_blocks = rows;
+    const int packed_n_offset = (int) (n_offset / 16);
+
+    int cbi = K - 1;
+    if (bk.half) cbi += 24;
+    else if (mcg) cbi += 8;
+    else if (mul1) cbi += 16;
+    TORCH_CHECK(cbi >= 0 && cbi < 27, "reconstruct: kernel index out of range: ", cbi);
+
+    static ReconFn table[27] = {};
+    static bool init = false;
+    if (!init)
+    {
+        expand_cb_recon<1>(table); expand_cb_recon<2>(table); expand_cb_recon<3>(table);
+        expand_cb_recon<4>(table); expand_cb_recon<5>(table); expand_cb_recon<6>(table);
+        expand_cb_recon<7>(table); expand_cb_recon<8>(table);
+        table[24] = launch_reconstruct<1, 2, true>;
+        table[25] = launch_reconstruct<2, 2, true>;
+        table[26] = launch_reconstruct<3, 2, true>;
+        init = true;
+    }
+    table[cbi](q, (sycl::half*) unpacked.data_ptr(), (const uint16_t*) packed.data_ptr(),
+               packed_cols, packed_n_offset, (int) unpacked.size(1), n_groups, k_blocks);
+}
+
+void sycl_reconstruct_had_impl(sycl::queue& q, at::Tensor unpacked, at::Tensor packed,
+                               at::Tensor suh, at::Tensor svh, float K_, bool mcg, bool mul1,
+                               int64_t n_offset)
+{
+    const BitsK bk = bits_from_K(K_);
+    const int K = bk.bits;
+    TORCH_CHECK(!bk.half || mul1, "reconstruct_had: half-integer bitrates require the mul1 codebook");
+    TORCH_CHECK(unpacked.size(0) == packed.size(0) * 16, "reconstruct_had: unpacked K dim must be packed K dim * 16");
+    TORCH_CHECK(packed.size(2) == 16 * K + (bk.half ? 8 : 0), "reconstruct_had: packed tile size mismatch");
+    TORCH_CHECK(unpacked.scalar_type() == at::kHalf, "reconstruct_had: unpacked must be float16");
+    TORCH_CHECK(suh.scalar_type() == at::kHalf && svh.scalar_type() == at::kHalf, "reconstruct_had: suh/svh must be float16");
+
+    TORCH_CHECK(unpacked.size(0) % 128 == 0, "reconstruct_had: K dimension must be divisible by 128");
+    TORCH_CHECK(unpacked.size(1) % 128 == 0, "reconstruct_had: N dimension must be divisible by 128");
+    TORCH_CHECK(n_offset % 128 == 0, "reconstruct_had: n_offset must be divisible by 128");
+    TORCH_CHECK(n_offset >= 0, "reconstruct_had: n_offset must be non-negative");
+    TORCH_CHECK(n_offset + unpacked.size(1) <= packed.size(1) * 16, "reconstruct_had: slice exceeds packed tensor bounds");
+    TORCH_CHECK(suh.numel() >= unpacked.size(0), "reconstruct_had: suh size");
+    TORCH_CHECK(svh.numel() >= unpacked.size(1), "reconstruct_had: svh size");
+
+    if (unpacked.numel() == 0)
+        return;
+
+    const int n_groups = (int) unpacked.size(1) / 128;
+    const int k_groups = (int) unpacked.size(0) / 128;
+
+    int cbi = K - 1;
+    if (bk.half) cbi += 24;
+    else if (mcg) cbi += 8;
+    else if (mul1) cbi += 16;
+    TORCH_CHECK(cbi >= 0 && cbi < 27, "reconstruct_had: kernel index out of range: ", cbi);
+
+    static ReconHadFn table[27] = {};
+    static bool init = false;
+    if (!init)
+    {
+        expand_cb_had<1>(table); expand_cb_had<2>(table); expand_cb_had<3>(table);
+        expand_cb_had<4>(table); expand_cb_had<5>(table); expand_cb_had<6>(table);
+        expand_cb_had<7>(table); expand_cb_had<8>(table);
+        table[24] = launch_reconstruct_had<1, 2, true>;
+        table[25] = launch_reconstruct_had<2, 2, true>;
+        table[26] = launch_reconstruct_had<3, 2, true>;
+        init = true;
+    }
+    table[cbi](q, (sycl::half*) unpacked.data_ptr(), (const uint16_t*) packed.data_ptr(),
+               (const sycl::half*) suh.data_ptr(), (const sycl::half*) svh.data_ptr(),
+               (int) packed.size(1), (int) (n_offset / 16), (int) unpacked.size(1),
+               n_groups, k_groups);
+}
diff --git a/exllamav3/exllamav3_ext/sycl/rope.cpp b/exllamav3/exllamav3_ext/sycl/rope.cpp
new file mode 100644
index 0000000..6f93ccd
--- /dev/null
+++ b/exllamav3/exllamav3_ext/sycl/rope.cpp
@@ -0,0 +1,327 @@
+// RoPE (rotary position embeddings), SYCL port of quant/rope.cu rope_kernel.
+//
+// One work-item per (batch, token, head); each work-item processes a whole head in fp32:
+// optional per-head RMS norm (q_norm/k_norm), then the rotation (NEOX pairs (i, i + D/2) or
+// GPTJ interleaved pairs), then the Llama 4 position-dependent scale (queries only). The
+// head lives in global memory between passes, so no local memory is needed and out_q may
+// alias q (in-place apply): every element is read exactly once before its single write.
+
+#include <torch/extension.h>
+#include <ATen/ATen.h>
+#include <sycl/sycl.hpp>
+
+#include "exl3_compat.h"
+#include "sycl_kernels.h"
+
+#define ROPESTYLE_NONE 0
+#define ROPESTYLE_GPTJ 1
+#define ROPESTYLE_NEOX 2
+#define MAX_ROTATE_DIMS 4
+
+namespace
+{
+    template <int rope_mode> class RopeKernelName;
+
+    inline void sincos_accurate(float x, float* s, float* c)
+    {
+        *s = sycl::sincos(x, c);
+    }
+
+    template <int rope_mode>
+    void rope_impl(
+        sycl::queue& q,
+        const sycl::half* q_ptr, sycl::half* out_q_ptr,
+        const sycl::half* k_ptr, sycl::half* out_k_ptr,
+        const float* inv_freq,
+        int bsz, int seq_len, int num_heads_q, int num_heads_k,
+        int head_dim, int q_head_stride, int k_head_stride,
+        int partial_head_dim,
+        int position,
+        const uint32_t* positions,
+        const uint32_t* position_ids,
+        int position_ids_stride,
+        float attn_factor,
+        const void* q_norm, const void* k_norm,
+        bool norm_bf16,
+        float norm_eps, float norm_constant_bias,
+        bool inv_freq_table, int inv_freq_stride,
+        float llama_4_scaling_beta, int llama_4_scaling_original,
+        int rotate_dims, int rotate_offset)
+    {
+        const long total_heads = (long) bsz * seq_len * (num_heads_q + num_heads_k);
+        if (!total_heads) return;
+        constexpr int NT = 64;
+        const size_t groups = ((size_t) total_heads + NT - 1) / NT;
+        const int Dp = partial_head_dim;
+        const int pairs = Dp / 2;
+
+        q.parallel_for<RopeKernelName<rope_mode>>(sycl::range<1>(groups * NT), [=](sycl::item<1> item)
+        {
+            const long idx = item.get_linear_id();
+            if (idx >= total_heads) return;
+
+            // Unpack (batch, token, head); heads walk q first, then k
+            const int heads_per_tok = num_heads_q + num_heads_k;
+            const long tok = idx / heads_per_tok;
+            const int bi = (int) (tok / seq_len);
+            const int si = (int) (tok % seq_len);
+            const int hi = (int) (idx % heads_per_tok);
+
+            const bool is_q = hi < num_heads_q;
+            const sycl::half* src = is_q
+                ? q_ptr + (tok * num_heads_q + hi) * q_head_stride
+                : k_ptr + (tok * num_heads_k + hi - num_heads_q) * k_head_stride;
+            sycl::half* dst = is_q
+                ? out_q_ptr + (tok * num_heads_q + hi) * q_head_stride
+                : out_k_ptr + (tok * num_heads_k + hi - num_heads_q) * k_head_stride;
+
+            // Position for each rotate dim (mrope position_ids vary by rdim)
+            int pos_cache[MAX_ROTATE_DIMS];
+            for (int rdim = 0; rdim < rotate_dims; ++rdim)
+            {
+                int pos = si + position;
+                if (positions)
+                    pos = si + (int) positions[bi];
+                else if (position_ids)
+                {
+                    long pidx = ((long) bi * seq_len + si) * position_ids_stride;
+                    if (position_ids_stride > 1) pidx += rdim;
+                    pos = (int) position_ids[pidx];
+                }
+                pos_cache[rdim] = pos;
+            }
+
+            // Per-head RMS norm: sum of squares over the whole head
+            float rmf = 1.0f;
+            const bool do_norm = is_q ? (q_norm != nullptr) : (k_norm != nullptr);
+            if (do_norm)
+            {
+                float sum = 0.0f;
+                for (int i = 0; i < head_dim; ++i)
+                {
+                    float v = (float) src[i];
+                    sum += v * v;
+                }
+                rmf = sycl::rsqrt(sum / (float) head_dim + norm_eps);
+            }
+
+            // Norm scale for element i: rmf * (weight[i] + bias). The CUDA kernel multiplies
+            // the normed value by the weight in the weight's precision; this port keeps fp32
+            auto norm_scale = [&](int i) -> float
+            {
+                float w = norm_constant_bias;
+                if (norm_bf16)
+                {
+                    const sycl::ext::oneapi::bfloat16* wptr =
+                        (const sycl::ext::oneapi::bfloat16*) (is_q ? q_norm : k_norm);
+                    w += (float) wptr[i];
+                }
+                else
+                {
+                    const sycl::half* wptr = (const sycl::half*) (is_q ? q_norm : k_norm);
+                    w += (float) wptr[i];
+                }
+                return rmf * w;
+            };
+
+            // Llama 4 position-dependent scale, queries only (keys enter the cache unscaled)
+            float l4_scaling = 1.0f;
+            if (llama_4_scaling_beta > 0.0f && is_q)
+                l4_scaling = 1.0f + llama_4_scaling_beta *
+                    sycl::log(1.0f + (float) (pos_cache[0] / llama_4_scaling_original));
+
+            // Rotate and write. Pairs (offset + t, offset + t + Dp/2) cover each rotated
+            // element exactly once, so reads never see this work-item's own writes
+            for (int rdim = 0; rdim < rotate_dims; ++rdim)
+            {
+                const int offset = rotate_offset + Dp * rdim;
+                float sin = 0.0f, cos = 0.0f;
+                if (inv_freq_table)
+                {
+                    // Table mode (mrope): precomputed sincos per position
+                    const int p = pos_cache[rdim];
+                    sincos_accurate(1.0f, &sin, &cos);   // placeholder, overwritten below
+                    for (int t = 0; t < pairs; ++t)
+                    {
+                        float fr = inv_freq[(long) p * pairs + t];
+                        sincos_accurate(fr, &sin, &cos);
+                        sin *= attn_factor;
+                        cos *= attn_factor;
+                        float v1 = (float) src[offset + t];
+                        float v2 = (float) src[offset + t + pairs];
+                        if (do_norm)
+                        {
+                            v1 *= norm_scale(offset + t);
+                            v2 *= norm_scale(offset + t + pairs);
+                        }
+                        v1 *= l4_scaling;
+                        v2 *= l4_scaling;
+                        if constexpr (rope_mode == ROPESTYLE_NEOX)
+                        {
+                            dst[offset + t] = sycl::half(v1 * cos - v2 * sin);
+                            dst[offset + t + pairs] = sycl::half(v2 * cos + v1 * sin);
+                        }
+                        else
+                        {
+                            dst[offset + t] = sycl::half(v1 * cos - v2 * sin);
+                            dst[offset + t + pairs] = sycl::half(v1 * sin + v2 * cos);
+                        }
+                    }
+                    continue;
+                }
+
+                // Scalar inv_freq: fr = inv_freq[t], angle = fr * pos
+                for (int t = 0; t < pairs; ++t)
+                {
+                    float fr = inv_freq[t];
+                    float pf = (float) pos_cache[rdim];
+                    sincos_accurate(fr * pf, &sin, &cos);
+                    sin *= attn_factor;
+                    cos *= attn_factor;
+                    float v1 = (float) src[offset + t];
+                    float v2 = (float) src[offset + t + pairs];
+                    if (do_norm)
+                    {
+                        v1 *= norm_scale(offset + t);
+                        v2 *= norm_scale(offset + t + pairs);
+                    }
+                    v1 *= l4_scaling;
+                    v2 *= l4_scaling;
+                    dst[offset + t] = sycl::half(v1 * cos - v2 * sin);
+                    dst[offset + t + pairs] = sycl::half(v2 * cos + v1 * sin);
+                }
+            }
+
+            // Elements outside the rotated range: norm still applies to the whole head
+            const int rotated = rotate_offset + Dp * rotate_dims;
+            if (rotated < head_dim)
+            {
+                for (int i = 0; i < head_dim; ++i)
+                {
+                    if (i >= rotate_offset && i < rotated) continue;
+                    float v = (float) src[i];
+                    if (do_norm) v *= norm_scale(i);
+                    v *= l4_scaling;
+                    dst[i] = sycl::half(v);
+                }
+            }
+        });
+    }
+}
+
+void sycl_rope(
+    const at::Tensor& q, at::Tensor& out_q,
+    const c10::optional<at::Tensor>& k, c10::optional<at::Tensor>& out_k,
+    const at::Tensor& inv_freq,
+    int64_t position,
+    const c10::optional<at::Tensor>& positions,
+    const c10::optional<at::Tensor>& position_ids,
+    int64_t rope_mode,
+    float attn_factor,
+    const c10::optional<at::Tensor>& q_norm,
+    const c10::optional<at::Tensor>& k_norm,
+    float norm_eps,
+    float norm_constant_bias,
+    float llama_4_scaling_beta,
+    int64_t llama_4_scaling_original,
+    int64_t rotate_dims,
+    int64_t rotate_offset)
+{
+    TORCH_CHECK(q.scalar_type() == at::kHalf, "rope: q must be float16");
+    TORCH_CHECK(q.dim() == 4, "rope: q must be [B, S, H, D]");
+    TORCH_CHECK(k.has_value() == out_k.has_value(), "rope: k and out_k must be given together");
+    TORCH_CHECK(rope_mode == ROPESTYLE_GPTJ || rope_mode == ROPESTYLE_NEOX, "rope: invalid rope_mode");
+    TORCH_CHECK(rotate_dims > 0 && rotate_dims <= MAX_ROTATE_DIMS, "rope: rotate_dims out of range");
+
+    const int bsz = (int) q.size(0);
+    const int seq_len = (int) q.size(1);
+    const int num_heads_q = (int) q.size(2);
+    const int head_dim = (int) q.size(3);
+    const int q_head_stride = (int) q.stride(2);
+    const int k_head_stride = k.has_value() ? (int) k->stride(2) : 0;
+    const int partial_head_dim = (int) inv_freq.size(-1) * 2;
+    TORCH_CHECK(head_dim % 2 == 0, "rope: head_dim must be even");
+    TORCH_CHECK(rotate_dims == 1 || head_dim == partial_head_dim * (int) rotate_dims,
+                "rope: rotate_dims is inconsistent with inv_freq and head_dim");
+    TORCH_CHECK(rotate_offset >= 0 && rotate_offset + partial_head_dim * (int) rotate_dims <= head_dim,
+                "rope: rotate_offset out of range");
+
+    int num_heads_k = 0;
+    if (k.has_value())
+    {
+        TORCH_CHECK(k->scalar_type() == at::kHalf, "rope: k must be float16");
+        TORCH_CHECK(k->dim() == 4, "rope: k must be [B, S, H, D]");
+        TORCH_CHECK(k->size(0) == bsz && k->size(1) == seq_len && k->size(3) == head_dim,
+                    "rope: k is incorrect shape");
+        num_heads_k = (int) k->size(2);
+    }
+
+    TORCH_CHECK(inv_freq.scalar_type() == at::kFloat, "rope: inv_freq must be float32");
+    bool inv_freq_table = inv_freq.dim() > 1;
+    int inv_freq_stride = 0;
+    if (inv_freq_table)
+        inv_freq_stride = (int) inv_freq.size(-1) * inv_freq.size(-2);
+
+    TORCH_CHECK((positions.has_value() ? 1 : 0) + (position_ids.has_value() ? 1 : 0) <= 1,
+                "rope: positions and position_ids are mutually exclusive");
+    if (positions.has_value())
+    {
+        TORCH_CHECK(positions->dim() == 1 && positions->size(0) == bsz, "rope: positions shape");
+        TORCH_CHECK(positions->scalar_type() == at::kInt, "rope: positions must be int32");
+    }
+    int position_ids_stride = 1;
+    if (position_ids.has_value())
+    {
+        TORCH_CHECK(position_ids->scalar_type() == at::kInt, "rope: position_ids must be int32");
+        const int rd = position_ids->dim();
+        TORCH_CHECK(rd == 2 || (rd == 3 && position_ids->size(-1) == rotate_dims),
+                    "rope: position_ids wrong number of dims");
+        TORCH_CHECK(position_ids->size(0) == bsz && position_ids->size(1) == seq_len,
+                    "rope: position_ids is incorrect shape");
+        if (rd == 3) position_ids_stride = (int) rotate_dims;
+    }
+
+    // Per-head RMS norm weights (fp16 or bf16), both or neither
+    TORCH_CHECK(q_norm.has_value() || !k_norm.has_value(), "rope: k_norm requires q_norm");
+    TORCH_CHECK(!q_norm.has_value() || !k.has_value() || k_norm.has_value(),
+                "rope: q_norm with k requires k_norm");
+    bool norm_bf16 = false;
+    if (q_norm.has_value())
+    {
+        TORCH_CHECK(q_norm->dim() == 1 && q_norm->size(0) == head_dim, "rope: q_norm is incorrect size");
+        norm_bf16 = q_norm->scalar_type() == at::kBFloat16;
+        TORCH_CHECK(norm_bf16 || q_norm->scalar_type() == at::kHalf, "rope: unsupported norm dtype");
+        if (k_norm.has_value())
+            TORCH_CHECK(k_norm->scalar_type() == q_norm->scalar_type() &&
+                        k_norm->dim() == 1 && k_norm->size(0) == head_dim,
+                        "rope: k_norm is incorrect size or dtype");
+    }
+
+    if (!bsz || !seq_len || !(num_heads_q + num_heads_k) || !head_dim) return;
+
+    sycl::queue& q_queue = exl3_sycl_queue();
+    const sycl::half* q_ptr = (const sycl::half*) q.data_ptr();
+    sycl::half* out_q_ptr = (sycl::half*) out_q.data_ptr();
+    const sycl::half* k_ptr = k.has_value() ? (const sycl::half*) k->data_ptr() : nullptr;
+    sycl::half* out_k_ptr = out_k.has_value() ? (sycl::half*) out_k->data_ptr() : nullptr;
+    const float* inv_freq_ptr = (const float*) inv_freq.data_ptr();
+    const uint32_t* positions_ptr = positions.has_value() ? (const uint32_t*) positions->data_ptr() : nullptr;
+    const uint32_t* position_ids_ptr = position_ids.has_value() ? (const uint32_t*) position_ids->data_ptr() : nullptr;
+    const void* q_norm_ptr = q_norm.has_value() ? (const void*) q_norm->data_ptr() : nullptr;
+    const void* k_norm_ptr = k_norm.has_value() ? (const void*) k_norm->data_ptr() : nullptr;
+
+    if (rope_mode == ROPESTYLE_NEOX)
+        rope_impl<ROPESTYLE_NEOX>(q_queue, q_ptr, out_q_ptr, k_ptr, out_k_ptr, inv_freq_ptr,
+            bsz, seq_len, num_heads_q, num_heads_k, head_dim, q_head_stride, k_head_stride,
+            partial_head_dim, (int) position, positions_ptr, position_ids_ptr, position_ids_stride,
+            attn_factor, q_norm_ptr, k_norm_ptr, norm_bf16, norm_eps, norm_constant_bias,
+            inv_freq_table, inv_freq_stride, llama_4_scaling_beta, (int) llama_4_scaling_original,
+            (int) rotate_dims, (int) rotate_offset);
+    else
+        rope_impl<ROPESTYLE_GPTJ>(q_queue, q_ptr, out_q_ptr, k_ptr, out_k_ptr, inv_freq_ptr,
+            bsz, seq_len, num_heads_q, num_heads_k, head_dim, q_head_stride, k_head_stride,
+            partial_head_dim, (int) position, positions_ptr, position_ids_ptr, position_ids_stride,
+            attn_factor, q_norm_ptr, k_norm_ptr, norm_bf16, norm_eps, norm_constant_bias,
+            inv_freq_table, inv_freq_stride, llama_4_scaling_beta, (int) llama_4_scaling_original,
+            (int) rotate_dims, (int) rotate_offset);
+}
diff --git a/exllamav3/exllamav3_ext/sycl/sycl_kernels.h b/exllamav3/exllamav3_ext/sycl/sycl_kernels.h
new file mode 100644
index 0000000..0777f6e
--- /dev/null
+++ b/exllamav3/exllamav3_ext/sycl/sycl_kernels.h
@@ -0,0 +1,205 @@
+#pragma once
+
+// Declarations shared between the SYCL backend translation units
+
+#include <sycl/sycl.hpp>
+#include <ATen/Tensor.h>
+#include <vector>
+#include <cstdint>
+#include <cstddef>
+
+// hadamard.cpp
+void sycl_had_r_128(const at::Tensor& input, const at::Tensor& output,
+                    const c10::optional<at::Tensor>& pre_scale,
+                    const c10::optional<at::Tensor>& post_scale, float scale);
+void sycl_had_r_128_h(const at::Tensor& input, const at::Tensor& output,
+                      const c10::optional<at::Tensor>& pre_scale,
+                      const c10::optional<at::Tensor>& post_scale, float scale);
