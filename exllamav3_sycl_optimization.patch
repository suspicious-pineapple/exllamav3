--- /dev/null
+++ b/exllamav3/exllamav3_ext/sycl/elementwise.cpp
@@ -0,0 +1,687 @@
+// Elementwise kernels, ports of norm.cu, add.cu, softcap.cu, activation.cu, plus the GDN fused
+// ops from gdn.cu (see gdn.cpp for the recurrent scan). The fp32 math follows the CUDA kernels;
+// where the CUDA chain computes in fp16, the SYCL port computes in fp32 and rounds once, which is
+// bit-identical for the values involved (see exl3_compat.h).
+
+#include <sycl/sycl.hpp>
+#include <ATen/Tensor.h>
+#include <cmath>
+#include <type_traits>
+
+#include "exl3_compat.h"
+#include "sycl_kernels.h"
+
+namespace {
+
+using bf16 = sycl::ext::oneapi::bfloat16;
+
+// -------------------------------------------------------------------------------------------------
+// add: z = x + y, elementwise, any matching float dtypes
+// -------------------------------------------------------------------------------------------------
+
+template <typename T>
+class AddKernelName;
+
+template <typename T>
+void launch_add(sycl::queue& q, const T* x, const T* y, T* z, size_t numel)
+{
+    q.parallel_for<AddKernelName<T>>(sycl::range<1>(numel), [=](sycl::item<1> item)
+    {
+        const size_t i = item.get_linear_id();
+        z[i] = (T) ((float) x[i] + (float) y[i]);
+    });
+}
+
+// -------------------------------------------------------------------------------------------------
+// softcap: y = tanh(x / scale) * scale
+// -------------------------------------------------------------------------------------------------
+
+template <typename T>
+class SoftcapKernelName;
+
+template <typename T>
+void launch_softcap(sycl::queue& q, const T* x, T* y, size_t numel, float scale)
+{
+    q.parallel_for<SoftcapKernelName<T>>(sycl::range<1>(numel), [=](sycl::item<1> item)
+    {
+        const size_t i = item.get_linear_id();
+        float v = (float) x[i];
+        v = sycl::tanh(v / scale) * scale;
+        y[i] = (T) v;
+    });
+}
+
+// -------------------------------------------------------------------------------------------------
+// rms_norm: y = x * (w + constant_bias) / sqrt(row_mean(x^2) + epsilon) * constant_scale
+// res modes: 0 = none, 1 = residual in (r += x rounded to r's dtype, feeds the norm), 2 = residual
+// post (y = norm(x) + y). One work-group of 128 items per row; W = int means no weight.
+// -------------------------------------------------------------------------------------------------
+
+template <typename IN, typename OUT, typename W, typename RD, int LS>
+class RmsNormKernelName;
+
+// One work-group per row. The group size is picked by row width: a decode row is a single group on
+// one EU, so a narrow group leaves the row latency-bound (40 sequential elements per item at
+// LS=128) -- 512 items cut that to ~10 (measured 29us -> ~11us per 5120-wide decode norm).
+template <typename IN, typename OUT, typename W, typename RD, int LS>
+void launch_rms_norm(sycl::queue& q, const IN* x, const W* w, OUT* y, RD* r,
+                     float epsilon, int rows, int dim, float constant_bias, float constant_scale,
+                     int res)
+{
+    q.submit([&](sycl::handler& cgh)
+    {
+        sycl::local_accessor<float, 1> red(sycl::range<1>(LS), cgh);
+        cgh.parallel_for<RmsNormKernelName<IN, OUT, W, RD, LS>>(
+            sycl::nd_range<1>(sycl::range<1>((size_t) rows * LS), sycl::range<1>(LS)),
+            [=](sycl::nd_item<1> it)
+        {
+            const int row = (int) it.get_group_linear_id();
+            const int t = (int) it.get_local_id(0);
+
+            const IN* xrow = x + (size_t) row * dim;
+            OUT* yrow = y + (size_t) row * dim;
+            RD* rrow = (res == 1) ? r + (size_t) row * dim : nullptr;
+
+            float partial = 0.0f;
+            for (int c = t; c < dim; c += LS)
+            {
+                float v;
+                if (res == 1)
+                {
+                    // r += x, rounded to the residual dtype so the result matches an unfused add
+                    float rv = (float) rrow[c] + (float) xrow[c];
+                    rrow[c] = (RD) rv;
+                    v = (float) rrow[c];
+                }
+                else
+                    v = (float) xrow[c];
+                partial += v * v;
+            }
+            red[t] = partial;
+            sycl::group_barrier(it.get_group());
+            // tree reduction over the partials (the serial thread-0 sum cost ~LS cycles)
+            for (int st = LS / 2; st > 0; st >>= 1)
+            {
+                if (t < st) red[t] += red[t + st];
+                sycl::group_barrier(it.get_group());
+            }
+
+            const float rmf = sycl::rsqrt(red[0] / (float) dim + epsilon) * constant_scale;
+
+            for (int c = t; c < dim; c += LS)
+            {
+                float v;
+                if (res == 1)
+                    v = (float) rrow[c];
+                else
+                    v = (float) xrow[c];
+                if constexpr (!std::is_same_v<W, int>)
+                {
+                    float wv = (float) w[c];
+                    if (constant_bias != 0.0f) wv += constant_bias;
+                    v = v * wv * rmf;
+                }
+                else
+                    v = v * rmf;
+                if (res == 2)
+                    v = v + (float) yrow[c];
+                yrow[c] = (OUT) v;
+            }
+        });
+    });
+}
+
+// Weight-dtype dispatch shared by all rms_norm res modes (0 = plain, 1 = residual-in, 2 = residual
+// out). RD is only read for res == 1; the other modes pass sycl::half as a placeholder
+template <typename IN, typename OUT>
+void rms_norm_dispatch_w(sycl::queue& q, const void* x_ptr, const void* w_ptr, bool w_is_bf16,
+                         void* y_ptr, void* r_ptr, float epsilon, int rows, int dim,
+                         float constant_bias, float constant_scale, int res_mode,
+                         at::ScalarType rdt)
+{
+    using bf = sycl::ext::oneapi::bfloat16;
+    #define RN_CALL_WR(W_T, RD_T) \
+        do { \
+            if (dim > 1024) \
+                launch_rms_norm<IN, OUT, W_T, RD_T, 512>(q, (const IN*) x_ptr, (const W_T*) w_ptr, \
+                    (OUT*) y_ptr, (RD_T*) r_ptr, epsilon, rows, dim, constant_bias, constant_scale, res_mode); \
+            else \
+                launch_rms_norm<IN, OUT, W_T, RD_T, 128>(q, (const IN*) x_ptr, (const W_T*) w_ptr, \
+                    (OUT*) y_ptr, (RD_T*) r_ptr, epsilon, rows, dim, constant_bias, constant_scale, res_mode); \
+        } while (0)
+    #define RN_CALL_W(W_T) \
+        do { \
+            if (res_mode == 1 && rdt == at::kBFloat16) RN_CALL_WR(W_T, bf); \
+            else if (res_mode == 1 && rdt == at::kFloat) RN_CALL_WR(W_T, float); \
+            else RN_CALL_WR(W_T, sycl::half); \
+        } while (0)
+    if (!w_ptr)          RN_CALL_W(int);
+    else if (w_is_bf16)  RN_CALL_W(bf);
+    else                 RN_CALL_W(sycl::half);
+    #undef RN_CALL_WR
+    #undef RN_CALL_W
+}
+
+// -------------------------------------------------------------------------------------------------
+// gated_rms_norm: y = norm(x) * (w + bias) * act(g) (gate_last) or norm(x * act(g)) * w (gate_first)
+// x is bf16, gate fp32/bf16, weight half/bf16, output half/float
+// -------------------------------------------------------------------------------------------------
+
+inline float gate_fn(float v, int gate_act)
+{
+    if (gate_act == 1)
+        return 1.0f / (1.0f + sycl::exp(-v));                       // sigmoid
+    return v / (1.0f + sycl::exp(-v));                              // silu
+}
+
+template <typename W, typename OUT, typename G>
+class GatedRmsNormKernelName;
+
+template <typename W, typename OUT, typename G>
+void launch_gated_rms_norm(sycl::queue& q, const bf16* x, const W* w, OUT* y, const G* g,
+                           float epsilon, int rows, int dim, float constant_bias,
+                           int w_groups, bool gate_first, int gate_act)
+{
+    constexpr int LS = 128;
+    q.submit([&](sycl::handler& cgh)
+    {
+        sycl::local_accessor<float, 1> red(sycl::range<1>(LS), cgh);
+        cgh.parallel_for<GatedRmsNormKernelName<W, OUT, G>>(
+            sycl::nd_range<1>(sycl::range<1>((size_t) rows * LS), sycl::range<1>(LS)),
+            [=](sycl::nd_item<1> it)
+        {
+            const int row = (int) it.get_group_linear_id();
+            const int t = (int) it.get_local_id(0);
+
+            const bf16* xrow = x + (size_t) row * dim;
+            OUT* yrow = y + (size_t) row * dim;
+            const G* grow = g + (size_t) row * dim;
+            const W* wrow = w + (size_t) (row % w_groups) * dim;
+
+            float partial = 0.0f;
+            for (int c = t; c < dim; c += LS)
+            {
+                float v = (float) xrow[c];
+                if (gate_first) v = v * gate_fn((float) grow[c], gate_act);
+                partial += v * v;
+            }
+            red[t] = partial;
+            sycl::group_barrier(it.get_group());
+            // tree reduction over the partials (the serial thread-0 sum cost ~LS cycles)
+            for (int st = LS / 2; st > 0; st >>= 1)
+            {
+                if (t < st) red[t] += red[t + st];
+                sycl::group_barrier(it.get_group());
+            }
+
+            const float rmf = sycl::rsqrt(red[0] / (float) dim + epsilon);
+
+            for (int c = t; c < dim; c += LS)
+            {
+                float v = (float) xrow[c];
+                float wv = (float) wrow[c];
+                if (constant_bias != 0.0f) wv += constant_bias;
+                float gv = gate_fn((float) grow[c], gate_act);
+                if (gate_first)
+                    v = (v * gv) * wv * rmf;
+                else
+                    v = (v * wv * rmf) * gv;
+                yrow[c] = (OUT) v;
+            }
+        });
+    });
+}
+
+// -------------------------------------------------------------------------------------------------
+// act_mul: z = act(x) * y; act = silu / gelu(tanh) / relu2 / relu; act_limit != 0 clamps y to
+// +/-limit and x to +limit
+// -------------------------------------------------------------------------------------------------
+
+template <int ACT>
+inline float apply_act(float x)
+{
+    if constexpr (ACT == 0)   // silu
+        return x / (1.0f + sycl::exp(-x));
+    if constexpr (ACT == 1)   // gelu (tanh approximation)
+    {
+        const float c = 0.797884560803f;  // sqrt(2/Pi)
+        float tanh_arg = c * (x + 0.044715f * x * x * x);
+        return 0.5f * x * (1.0f + sycl::tanh(tanh_arg));
+    }
+    if constexpr (ACT == 2)   // relu2
+    {
+        x = sycl::fmax(0.0f, x);
+        return x * x;
+    }
+    if constexpr (ACT == 4)   // relu
+        return sycl::fmax(0.0f, x);
+}
+
+template <int ACT, typename T>
+class ActMulKernelName;
+
+template <int ACT, typename T>
+void launch_act_mul(sycl::queue& q, const T* x, const T* y, sycl::half* z, float act_limit,
+                    size_t numel)
+{
+    q.parallel_for<ActMulKernelName<ACT, T>>(sycl::range<1>(numel), [=](sycl::item<1> item)
+    {
+        const size_t i = item.get_linear_id();
+        float xv = (float) x[i];
+        float yv = (float) y[i];
+        xv = apply_act<ACT>(xv);
+        if (act_limit != 0.0f)
+        {
+            yv = sycl::fmin(sycl::fmax(yv, -act_limit), act_limit);
+            xv = sycl::fmin(xv, act_limit);
+        }
+        z[i] = sycl::half(xv * yv);
+    });
+}
+
+} // namespace
+
+// --- host entry points ----------------------------------------------------------------------------
+
+void sycl_add(const at::Tensor& x, const at::Tensor& y, at::Tensor& z)
+{
+    TORCH_CHECK(x.sizes() == y.sizes() && x.sizes() == z.sizes(), "add: shape mismatch");
+    const auto dt = x.scalar_type();
+    TORCH_CHECK(y.scalar_type() == dt && z.scalar_type() == dt, "add: dtype mismatch");
+    const size_t numel = x.numel();
+    if (!numel) return;
+    sycl::queue& q = exl3_sycl_queue();
+
+    if (dt == at::kHalf)
+        launch_add<sycl::half>(q, (const sycl::half*) x.data_ptr(), (const sycl::half*) y.data_ptr(),
+                               (sycl::half*) z.data_ptr(), numel);
+    else if (dt == at::kFloat)
+        launch_add<float>(q, (const float*) x.data_ptr(), (const float*) y.data_ptr(),
+                          (float*) z.data_ptr(), numel);
+    else if (dt == at::kBFloat16)
+        launch_add<bf16>(q, (const bf16*) x.data_ptr(), (const bf16*) y.data_ptr(),
+                         (bf16*) z.data_ptr(), numel);
+    else
+        TORCH_CHECK(false, "add: unsupported dtype");
+}
+
+void sycl_softcap(at::Tensor x, at::Tensor y, float scale)
+{
+    const size_t numel = x.numel();
+    TORCH_CHECK(y.scalar_type() == x.scalar_type() && y.numel() == numel, "softcap: y must match x");
+    TORCH_CHECK(x.is_contiguous() && y.is_contiguous(), "softcap: x and y must be contiguous");
+    if (!numel) return;
+    sycl::queue& q = exl3_sycl_queue();
+
+    if (x.scalar_type() == at::kFloat)
+        launch_softcap<float>(q, (const float*) x.data_ptr(), (float*) y.data_ptr(), numel, scale);
+    else if (x.scalar_type() == at::kHalf)
+        launch_softcap<sycl::half>(q, (const sycl::half*) x.data_ptr(), (sycl::half*) y.data_ptr(), numel, scale);
+    else
+        TORCH_CHECK(false, "softcap: unsupported dtype");
+}
+
+// Weight dtype gate: half / bf16 / float, or none
+static bool wdt_ok(const c10::optional<at::Tensor>& w)
+{
+    if (!w.has_value()) return true;
+    const auto t = w->scalar_type();
+    return t == at::kHalf || t == at::kBFloat16 || t == at::kFloat;
+}
+
+// Flatten to rows x dim and run the requested res mode
+static void rms_norm_run(at::Tensor& x, const c10::optional<at::Tensor>& w, at::Tensor& y,
+                         const c10::optional<at::Tensor>& r, float epsilon, float constant_bias,
+                         float constant_scale, int res_mode)
+{
+    const int rows = (int) (x.numel() / x.size(-1));
+    const int dim = (int) x.size(-1);
+    if (!rows || !dim) return;
+    sycl::queue& q = exl3_sycl_queue();
+
+    const void* x_ptr = x.data_ptr();
+    void* y_ptr = y.data_ptr();
+    const void* w_ptr = w.has_value() ? w->data_ptr() : nullptr;
+    const bool w_is_bf16 = w.has_value() && w->scalar_type() == at::kBFloat16;
+    const void* r_ptr = r.has_value() ? r->data_ptr() : nullptr;
+    const auto rdt = r.has_value() ? r->scalar_type() : at::kHalf;
+
+    const auto xdt = x.scalar_type();
+    const auto ydt = y.scalar_type();
+
+    // RD (residual dtype) only matters for res == 1 (residual-in): the dispatch threads r's
+    // actual dtype so the folded r += x rounds like an unfused add on the residual's storage
+    #define RN_CASE(IN_T, OUT_T) \
+        rms_norm_dispatch_w<IN_T, OUT_T>(q, x_ptr, w_ptr, w_is_bf16, y_ptr, const_cast<void*>(r_ptr), \
+            epsilon, rows, dim, constant_bias, constant_scale, res_mode, rdt)
+
+    using bf = sycl::ext::oneapi::bfloat16;
+
+    if (xdt == at::kHalf && ydt == at::kHalf)              RN_CASE(sycl::half, sycl::half);
+    else if (xdt == at::kHalf && ydt == at::kFloat)        RN_CASE(sycl::half, float);
+    else if (xdt == at::kHalf && ydt == at::kBFloat16)     RN_CASE(sycl::half, bf);
+    else if (xdt == at::kFloat && ydt == at::kHalf)        RN_CASE(float, sycl::half);
+    else if (xdt == at::kFloat && ydt == at::kFloat)       RN_CASE(float, float);
+    else if (xdt == at::kFloat && ydt == at::kBFloat16)    RN_CASE(float, bf);
+    else if (xdt == at::kBFloat16 && ydt == at::kHalf)     RN_CASE(bf, sycl::half);
+    else if (xdt == at::kBFloat16 && ydt == at::kFloat)    RN_CASE(bf, float);
+    else if (xdt == at::kBFloat16 && ydt == at::kBFloat16) RN_CASE(bf, bf);
+    else TORCH_CHECK(false, "rms_norm: unsupported dtype combination");
+    #undef RN_CASE
+    #undef RN_CASE_R
+}
+
+void sycl_rms_norm(at::Tensor x, const c10::optional<at::Tensor> w, at::Tensor y,
+                   float epsilon, float constant_bias, float constant_scale, bool add_residual)
+{
+    TORCH_CHECK(x.sizes() == y.sizes(), "rms_norm: x/y shape mismatch");
+    TORCH_CHECK(wdt_ok(w), "rms_norm: unsupported weight dtype");
+    rms_norm_run(x, w, y, c10::nullopt, epsilon, constant_bias, constant_scale, add_residual ? 2 : 0);
+}
+
+void sycl_rms_norm_res_in(at::Tensor x, c10::optional<at::Tensor> w, at::Tensor y, at::Tensor r,
+                          float epsilon, float constant_bias, float constant_scale)
+{
+    TORCH_CHECK(x.sizes() == y.sizes() && x.sizes() == r.sizes(), "rms_norm_res_in: shape mismatch");
+    TORCH_CHECK(wdt_ok(w), "rms_norm_res_in: unsupported weight dtype");
+    rms_norm_run(x, w, y, r, epsilon, constant_bias, constant_scale, 1);
+}
+
+void sycl_gated_rms_norm(at::Tensor x, at::Tensor w, at::Tensor y, at::Tensor g,
+                         float epsilon, float constant_bias, int w_groups, bool gate_first,
+                         int gate_act)
+{
+    TORCH_CHECK(x.scalar_type() == at::kBFloat16, "gated_rms_norm: x must be bf16");
+    TORCH_CHECK(x.sizes() == y.sizes(), "gated_rms_norm: x/y shape mismatch");
+    TORCH_CHECK(x.sizes() == g.sizes(), "gated_rms_norm: x/g shape mismatch");
+    if (x.numel() == 0) return;
+
+    const int rows = (int) (x.numel() / x.size(-1));
+    const int dim = (int) x.size(-1);
+    sycl::queue& q = exl3_sycl_queue();
+
+    const bf16* x_ptr = (const bf16*) x.data_ptr();
+    const bool w_is_bf16 = w.scalar_type() == at::kBFloat16;
+    const bool w_is_f32 = w.scalar_type() == at::kFloat;
+
+    #define GRN_CASE(OUT_T) \
+        do { \
+            if (g.scalar_type() == at::kFloat) \
+            { \
+                if (w_is_bf16) launch_gated_rms_norm<bf16, OUT_T, float>(q, x_ptr, (const bf16*) w.data_ptr(), (OUT_T*) y.data_ptr(), \
+                    (const float*) g.data_ptr(), epsilon, rows, dim, constant_bias, w_groups, gate_first, gate_act); \
+                else if (w_is_f32) launch_gated_rms_norm<float, OUT_T, float>(q, x_ptr, (const float*) w.data_ptr(), \
+                    (OUT_T*) y.data_ptr(), (const float*) g.data_ptr(), epsilon, rows, dim, constant_bias, w_groups, gate_first, gate_act); \
+                else launch_gated_rms_norm<sycl::half, OUT_T, float>(q, x_ptr, (const sycl::half*) w.data_ptr(), \
+                    (OUT_T*) y.data_ptr(), (const float*) g.data_ptr(), epsilon, rows, dim, constant_bias, w_groups, gate_first, gate_act); \
+            } \
+            else \
+            { \
+                if (w_is_bf16) launch_gated_rms_norm<bf16, OUT_T, bf16>(q, x_ptr, (const bf16*) w.data_ptr(), (OUT_T*) y.data_ptr(), \
+                    (const bf16*) g.data_ptr(), epsilon, rows, dim, constant_bias, w_groups, gate_first, gate_act); \
+                else if (w_is_f32) launch_gated_rms_norm<float, OUT_T, bf16>(q, x_ptr, (const float*) w.data_ptr(), \
+                    (OUT_T*) y.data_ptr(), (const bf16*) g.data_ptr(), epsilon, rows, dim, constant_bias, w_groups, gate_first, gate_act); \
+                else launch_gated_rms_norm<sycl::half, OUT_T, bf16>(q, x_ptr, (const sycl::half*) w.data_ptr(), \
+                    (OUT_T*) y.data_ptr(), (const bf16*) g.data_ptr(), epsilon, rows, dim, constant_bias, w_groups, gate_first, gate_act); \
+            } \
+        } while (0)
+
+    if (y.scalar_type() == at::kHalf) GRN_CASE(sycl::half);
+    else if (y.scalar_type() == at::kFloat) GRN_CASE(float);
+    else if (y.scalar_type() == at::kBFloat16) GRN_CASE(bf16);
+    else TORCH_CHECK(false, "gated_rms_norm: unsupported output dtype");
+    #undef GRN_CASE
+}
+
+void sycl_act_mul(at::Tensor x, at::Tensor y, at::Tensor z, int act, float act_limit)
+{
+    const size_t numel = x.numel();
+    TORCH_CHECK(y.numel() == numel && z.numel() == numel, "act_mul: numel mismatch");
+    TORCH_CHECK(x.is_contiguous() && y.is_contiguous() && z.is_contiguous(), "act_mul: must be contiguous");
+    TORCH_CHECK(z.scalar_type() == at::kHalf, "act_mul: z must be float16");
+    if (!numel) return;
+    sycl::queue& q = exl3_sycl_queue();
+
+    sycl::half* z_ptr = (sycl::half*) z.data_ptr();
+
+    #define AM_CASE(ACT) \
+        do { \
+            if (x.scalar_type() == at::kHalf) \
+                launch_act_mul<ACT, sycl::half>(q, (const sycl::half*) x.data_ptr(), \
+                    (const sycl::half*) y.data_ptr(), z_ptr, act_limit, numel); \
+            else if (x.scalar_type() == at::kFloat) \
+                launch_act_mul<ACT, float>(q, (const float*) x.data_ptr(), \
+                    (const float*) y.data_ptr(), z_ptr, act_limit, numel); \
+            else TORCH_CHECK(false, "act_mul: unsupported dtype"); \
+        } while (0)
+
+    switch (act)
+    {
+        case 0: AM_CASE(0); break;   // silu
+        case 1: AM_CASE(1); break;   // gelu
+        case 2: AM_CASE(2); break;   // relu2
+        case 4: AM_CASE(4); break;   // relu
+        default: TORCH_CHECK(false, "act_mul: unsupported activation");
+    }
+    #undef AM_CASE
+}
+
+// -------------------------------------------------------------------------------------------------
+// Attention gates: x *= sigmoid(y) (element-wise and broadcast), x *= softplus(y) (broadcast,
+// computed in fp32 like the reference)
+// -------------------------------------------------------------------------------------------------
+
+template <bool BROADCAST, typename T>
+class MulSigmoidKernelName;
+
+inline float sigmoid_fast(float x) { return 1.0f / (1.0f + sycl::exp(-x)); }
+inline float softplus_fast(float x) { return sycl::fmax(x, 0.0f) + sycl::log1p(sycl::exp(-sycl::fabs(x))); }
+
+// sigmoid gate, element-wise: x *= sigmoid(y) evaluated in fp16 like the CUDA kernel
+template <typename T>
+void launch_mul_sigmoid(sycl::queue& q, T* x, const T* y, size_t numel)
+{
+    constexpr int NT = 256;
+    const size_t pairs = numel / 2;
+    const size_t groups = (pairs + NT - 1) / NT;
+    q.parallel_for<MulSigmoidKernelName<false, T>>(
+        sycl::nd_range<1>(sycl::range<1>(groups * NT), sycl::range<1>(NT)),
+        [=](sycl::nd_item<1> it)
+    {
+        const size_t i = it.get_global_id(0);
+        if (i >= pairs) return;
+        T a = x[i * 2], b = x[i * 2 + 1];
+        T g0 = (T) sigmoid_fast((float) y[i * 2]);
+        T g1 = (T) sigmoid_fast((float) y[i * 2 + 1]);
+        x[i * 2] = (T) ((float) a * (float) g0);
+        x[i * 2 + 1] = (T) ((float) b * (float) g1);
+    });
+}
+
+// sigmoid gate, broadcast: y is [.., H], x [.., H, D], dim = D
+template <typename T>
+void launch_mul_sigmoid_broadcast(sycl::queue& q, T* x, const T* y, size_t numel, size_t dim)
+{
+    constexpr int NT = 256;
+    const size_t pairs = numel / 2;
+    const size_t groups = (pairs + NT - 1) / NT;
+    q.parallel_for<MulSigmoidKernelName<true, T>>(
+        sycl::nd_range<1>(sycl::range<1>(groups * NT), sycl::range<1>(NT)),
+        [=](sycl::nd_item<1> it)
+    {
+        const size_t i = it.get_global_id(0);
+        if (i >= pairs) return;
+        T a = x[i * 2], b = x[i * 2 + 1];
+        T g0 = (T) sigmoid_fast((float) y[(i * 2) / dim]);
+        T g1 = (T) sigmoid_fast((float) y[(i * 2 + 1) / dim]);
+        x[i * 2] = (T) ((float) a * (float) g0);
+        x[i * 2 + 1] = (T) ((float) b * (float) g1);
+    });
+}
+
+// softplus gate, broadcast, computed in fp32 (the reference evaluates softplus(g.float()))
+template <typename T>
+class MulSoftplusKernelName;
+
+template <typename T>
+void launch_mul_softplus_broadcast(sycl::queue& q, T* x, const T* y, size_t numel, size_t dim)
+{
+    constexpr int NT = 256;
+    const size_t pairs = numel / 2;
+    const size_t groups = (pairs + NT - 1) / NT;
+    q.parallel_for<MulSoftplusKernelName<T>>(
+        sycl::nd_range<1>(sycl::range<1>(groups * NT), sycl::range<1>(NT)),
+        [=](sycl::nd_item<1> it)
+    {
+        const size_t i = it.get_global_id(0);
+        if (i >= pairs) return;
+        float a = (float) x[i * 2], b = (float) x[i * 2 + 1];
+        float g0 = softplus_fast((float) y[(i * 2) / dim]);
+        float g1 = softplus_fast((float) y[(i * 2 + 1) / dim]);
+        x[i * 2] = (T) (a * g0);
+        x[i * 2 + 1] = (T) (b * g1);
+    });
+}
+
+void sycl_mul_sigmoid(at::Tensor x, at::Tensor y)
+{
+    TORCH_CHECK(x.scalar_type() == at::kHalf && y.scalar_type() == at::kHalf,
+                "mul_sigmoid_: half tensors expected");
+    TORCH_CHECK(x.numel() == y.numel(), "mul_sigmoid_: numel mismatch");
+    TORCH_CHECK(x.is_contiguous() && y.is_contiguous(), "mul_sigmoid_: contiguous expected");
+    if (!x.numel()) return;
+    sycl::queue& q = exl3_sycl_queue();
+    launch_mul_sigmoid<sycl::half>(q, (sycl::half*) x.data_ptr(), (const sycl::half*) y.data_ptr(), x.numel());
+}
+
+void sycl_mul_sigmoid_broadcast(at::Tensor x, at::Tensor y)
+{
+    TORCH_CHECK(x.scalar_type() == at::kHalf && y.scalar_type() == at::kHalf,
+                "mul_sigmoid_broadcast_: half tensors expected");
+    TORCH_CHECK(x.dim() == 4 && y.dim() == 3, "mul_sigmoid_broadcast_: x [B,S,H,D], y [B,S,H]");
+    TORCH_CHECK(x.is_contiguous() && y.is_contiguous(), "mul_sigmoid_broadcast_: contiguous expected");
+    if (!x.numel()) return;
+    sycl::queue& q = exl3_sycl_queue();
+    launch_mul_sigmoid_broadcast<sycl::half>(q, (sycl::half*) x.data_ptr(), (const sycl::half*) y.data_ptr(),
+                                       x.numel(), (size_t) x.size(3));
+}
+
+void sycl_mul_softplus_broadcast(at::Tensor x, at::Tensor y)
+{
+    TORCH_CHECK(x.scalar_type() == at::kHalf && y.scalar_type() == at::kHalf,
+                "mul_softplus_broadcast_: half tensors expected");
+    TORCH_CHECK(x.dim() == 4 && y.dim() == 3, "mul_softplus_broadcast_: x [B,S,H,D], y [B,S,H]");
+    TORCH_CHECK(x.is_contiguous() && y.is_contiguous(), "mul_softplus_broadcast_: contiguous expected");
+    if (!x.numel()) return;
+    sycl::queue& q = exl3_sycl_queue();
+    launch_mul_softplus_broadcast<sycl::half>(q, (sycl::half*) x.data_ptr(), (const sycl::half*) y.data_ptr(),
+                                        x.numel(), (size_t) x.size(3));
+}
+
+// -------------------------------------------------------------------------------------------------
+// deinterleave_qg: qg is (.., heads * 2 * head_dim) half with each head's segment laid out as
+// [q (head_dim), g (head_dim)]; split into q and g
+// -------------------------------------------------------------------------------------------------
+
+class DeinterleaveQgKernelName;
+
+void sycl_deinterleave_qg(const at::Tensor& qg, at::Tensor& q, at::Tensor& g, int head_dim)
+{
+    TORCH_CHECK(qg.scalar_type() == at::kHalf && q.scalar_type() == at::kHalf &&
+                g.scalar_type() == at::kHalf, "deinterleave_qg: half tensors expected");
+    TORCH_CHECK(head_dim > 0 && head_dim % 8 == 0, "deinterleave_qg: head_dim must be a multiple of 8");
+    TORCH_CHECK(qg.is_contiguous() && q.is_contiguous() && g.is_contiguous(),
+                "deinterleave_qg: contiguous expected");
+    TORCH_CHECK(q.numel() == g.numel() && q.numel() * 2 == qg.numel(), "deinterleave_qg: size mismatch");
+    if (!q.numel()) return;
+
+    const int hd8 = head_dim / 8;
+    const size_t n8 = q.numel() / 8;
+    sycl::queue& q_queue = exl3_sycl_queue();
+    constexpr int NT = 256;
+    const size_t groups = (n8 + NT - 1) / NT;
+    const sycl::half* src = (const sycl::half*) qg.data_ptr();
+    sycl::half* qp = (sycl::half*) q.data_ptr();
+    sycl::half* gp = (sycl::half*) g.data_ptr();
+
+    q_queue.parallel_for<DeinterleaveQgKernelName>(
+        sycl::nd_range<1>(sycl::range<1>(groups * NT), sycl::range<1>(NT)),
+        [=](sycl::nd_item<1> it)
+    {
+        const size_t i = it.get_global_id(0);
+        if (i >= n8) return;
+        const size_t d = i % hd8;
+        const size_t h = i / hd8;
+        const size_t src8 = (h * 2 * hd8 + d) * 8;
+        for (int j = 0; j < 8; ++j)
+        {
+            qp[i * 8 + j] = src[src8 + j];
+            gp[i * 8 + j] = src[src8 + hd8 * 8 + j];
+        }
+    });
+}
+
+// -------------------------------------------------------------------------------------------------
+// paged_kv_cache_update: scatter k/v into the paged fp16 cache. For token (b, s):
+// page = block_table[b, (seqlen + s) / 256], pos = (seqlen + s) % 256.
+// -------------------------------------------------------------------------------------------------
+
+class PagedKvUpdateKernelName;
+
+void sycl_paged_kv_cache_update(const at::Tensor& k, const at::Tensor& v,
+                                at::Tensor& k_cache, at::Tensor& v_cache,
+                                const at::Tensor& block_table, const at::Tensor& cache_seqlens)
+{
+    TORCH_CHECK(k.scalar_type() == at::kHalf && v.scalar_type() == at::kHalf &&
+                k_cache.scalar_type() == at::kHalf && v_cache.scalar_type() == at::kHalf,
+                "paged_kv_cache_update: half tensors expected");
+    TORCH_CHECK(k.dim() == 4 && v.dim() == 4, "paged_kv_cache_update: k/v must be [B, S, H, D]");
+    TORCH_CHECK(k_cache.dim() == 4 && v_cache.dim() == 4,
+                "paged_kv_cache_update: cache must be [num_blocks, 256, H, D]");
+    TORCH_CHECK(k_cache.size(1) == 256 && v_cache.size(1) == 256, "paged_kv_cache_update: page_size == 256");
+    TORCH_CHECK(block_table.dim() == 2 && cache_seqlens.dim() == 1,
+                "paged_kv_cache_update: block_table [B, max_blocks], cache_seqlens [B]");
+    TORCH_CHECK(k.is_contiguous() && v.is_contiguous() && k_cache.is_contiguous() &&
+                v_cache.is_contiguous() && block_table.is_contiguous() && cache_seqlens.is_contiguous(),
+                "paged_kv_cache_update: tensors must be contiguous");
+    TORCH_CHECK(k_cache.size(2) == k.size(2) && k_cache.size(3) == k.size(3),
+                "paged_kv_cache_update: cache heads/dim do not match k");
+
+    const int B = (int) k.size(0);
+    const int S = (int) k.size(1);
+    const int H = (int) k.size(2);
+    const int D = (int) k.size(3);
+    if (!B || !S || !H || !D) return;
+
+    sycl::queue& q = exl3_sycl_queue();
+    constexpr int NT = 256;
+    const size_t tokens = (size_t) B * S;
+    const size_t groups = (tokens + NT - 1) / NT;
+    const sycl::half* kp = (const sycl::half*) k.data_ptr();
+    const sycl::half* vp = (const sycl::half*) v.data_ptr();
+    sycl::half* kcp = (sycl::half*) k_cache.data_ptr();
+    sycl::half* vcp = (sycl::half*) v_cache.data_ptr();
+    const int* btp = (const int*) block_table.data_ptr();
+    const int* slp = (const int*) cache_seqlens.data_ptr();
+    const int max_blocks = (int) block_table.size(1);
+
+    q.parallel_for<PagedKvUpdateKernelName>(
+        sycl::nd_range<1>(sycl::range<1>(groups * NT), sycl::range<1>(NT)),
+        [=](sycl::nd_item<1> it)
+    {
+        const size_t tok = it.get_global_id(0);
+        if (tok >= tokens) return;
+        const int bi = (int) (tok / S);
+        const int si = (int) (tok % S);
+        const int t = slp[bi] + si;                 // absolute position in the sequence
+        const int page = btp[bi * max_blocks + (t >> 8)];      // 256 tokens per page
+        const int pos = t & 255;
+        const size_t src = ((size_t) bi * S + si) * H * D;
+        const size_t dst = ((size_t) page * 256 + pos) * H * D;
+        for (int i = 0; i < H * D; ++i)
+        {
+            kcp[dst + i] = kp[src + i];
+            vcp[dst + i] = vp[src + i];
+        }
+    });
+}
diff --git a/exllamav3/exllamav3_ext/sycl/exl3_compat.h b/exllamav3/exllamav3_ext/sycl/exl3_compat.h
new file mode 100644
index 0000000..f4d9f88
--- /dev/null
+++ b/exllamav3/exllamav3_ext/sycl/exl3_compat.h
@@ -0,0 +1,83 @@
+#pragma once
+
+// Shared helpers for the SYCL backend (port of the CUDA compat.cuh pieces the kernels need).
+// Hand-written SYCL 2020, no dpct-isms: everything is plain inline C++.
+
+#include <sycl/sycl.hpp>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+
+// -------------------------------------------------------------------------------------------------
+// fp16 helpers. CUDA __hadd/__hmul/__hfma compute in fp16 with one rounding at the end; sycl::half
+// arithmetic promotes to float, computes, and rounds back once. Since every fp16 value is exact in
+// fp32, the promoted result is the correctly-rounded fp16 of the exact value, which is
+// bit-identical to the fp16-in/fp16-out intrinsic for add/mul/fma. The one exception to keep
+// integer is the mul1 byte-sum (dp4a_ones below) and the uint16 -> half reinterpret (bit copy).
+// -------------------------------------------------------------------------------------------------
+
+inline float h2f(sycl::half h) { return static_cast<float>(h); }
+
+inline sycl::half f2h(float f) { return sycl::half(f); }
+
+// Bit copies (CUDA __ushort_as_half / half_as_ushort)
+inline sycl::half ushort_as_half(uint16_t u) { return sycl::bit_cast<sycl::half>(u); }
+inline uint16_t half_as_ushort(sycl::half h) { return sycl::bit_cast<uint16_t>(h); }
+
+inline sycl::half hadd(sycl::half a, sycl::half b) { return sycl::half(float(a) + float(b)); }
+inline sycl::half hsub(sycl::half a, sycl::half b) { return sycl::half(float(a) - float(b)); }
+inline sycl::half hmul(sycl::half a, sycl::half b) { return sycl::half(float(a) * float(b)); }
+inline sycl::half hfma(sycl::half a, sycl::half b, sycl::half c)
+{
+    return sycl::half(float(a) * float(b) + float(c));
+}
+
+// bf16 (CUDA __nv_bfloat16): same argument as above, bit copies via uint16
+inline sycl::ext::oneapi::bfloat16 ushort_as_bf16(uint16_t u)
+{ return sycl::ext::oneapi::bfloat16(sycl::bit_cast<float, uint32_t>(uint32_t(u) << 16)); }
+inline uint16_t bf16_as_ushort(sycl::ext::oneapi::bfloat16 b)
+{ return uint16_t(sycl::bit_cast<uint32_t, float>(float(b)) >> 16); }
+
+inline float bf2f(sycl::ext::oneapi::bfloat16 b) { return float(b); }
+inline sycl::ext::oneapi::bfloat16 f2bf(float f) { return sycl::ext::oneapi::bfloat16(f); }
+
+// -------------------------------------------------------------------------------------------------
+// Bitstream extraction. fshift replicates __funnelshift_r / exl3_dq.cuh's fshift: the 64-bit
+// value (a:b) shifted right by `shift` (shift <= 63). Note the tile bitstream is read MSB-first
+// within each uint32 word (stream bit s is bit 31 - (s % 32) of word s / 32); the decode formulas
+// in exl3_decode.h are lifted verbatim from exl3_dq.cuh and account for this.
+// -------------------------------------------------------------------------------------------------
+
+inline uint32_t fshift(uint32_t b, uint32_t a, int shift)
+{
+    uint64_t merged = ((uint64_t) a << 32) | (uint64_t) b;
+    return (uint32_t) (merged >> shift);
+}
+
+// dp4a(x, 0x01010101, acc): sum of the four bytes of x plus acc, all uint32. The mul1 codebook's
+// byte-sum must stay integer; this is the portable form of __dp4a.
+inline uint32_t dp4a_ones(uint32_t x, uint32_t acc)
+{
+    return (x & 0xffu) + ((x >> 8) & 0xffu) + ((x >> 16) & 0xffu) + ((x >> 24) & 0xffu) + acc;
+}
+
+// EXL3_CB_LOP3(x) = (x & 0x8fff8fff) ^ 0x3b603b60, the portable form of the lop3.b32
+inline uint32_t exl3_cb_lop3(uint32_t x) { return (x & 0x8fff8fffu) ^ 0x3b603b60u; }
+
+// -------------------------------------------------------------------------------------------------
+// Queue / error handling
+// -------------------------------------------------------------------------------------------------
+
+#define SYCL_CHECK(expr) \
+    do { \
+        try { (expr); } \
+        catch (const sycl::exception& e) { \
+            throw std::runtime_error(std::string("SYCL error: ") + e.what() + " at " + __FILE__ + ":" + std::to_string(__LINE__)); \
+        } \
+    } while (0)
+
+// The extension is built against torch XPU: kernels run on the current torch XPU stream so they
+// stay ordered with torch ops. Falls back to a module-owned default queue when torch is absent
+// (standalone test builds).
+sycl::queue& exl3_sycl_queue();
diff --git a/exllamav3/exllamav3_ext/sycl/exl3_decode.h b/exllamav3/exllamav3_ext/sycl/exl3_decode.h
new file mode 100644
index 0000000..2db3f50
--- /dev/null
+++ b/exllamav3/exllamav3_ext/sycl/exl3_decode.h
@@ -0,0 +1,271 @@
+#pragma once
+
+// EXL3 decode chain, ported from quant/exl3_dq.cuh + quant/codebook.cuh + quant/bits_k.cuh into
+// portable SYCL. The decode formulas are lifted verbatim from the CUDA sources; the only structural
+// differences are that these read one 16-bit window per call instead of fragment batches, and the
+// tile words are addressed through a small loader (see PackedPtr below).
+
+#include "exl3_compat.h"
+
+// -------------------------------------------------------------------------------------------------
+// bits_from_K (quant/bits_k.cuh). K arrives as a float from the checkpoint (trellis.shape[-1]/16):
+// integer 1..8, or half-integer 1.5 / 2.5 / 3.5 (mul1 codebook only)
+// -------------------------------------------------------------------------------------------------
+
+struct BitsK
+{
+    int bits;
+    bool half;
+};
+
+inline BitsK bits_from_K(float K)
+{
+    const int bits = (int) K;
+    const float f = K - (float) bits;
+    if (!(bits >= 1 && bits <= 8 && (f == 0.0f || (f == 0.5f && bits <= 3))))
+        throw std::runtime_error("Unsupported EXL3 bitrate (integer 1..8, or 1.5 / 2.5 / 3.5)");
+    return { bits, f == 0.5f };
+}
+
+inline int k2_from_K(float K)
+{
+    const BitsK b = bits_from_K(K);
+    return 2 * b.bits + (b.half ? 1 : 0);
+}
+
+// -------------------------------------------------------------------------------------------------
+// Tile word loaders. The CUDA kernels stage the uint16 tile into shared memory as uint32 words
+// (a verbatim byte copy), so word i = tile16[2i] | tile16[2i+1] << 16 and the bitstream is read
+// MSB-first within each word (stream bit s is bit 31 - (s % 32) of word s / 32). Both loaders
+// below reproduce that bit order; word indices wrap modulo the tile size (the virtual wrap the
+// decoders rely on).
+// -------------------------------------------------------------------------------------------------
+
+// Tile staged in local memory as uint32 words (reconstruct / had kernels)
+struct PackedPtrU32
+{
+    const uint32_t* p;
+    int words;
+    inline uint32_t operator[](int i) const
+    {
+        i = ((i % words) + words) % words;
+        return p[i];
+    }
+};
+
+// Tile read directly from global uint16 memory (GEMV): word i = tile16[2i] | tile16[2i+1] << 16
+struct PackedPtrU16
+{
+    const uint16_t* p;
+    int words;
+    inline uint32_t operator[](int i) const
+    {
+        i = ((i % words) + words) % words;
+        return (uint32_t) p[2 * i] | ((uint32_t) p[2 * i + 1] << 16);
+    }
+};
+
+// Power-of-two-tile variant: the wrap becomes a single AND instead of two runtime integer
+// divisions (a GPU division is a ~20-50 instruction software sequence; the GEMV inner loops
+// issue 8 of them per k-tile per lane, which dominated the whole kernel). words must be a power
+// of two — words = 8*K for integer K in {1,2,4,8} and 4*(2*K+1) = 16 for K = 1.5
+template <bool POW2>
+struct PackedPtrU16Pow2
+{
+    const uint16_t* p;
+    int words;
+    inline uint32_t operator[](int i) const
+    {
+        i &= words - 1;
+        return (uint32_t) p[2 * i] | ((uint32_t) p[2 * i + 1] << 16);
+    }
+};
+
+// Tile staged in local memory through a local_accessor (fused reconstruct_had), captured by
+// value in the kernel; `base` is this subtile's word offset into the accessor
+template <typename ACC>
+struct PackedPtrLocal
+{
+    ACC acc;
+    int base;
+    int words;
+    inline uint32_t operator[](int i) const
+    {
+        i = ((i % words) + words) % words;
+        return acc[base + i];
+    }
+};
+
+// uint32 words per tile: integer K -> K * 8; half-integer K = KA + 0.5 -> 4 * (2*KA + 1)
+inline constexpr int tile_words(int K, bool half) { return half ? (4 * (2 * K + 1)) : (K * 8); }
+
+// Stage a uint16 tile (packed_size uint16s) into a uint32 local buffer
+inline void stage_tile(uint32_t* dst, const uint16_t* src, int packed_size)
+{
+    const int words = packed_size / 2;
+    for (int i = 0; i < words; ++i)
+        dst[i] = (uint32_t) src[2 * i] | ((uint32_t) src[2 * i + 1] << 16);
+}
+
+// -------------------------------------------------------------------------------------------------
+// Codebooks (quant/codebook.cuh decode_3inst<cb>, constants verbatim). Input is the 16-bit window;
+// the result is an fp16 weight.
+// -------------------------------------------------------------------------------------------------
+
+template <int cb>
+inline sycl::half decode_3inst(uint32_t x)
+{
+    if constexpr (cb == 0)
+    {
+        x *= 89226354u;
+        x += 64248484u;
+        x = exl3_cb_lop3(x);
+        sycl::half lo = ushort_as_half((uint16_t) (x & 0xffffu));
+        sycl::half hi = ushort_as_half((uint16_t) (x >> 16));
+        return hadd(lo, hi);
+    }
+    if constexpr (cb == 1)
+    {
+        x *= 0xCBAC1FEDu;
+        x = exl3_cb_lop3(x);
+        sycl::half lo = ushort_as_half((uint16_t) (x & 0xffffu));
+        sycl::half hi = ushort_as_half((uint16_t) (x >> 16));
+        return hadd(lo, hi);
+    }
+    if constexpr (cb == 2)
+    {
+        x *= 0x83DCD12Du;
+        const uint32_t acc = 0x6400u;  // 0x6400 -> 1024.0 ..  0x67FF -> 2047.0
+        uint32_t sum = dp4a_ones(x, acc);   // byte-sum of x + 1024, integer
+        sycl::half h = ushort_as_half((uint16_t) sum);   // bit copy, NOT a numeric conversion
+        const sycl::half k_inv_h = ushort_as_half(0x1eee);  //  0.00677 = 1/147.7
+        const sycl::half k_bias_h = ushort_as_half(0xc931); // -10.39 = (-1024.0 - 510.0) * k_inv_h
+        return hfma(h, k_inv_h, k_bias_h);
+    }
+}
+
+// -------------------------------------------------------------------------------------------------
+// Generic integer-K decode (exl3_dq.cuh dq<bits, cb>). For weight t in a tile whose bitstream
+// starts at ptr: the 16-bit window of weight t ends at (t+1)*bits (+ 256*bits virtual wrap) and
+// its value is a funnel shift of the two words containing it. Generic for every integer K 1..8
+// (the CUDA kernel has aligned fast paths for K in {1,2,4}; not needed here).
+// -------------------------------------------------------------------------------------------------
+
+template <int bits, int cb, typename PTR>
+inline sycl::half dq(PTR ptr, int t_offset)
+{
+    int b0 = t_offset * bits + bits - 16 + 256 * bits;  // start of the 16-bit window
+    int b1 = b0 + 16;                                   // end (exclusive)
+    int i0 = b0 / 32;
+    int i1 = (b1 - 1) / 32;
+    int s0 = (i1 + 1) * 32 - b1;
+    uint32_t a = ptr[i0];
+    uint32_t b = ptr[i1];
+    uint32_t w0 = fshift(b, a, s0) & 0xffffu;
+    return decode_3inst<cb>(w0);
+}
+
+// Four consecutive weights (exl3_dq.cuh dq4): the group spans 3*bits + 16 <= 40 bits
+template <int bits, int cb, typename PTR>
+inline void dq4(PTR ptr, int t_offset, sycl::half* out /* [4] */)
+{
+    int b0 = (t_offset + 257) * bits - 16;   // start of first window of the 4
+    int b1 = b0 + 3 * bits;                  // start of last window
+    int b2 = b1 + 16;                        // end of last window
+    int i0 = b0 / 32;
+    int i2 = (b2 - 1) / 32;
+    int s2 = (i2 + 1) * 32 - b2;
+    uint32_t a = ptr[i0];
+    uint32_t b = ptr[i2];
+    uint32_t w3 = fshift(b, a, s2)             & 0xffffu;
+    uint32_t w2 = fshift(b, a, s2 + bits)      & 0xffffu;
+    uint32_t w1 = fshift(b, a, s2 + bits * 2)  & 0xffffu;
+    uint32_t w0 = fshift(b, a, s2 + bits * 3)  & 0xffffu;
+    out[0] = decode_3inst<cb>(w0);
+    out[1] = decode_3inst<cb>(w1);
+    out[2] = decode_3inst<cb>(w2);
+    out[3] = decode_3inst<cb>(w3);
+}
+
+// Eight consecutive weights: the windows are contiguous, so a per-weight loop of the generic form
+// is correct for every integer bits (the 16-bit window of each weight spans at most two words)
+template <int bits, int cb, typename PTR>
+inline void dq8(PTR ptr, int t_offset, sycl::half* out /* [8] */)
+{
+    for (int j = 0; j < 8; ++j)
+        out[j] = dq<bits, cb>(ptr, t_offset + j);
+}
+
+// -------------------------------------------------------------------------------------------------
+// Half-integer bitrate decode (exl3_dq.cuh dq8_half): K = KA + 0.5, mul1 codebook only. Positions
+// alternate KA (even t) / KA+1 (odd t) bits; bits2 = 2*KA + 1 bits per two positions; the tile is
+// 128*bits2 bits = 4*bits2 uint32 words. The 16-bit window of weight t ends at
+// ((t>>1)+1)*bits2 - (t odd ? 0 : KA+1) + 128*bits2.
+// -------------------------------------------------------------------------------------------------
+
+template <int KA, int cb, typename PTR>
+inline sycl::half dq_half(PTR ptr, int t_offset)
+{
+    constexpr int bits2 = 2 * KA + 1;
+    int end = ((t_offset >> 1) + 1) * bits2 - ((t_offset & 1) ? 0 : KA + 1) + 128 * bits2;
+    int start = end - 16;
+    int i0 = start / 32;
+    int i1 = (end - 1) / 32;
+    int s = (i1 + 1) * 32 - end;
+    uint32_t a = ptr[i0];
+    uint32_t b = ptr[i1];
+    uint32_t w0 = fshift(b, a, s) & 0xffffu;
+    return decode_3inst<cb>(w0);
+}
+
+// Eight consecutive weights starting at an even index (port of dq8_half: two groups of four, one
+// funnel shift per group, the other three windows derived by shifting)
+template <int KA, int cb, typename PTR>
+inline void dq8_half(PTR ptr, int t_offset, sycl::half* out /* [8] */)
+{
+    constexpr int bits2 = 2 * KA + 1;
+    constexpr int gspan = 18 + 3 * KA;                     // bits spanned by four windows
+    const int e7 = ((t_offset >> 1) + 4) * bits2 + 128 * bits2;  // end bit of window 7 (+ one tile for the wrap)
+    const int e3 = e7 - 2 * bits2;                               // end bit of window 3
+    uint32_t w0, w1, w2, w3, w4, w5, w6, w7;
+    {
+        int hi = (e7 - 1) / 32, lo = (e7 - gspan) / 32, s = (hi + 1) * 32 - e7;
+        uint32_t a = ptr[lo], b = ptr[hi];
+        w7 = fshift(b, a, s); w6 = w7 >> (KA + 1); w5 = w6 >> KA; w4 = w5 >> (KA + 1);
+    }
+    {
+        int hi = (e3 - 1) / 32, lo = (e3 - gspan) / 32, s = (hi + 1) * 32 - e3;
+        uint32_t a = ptr[lo], b = ptr[hi];
+        w3 = fshift(b, a, s); w2 = w3 >> (KA + 1); w1 = w2 >> KA; w0 = w1 >> (KA + 1);
+    }
+    out[0] = decode_3inst<cb>(w0 & 0xffffu);
+    out[1] = decode_3inst<cb>(w1 & 0xffffu);
+    out[2] = decode_3inst<cb>(w2 & 0xffffu);
+    out[3] = decode_3inst<cb>(w3 & 0xffffu);
+    out[4] = decode_3inst<cb>(w4 & 0xffffu);
+    out[5] = decode_3inst<cb>(w5 & 0xffffu);
+    out[6] = decode_3inst<cb>(w6 & 0xffffu);
+    out[7] = decode_3inst<cb>(w7 & 0xffffu);
+}
+
+// -------------------------------------------------------------------------------------------------
+// Weight position mapping of the 16x16 subtile (verified against the CUDA reconstruct shuffle
+// network): t = l*8 + j with lane l in 0..31, j in 0..7 maps to subtile position (R, C), and the
+// inverse finds t for a given (R, C) (the GEMV uses this)
+// -------------------------------------------------------------------------------------------------
+
+inline void weight_t_to_rc(int t, int* R, int* C)
+{
+    int l = t >> 3;
+    int j = t & 7;
+    *R = 2 * (l & 3) + (j & 1) + 8 * ((j >> 1) & 1);
+    *C = 2 * (l >> 3) + 8 * (j >> 2) + ((l >> 2) & 1);
+}
+
+inline int weight_rc_to_t(int R, int C)
+{
+    int c = R >> 3, d = R & 1, p = (R & 6) >> 1;
+    int l = ((C & 7) >> 1) * 8 + ((C & 7) & 1) * 4 + p;
+    int j = (C >> 3) * 4 + c * 2 + d;
+    return l * 8 + j;
+}
diff --git a/exllamav3/exllamav3_ext/sycl/flash_attn.cpp b/exllamav3/exllamav3_ext/sycl/flash_attn.cpp
new file mode 100644
index 0000000..bf1ad51
--- /dev/null
+++ b/exllamav3/exllamav3_ext/sycl/flash_attn.cpp
@@ -0,0 +1,154 @@
+// Fused decode attention (flash-decode) for the SYCL backend: one kernel per layer call replacing
+// the eager GQA decode path's ~8 torch kernel launches per layer per token (batched matmul -> fp32
+// cast -> scale -> softmax -> cast -> matmul, all on tiny tensors whose cost is launch overhead).
+//
+// Online softmax over kv chunks; scores and accumulators stay in fp32 (the eager path rounds the
+// score matmul to fp16 first — a precision-only difference, verified against it).
+//
+// Layout: q (1, Hq, hd) fp16, k/v (kv, Hkv, hd) fp16 contiguous window (the caller guarantees the
+// rows are the sequence's dense window with the new tokens already appended), out (1, Hq, hd) fp16.
+// GQA: q-head h reads kv head h / (Hq / Hkv). One work-group of Lanes lanes per q-head; each lane
+// scores one kv position per chunk (hd-dot serially) and owns hd/Lanes output dims (hd == 256).
+
+#include <sycl/sycl.hpp>
+#include <ATen/Tensor.h>
+#include <cmath>
+
+#include "exl3_compat.h"
+#include "sycl_kernels.h"
+
+namespace {
+
+template <int Lanes>
+class FlashDecodeKernelName;
+
+template <int Lanes>
+void flash_decode_impl(sycl::queue& q, const sycl::half* qp, const sycl::half* kp,
+                       const sycl::half* vp, sycl::half* op,
+                       int Hq, int Hkv, int hd, int kv_len, float scale)
+{
+    const int grp = Hq / Hkv;
+    const int stride_kv = Hkv * hd;   // elements per kv position
+    constexpr int DPL = 256 / Lanes;  // output dims per lane (hd is guarded to 256 by the caller)
+
+    q.submit([&](sycl::handler& h)
+    {
+        sycl::local_accessor<float, 1> lsc(sycl::range<1>(Lanes), h);   // chunk scores
+        sycl::local_accessor<float, 1> les(sycl::range<1>(Lanes), h);   // chunk exp(score - m)
+        sycl::local_accessor<float, 1> lred(sycl::range<1>(Lanes), h);  // reduction scratch
+        h.parallel_for<FlashDecodeKernelName<Lanes>>(
+            sycl::nd_range<1>(sycl::range<1>((size_t) Hq * Lanes), sycl::range<1>(Lanes)),
+            [=](sycl::nd_item<1> it)
+        {
+            const int head = (int) it.get_group_linear_id();
+            const int lane = (int) it.get_local_id(0);
+            const int hk = head / grp;
+            const sycl::half* qh = qp + (size_t) head * hd;
+            const sycl::half* kbase = kp + (size_t) hk * hd;
+            const sycl::half* vbase = vp + (size_t) hk * hd;
+
+            float acc[DPL];
+            #pragma unroll
+            for (int j = 0; j < DPL; ++j) acc[j] = 0.0f;
+            float m = -INFINITY;
+            float l = 0.0f;
+
+            for (int c0 = 0; c0 < kv_len; c0 += Lanes)
+            {
+                // this lane's position score (full-headdim dot, serial over d)
+                float score = -INFINITY;
+                const int p = c0 + lane;
+                if (p < kv_len)
+                {
+                    const sycl::half* krow = kbase + (size_t) p * stride_kv;
+                    float dot = 0.0f;
+                    for (int d = 0; d < hd; ++d)
+                        dot = fmaf((float) qh[d], (float) krow[d], dot);
+                    score = dot * scale;
+                }
+                lsc[lane] = score;
+                // the tree's init write must be fenced by the SAME barrier that precedes the
+                // first cross-lane read (a race here intermittently corrupts the chunk max)
+                lred[lane] = score;
+                it.barrier(sycl::access::fence_space::local_space);
+
+                // chunk max (tree over lred)
+                #pragma unroll
+                for (int off = Lanes / 2; off > 0; off >>= 1)
+                {
+                    if (lane < off) lred[lane] = sycl::fmax(lred[lane], lred[lane + off]);
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+                const float mc = lred[0];
+                const float mn = sycl::fmax(m, mc);
+                // first chunk: m = -inf, correction is exactly 0 (and -inf - -inf would be NaN)
+                const float corr = (m == -INFINITY) ? 0.0f : sycl::exp(m - mn);
+
+                // es per lane: kept in les for the accumulation pass, copied into lred for the sum
+                const float es = (p < kv_len) ? sycl::exp(lsc[lane] - mn) : 0.0f;
+                les[lane] = es;
+                lred[lane] = es;
+                it.barrier(sycl::access::fence_space::local_space);
+
+                // chunk sum (tree over lred)
+                #pragma unroll
+                for (int off = Lanes / 2; off > 0; off >>= 1)
+                {
+                    if (lane < off) lred[lane] += lred[lane + off];
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+                const float se = lred[0];
+
+                l = l * corr + se;
+                #pragma unroll
+                for (int j = 0; j < DPL; ++j) acc[j] *= corr;
+
+                // accumulate this chunk's contribution to this lane's output dims
+                const int npos = sycl::min((int) Lanes, kv_len - c0);
+                for (int j = 0; j < npos; ++j)
+                {
+                    const float pj = les[j];
+                    const sycl::half* vrow = vbase + (size_t) (c0 + j) * stride_kv;
+                    #pragma unroll
+                    for (int d = 0; d < DPL; ++d)
+                        acc[d] = fmaf(pj, (float) vrow[lane * DPL + d], acc[d]);
+                }
+                it.barrier(sycl::access::fence_space::local_space);
+                m = mn;
+            }
+
+            const float inv_l = 1.0f / l;  // l >= 1 for kv_len >= 1 (the max lane contributes exp(0))
+            sycl::half* orow = op + (size_t) head * hd;
+            #pragma unroll
+            for (int d = 0; d < DPL; ++d)
+                orow[lane * DPL + d] = sycl::half(acc[d] * inv_l);
+        });
+    });
+}
+
+} // namespace
+
+void sycl_flash_decode(const at::Tensor& q_, const at::Tensor& k_buf,
+                       const at::Tensor& v_buf, int64_t kv_len, double scale, at::Tensor& out)
+{
+    TORCH_CHECK(q_.dim() == 3 && q_.size(0) == 1, "flash_decode: q must be (1, Hq, hd)");
+    TORCH_CHECK(k_buf.dim() == 3 && v_buf.dim() == 3, "flash_decode: k/v must be (kv, Hkv, hd)");
+    TORCH_CHECK(k_buf.size(-1) == q_.size(-1) && v_buf.size(-1) == q_.size(-1),
+                "flash_decode: headdim mismatch");
+    TORCH_CHECK(k_buf.size(1) == v_buf.size(1), "flash_decode: k/v head mismatch");
+    TORCH_CHECK(q_.size(-1) == 256, "flash_decode: headdim 256 only");
+    TORCH_CHECK(q_.scalar_type() == at::kHalf && k_buf.scalar_type() == at::kHalf &&
+                v_buf.scalar_type() == at::kHalf && out.scalar_type() == at::kHalf,
+                "flash_decode: fp16 only");
+    TORCH_CHECK(kv_len >= 1 && kv_len <= k_buf.size(0), "flash_decode: bad kv_len");
+
+    const int Hq = (int) q_.size(1);
+    const int Hkv = (int) k_buf.size(1);
+    TORCH_CHECK(Hq % Hkv == 0, "flash_decode: Hq not divisible by Hkv");
+    const int hd = (int) q_.size(-1);
+
+    flash_decode_impl<128>(exl3_sycl_queue(),
+        (const sycl::half*) q_.data_ptr(), (const sycl::half*) k_buf.data_ptr(),
+        (const sycl::half*) v_buf.data_ptr(), (sycl::half*) out.data_ptr(),
+        Hq, Hkv, hd, (int) kv_len, (float) scale);
+}
diff --git a/exllamav3/exllamav3_ext/sycl/gdn.cpp b/exllamav3/exllamav3_ext/sycl/gdn.cpp
new file mode 100644
index 0000000..f837f8d
--- /dev/null
+++ b/exllamav3/exllamav3_ext/sycl/gdn.cpp
@@ -0,0 +1,722 @@
+// Gated Delta Net kernels, ports of gdn.cu into SYCL.
+//
+// gated_delta_net_fused_op / gated_delta_net_fused_op_2: the elementwise split/gate helpers the
+// GDN torch path calls before the conv and the delta-rule scan.
+//
+// recurrent_gated_delta_rule: the short-sequence (seqlen < num_v_heads, i.e. decode and SD
+// verification) gated delta-rule scan, per (batch row, v head, v chunk) work-group, sequential
+// over the sequence. The CUDA kernel's warp-shuffle reductions become local-memory reductions;
+// the 128x128 head dims (Qwen3.5 / KDA class models) are the supported case, per-head and
+// per-k-channel (KDA) decay both. Mamba2 mode and the scan-replay entry are not ported.
+
+#include <sycl/sycl.hpp>
+#include <ATen/Tensor.h>
+#include <cmath>
+#include <algorithm>
+
+#include "exl3_compat.h"
+#include "sycl_kernels.h"
+
+namespace {
+
+using bf16 = sycl::ext::oneapi::bfloat16;
+
+constexpr int GDN_SUBK = 4;
+
+inline float gdn_softplus(float x)
+{
+    if (x > 20.0f) return x;
+    return sycl::log1p(sycl::exp(x));
+}
+
+// -------------------------------------------------------------------------------------------------
+// gated_delta_net_fused_op: split projected qkvz + ba GDN inputs, produce the conv input in the
+// channel-major layout [B, F, S], the z gate, beta = sigmoid(b) * beta_scale and
+// g = -softplus(a + dt_bias) * exp(a_log). One work item per (t, linear), linear = (b*S + s)*Nk + kh.
+// -------------------------------------------------------------------------------------------------
+
+template <int T_MAX>
+class GdnFusedOpKernelName;
+
+template <int T_MAX>
+void launch_gdn_fused_op(sycl::queue& q,
+                         const float* in_qkvz, const float* in_ba,
+                         const bf16* dt_bias, const bf16* a_log,
+                         bf16* out_qkv, bf16* out_z, bf16* out_beta, float* out_g,
+                         size_t B, size_t S, size_t Nk, size_t Ng, size_t Hk, size_t Hv,
+                         float beta_scale)
+{
+    const size_t Nv = Nk * Ng;
+    const size_t Fseg = 2 * Hk + 2 * Ng * Hv;
+    const size_t Fba = 2 * Ng;
+    const size_t Nlin = B * S * Nk;
+    const size_t Fout = 2 * Nk * Hk + Nv * Hv;
+    const size_t T = (size_t) T_MAX;
+
+    q.parallel_for<GdnFusedOpKernelName<T_MAX>>(sycl::range<2>(T, Nlin),
+        [=](sycl::item<2> item)
+    {
+        const int t = (int) item.get_id(0);
+        const size_t linear = item.get_id(1);
+        const size_t kh = linear % Nk;
+        const size_t s = (linear / Nk) % S;
+        const size_t b = (linear / Nk) / S;
+
+        const size_t base_qkvz = (((b * S) + s) * Nk + kh) * Fseg;
+        const size_t base_ba = (((b * S) + s) * Nk + kh) * Fba;
+
+        // q block: out_qkv features [kh*Hk, kh*Hk + Hk)
+        if (t < (int) Hk)
+        {
+            const float vq = in_qkvz[base_qkvz + t];
+            out_qkv[((b * Fout) + kh * Hk + t) * S + s] = bf16(vq);
+        }
+
+        // k block: out_qkv features [Nk*Hk + kh*Hk, + Hk)
+        if (t < (int) Hk)
+        {
+            const float vk = in_qkvz[base_qkvz + Hk + t];
+            out_qkv[((b * Fout) + Nk * Hk + kh * Hk + t) * S + s] = bf16(vk);
+        }
+
+        // v and z blocks: each Ng*Hv long; source offsets [2*Hk .. 2*Hk + Ng*Hv) and
+        // [2*Hk + Ng*Hv .. 2*Hk + 2*Ng*Hv)
+        if (t < (int) Hv)
+        {
+            for (size_t g = 0; g < Ng; ++g)
+            {
+                const size_t vhead = kh * Ng + g;
+                const float vv = in_qkvz[base_qkvz + 2 * Hk + g * Hv + t];
+                out_qkv[((b * Fout) + 2 * Nk * Hk + vhead * Hv + t) * S + s] = bf16(vv);
+
+                const float vz = in_qkvz[base_qkvz + 2 * Hk + Ng * Hv + g * Hv + t];
+                out_z[(((b * S) + s) * Nv + vhead) * Hv + t] = bf16(vz);
+            }
+        }
+
+        // b and a from mixed_ba (each Ng long) -> beta, g
+        if (t < (int) Ng)
+        {
+            const size_t vhead = kh * Ng + t;
+            const size_t out_va_off = ((b * S) + s) * Nv + vhead;
+
+            const float b = in_ba[base_ba + t];
+            out_beta[out_va_off] = bf16(1.0f / (1.0f + sycl::exp(-b)) * beta_scale);
+
+            const float a = in_ba[base_ba + Ng + t];
+            const float bi = (float) dt_bias[vhead];
+            const float al = (float) a_log[vhead];
+            out_g[out_va_off] = -gdn_softplus(a + bi) * sycl::exp(al);
+        }
+    });
+}
+
+// -------------------------------------------------------------------------------------------------
+// gated_delta_net_fused_op_2: b/a projections -> beta, g (per element)
+// -------------------------------------------------------------------------------------------------
+
+template <typename a_log_T>
+class GdnFusedOp2KernelName;
+
+template <typename a_log_T>
+void launch_gdn_fused_op_2(sycl::queue& q, const float* in_b, const float* in_a,
+                           const bf16* in_dt_bias, const a_log_T* in_a_log,
+                           bf16* out_beta, float* out_g, size_t BS, size_t H, float beta_scale)
+{
+    const size_t N = BS * H;
+    q.parallel_for<GdnFusedOp2KernelName<a_log_T>>(sycl::range<1>(N), [=](sycl::item<1> item)
+    {
+        const size_t i = item.get_linear_id();
+        const size_t h = i % H;
+        const float beta = 1.0f / (1.0f + sycl::exp(-in_b[i])) * beta_scale;
+        const float g = -gdn_softplus(in_a[i] + (float) in_dt_bias[h]) * sycl::exp((float) in_a_log[h]);
+        out_beta[i] = bf16(beta);
+        out_g[i] = g;
+    });
+}
+
+// -------------------------------------------------------------------------------------------------
+// recurrent gated delta rule, 128x128 head dims. Work-group = (v_chunk_dim, SUBK) items; one
+// group per (batch row, v head, v chunk), sequential over the sequence with the state in global
+// memory. CHANNELWISE: per-k-channel log-decay (KDA); otherwise per-head decay (GDN).
+// -------------------------------------------------------------------------------------------------
+
+template <int V_SPLIT, bool CHANNELWISE>
+class GdnScanKernelName;
+
+template <int V_SPLIT, bool CHANNELWISE>
+void launch_gdn_scan(sycl::queue& q,
+                     const bf16* mixed_qkv, const float* g, const bf16* beta,
+                     float* recurrent_state, bf16* core_attn_out,
+                     int bsz, int seqlen, int num_k_heads, int num_v_heads,
+                     const int* slots, int history_stride, const int* slots_in,
+                     int tstride = 1,
+                     const float* state_r = nullptr, float* state_w = nullptr)
+{
+    constexpr int HEAD_DIM = 128;
+    constexpr int BTS = HEAD_DIM / GDN_SUBK;             // k channels per k-slice (bt)
+    constexpr size_t HEAD_STATE_SIZE = HEAD_DIM * HEAD_DIM;
+    const int group = num_v_heads / num_k_heads;
+    const int v_chunk_dim = HEAD_DIM / V_SPLIT;
+    const float scale = 1.0f / sycl::sqrt((float) HEAD_DIM);
+    const size_t slot_size = (size_t) history_stride * group * num_k_heads * HEAD_STATE_SIZE;
+    // mixed_qkv token row: [q (k_dim), k (k_dim), v (v_dim)]
+    const size_t qrow = (size_t) 2 * HEAD_DIM * num_k_heads + (size_t) HEAD_DIM * num_v_heads;
+    const size_t grow = (size_t) num_v_heads * (CHANNELWISE ? HEAD_DIM : 1);
+    const size_t beta_row = (size_t) num_v_heads;
+    const size_t out_row = (size_t) num_v_heads * HEAD_DIM;
+
+    // The x dimension must span the full k/q head (128) so the bt == 0 items load and L2-normalize
+    // all 128 q/k channels; the v-chunk work is then guarded by `t < v_chunk_dim` below. (The CUDA
+    // original launches threads.x = MAX(k_head_dim, v_head_dim / v_split); V_SPLIT=4 with 128 heads
+    // makes that 128.) Using v_chunk_dim here left channels 32..127 uninitialized in shared memory.
+    const int local_x = HEAD_DIM > v_chunk_dim ? HEAD_DIM : v_chunk_dim;
+    const sycl::range<3> local((size_t) local_x, GDN_SUBK, 1);
+    const sycl::range<3> global((size_t) local_x * bsz * num_v_heads * V_SPLIT, GDN_SUBK, 1);
+
+    q.submit([&](sycl::handler& cgh)
+    {
+        sycl::local_accessor<float, 1> sh_q(sycl::range<1>(HEAD_DIM), cgh);
+        sycl::local_accessor<float, 1> sh_k(sycl::range<1>(HEAD_DIM), cgh);
+        sycl::local_accessor<float, 1> sh_scale(sycl::range<1>(2), cgh);
+        sycl::local_accessor<float, 2> sh_g(sycl::range<2>(1, HEAD_DIM), cgh);
+        sycl::local_accessor<float, 2> sh_dot1(sycl::range<2>(GDN_SUBK, HEAD_DIM), cgh);
+        sycl::local_accessor<float, 2> sh_dot2(sycl::range<2>(GDN_SUBK, HEAD_DIM), cgh);
+
+        cgh.parallel_for<GdnScanKernelName<V_SPLIT, CHANNELWISE>>(sycl::nd_range<3>(global, local),
+            [=](sycl::nd_item<3> it)
+        {
+            const int t = (int) it.get_local_id(0);       // v channel within the chunk (k channel when bt == 0)
+            const int bt = (int) it.get_local_id(1);      // k slice
+            const size_t gid = it.get_group_linear_id();
+            const int v_chunk = (int) (gid % V_SPLIT);
+            const int head = (int) ((gid / V_SPLIT) % num_v_heads);
+            const int bi = (int) (gid / ((size_t) V_SPLIT * num_v_heads));
+            const int k_head = head / group;
+            const int v_start = v_chunk * v_chunk_dim;
+
+            const int state_slot = slots ? slots[bi] : bi;
+            const int state_slot_in = (slots_in && history_stride) ? slots_in[bi] : state_slot;
+
+        bf16* o_row = core_attn_out ? core_attn_out + (size_t) bi * seqlen * out_row : nullptr;
+
+        // Replay mode: explicit read/write state rows (base/scratch) and staged token rows
+        // tstride apart; a normal pass keeps state_r/state_w null and walks tokens with stride 1
+        float* base_w_fixed = state_w ? state_w : nullptr;
+        const float* base_r0 = state_r ? state_r : nullptr;
+
+        for (int s = 0; s < seqlen; ++s)
+        {
+            const size_t tok = (tstride == 1) ? ((size_t) bi * seqlen + s) : (size_t) s * tstride;
+            const bf16* qkv_tok = mixed_qkv + tok * qrow;
+            const bf16* gl_q = qkv_tok + (size_t) k_head * HEAD_DIM;
+            const bf16* gl_k = qkv_tok + (size_t) (num_k_heads + k_head) * HEAD_DIM;
+            const bf16* gl_v = qkv_tok + (size_t) (2 * num_k_heads * HEAD_DIM) + (size_t) head * HEAD_DIM + v_start;
+
+            // The first token reads its initial state from slots_in[bi] (a speculative pass);
+            // every token reads and writes the scratch row slots[bi]. In replay mode the rows
+            // are the job's absolute base/scratch pointers instead
+            float* base_w = base_w_fixed ? base_w_fixed : recurrent_state + (size_t) state_slot * slot_size;
+            const float* base_r = (s == 0)
+                ? (base_r0 ? base_r0 : recurrent_state + (size_t) state_slot_in * slot_size)
+                : base_w;
+            const float* gl_rs_r = base_r + (size_t) head * HEAD_STATE_SIZE;
+            float* gl_rs_w = base_w + (size_t) head * HEAD_STATE_SIZE;
+
+            const float* g_tok = g + tok * grow;
+            const bf16* beta_tok = beta + tok * beta_row;
+
+            // Load q/k heads and L2-normalize (items with bt == 0 hold the k channels)
+            if (bt == 0)
+            {
+                sh_q[t] = (float) gl_q[t];
+                sh_k[t] = (float) gl_k[t];
+            }
+            if (t == 0 && bt == 0)
+            {
+                float sumq = 0.0f, sumk = 0.0f;
+                for (int i = 0; i < HEAD_DIM; ++i)
+                {
+                    sumq += sh_q[i] * sh_q[i];
+                    sumk += sh_k[i] * sh_k[i];
+                }
+                sh_scale[0] = sycl::rsqrt(sumq + 1e-6f);
+                sh_scale[1] = sycl::rsqrt(sumk + 1e-6f);
+                if constexpr (CHANNELWISE)
+                {
+                    for (int i = 0; i < HEAD_DIM; ++i)
+                        sh_g[0][i] = sycl::exp(g_tok[(size_t) head * HEAD_DIM + i]);
+                }
+            }
+            sycl::group_barrier(it.get_group());
+
+            if (bt == 0)
+            {
+                sh_q[t] = sh_q[t] * sh_scale[0];
+                sh_k[t] = sh_k[t] * sh_scale[1];
+            }
+            sycl::group_barrier(it.get_group());
+
+            const float beta_h = (float) beta_tok[head];
+            const float g_h = CHANNELWISE ? 1.0f : sycl::exp(g_tok[head]);
+
+            float sreg[BTS];   // the item's state slice, read once (see the dot1 loop below)
+            if (t < v_chunk_dim)
+            {
+                // Dot products with the last state, one partial per k-slice. CHANNELWISE decays
+                // per k-channel, so the kv_mem readback reads the decayed state. The slice's
+                // state values are kept in registers: the update loop below re-reads exactly
+                // these elements (each (bt, t) item's range is disjoint across items and nothing
+                // writes the state row between the two loops), so the re-read is redundant
+                float sum = 0.0f;
+                for (int i = 0; i < BTS; ++i)
+                {
+                    const int kk = bt * BTS + i;
+                    const float gk = CHANNELWISE ? sh_g[0][kk] : 1.0f;
+                    const float sv = gl_rs_r[(size_t) kk * HEAD_DIM + v_start + t];
+                    sreg[i] = sv;
+                    sum += sh_k[kk] * gk * sv;
+                }
+                sh_dot1[bt][t] = sum;
+            }
+            sycl::group_barrier(it.get_group());
+
+            if (t < v_chunk_dim)
+            {
+                float dot1 = 0.0f;
+                for (int sl = 0; sl < GDN_SUBK; ++sl) dot1 += sh_dot1[sl][t];
+                const float v = (float) gl_v[t] - dot1 * g_h;
+
+                float v_out = 0.0f;
+                for (int i = 0; i < BTS; ++i)
+                {
+                    const int kk = bt * BTS + i;
+                    const float gk = CHANNELWISE ? sh_g[0][kk] : g_h;
+                    float state = sreg[i];
+                    state = state * gk + sh_k[kk] * v * beta_h;
+                    gl_rs_w[(size_t) kk * HEAD_DIM + v_start + t] = state;
+                    v_out += sh_q[kk] * state;
+                }
+                sh_dot2[bt][t] = v_out;
+            }
+            sycl::group_barrier(it.get_group());
+
+            if (t < v_chunk_dim && bt == 0 && o_row)
+            {
+                float v_out = 0.0f;
+                for (int sl = 0; sl < GDN_SUBK; ++sl) v_out += sh_dot2[sl][t];
+                o_row[(size_t) s * out_row + (size_t) head * HEAD_DIM + v_start + t] = bf16(v_out * scale);
+            }
+        }
+        });
+    });
+}
